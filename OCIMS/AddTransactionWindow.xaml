<Window x:Class="OCIMS.AddTransactionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Transaction" Height="540" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F0F4F8">

    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A3A5C"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2E86DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE5EF"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#4A5F74"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1A3A5C" Padding="20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#2E86DE" CornerRadius="8"
                        Width="34" Height="34" Margin="0,0,12,0">
                    <TextBlock Text="🔄" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="New Transaction" Foreground="White"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Fill in the transaction details"
                               Foreground="#7AAFD4" FontSize="11"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- FORM -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,20">

                <!-- TX No + Type -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Transaction No." Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TxtTxNo" Style="{StaticResource InputStyle}"
                                 IsReadOnly="True" Background="#F8FAFC"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Type *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbType" Style="{StaticResource ComboStyle}">
                            <ComboBoxItem Content="Incoming"/>
                            <ComboBoxItem Content="Outgoing"/>
                            <ComboBoxItem Content="Internal Transfer"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Subject -->
                <TextBlock Text="Subject *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtSubject" Style="{StaticResource InputStyle}" Margin="0,0,0,14"/>

                <!-- Sender + Receiver -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sender *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbSender" Style="{StaticResource ComboStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Receiver *" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbReceiver" Style="{StaticResource ComboStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Priority + Due Date -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Priority" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbPriority" Style="{StaticResource ComboStyle}">
                            <ComboBoxItem Content="Low"/>
                            <ComboBoxItem Content="Normal" IsSelected="True"/>
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Urgent"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Due Date" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="DpDueDate" Height="40" FontSize="12" BorderBrush="#DDE5EF"/>
                    </StackPanel>
                </Grid>

                <!-- Description -->
                <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtDescription"
                         Height="60" FontSize="13" Foreground="#1A3A5C"
                         Background="White" BorderBrush="#DDE5EF" BorderThickness="1"
                         Padding="10,8" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" Margin="0,0,0,10">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#2E86DE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <!-- Remarks -->
                <TextBlock Text="Remarks" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="TxtRemarks" Style="{StaticResource InputStyle}" Margin="0,0,0,10"/>

                <TextBlock x:Name="ErrorMsg" Foreground="#C0392B" FontSize="11"
                           TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#DDE5EF"
                BorderThickness="0,1,0,0" Padding="20,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" Width="90" Height="36"
                        Background="White" Foreground="#4A5F74"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        FontSize="12" Cursor="Hand" Margin="0,0,10,0"
                        Click="CancelBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F4F8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Save Transaction" Width="140" Height="36"
                        Background="#2E86DE" Foreground="White"
                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        Cursor="Hand" Click="SaveBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A6FBE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
