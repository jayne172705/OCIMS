<Application x:Class="eSureHi.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:eSureHi.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design Theme - required for LoginWindow and other views -->
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Blue" SecondaryColor="LightBlue"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
                
                <!-- Custom Converters -->
                <ResourceDictionary>
                    <helpers:ComparisonConverter x:Key="ComparisonConverter"/>
                    <helpers:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
                    <helpers:NullToBoolConverter x:Key="NullToBoolConverter"/>
                    <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>
                    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
                    <helpers:HexToBrushConverter x:Key="HexToBrushConverter"/>
                    <helpers:PathToImageConverter x:Key="PathToImageConverter"/>
                    <helpers:AdaptiveForegroundConverter x:Key="AdaptiveForegroundConverter"/>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand Colors -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#1565C0"/>
            <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#0D47A1"/>
            <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#1565C0" Offset="0"/>
                <GradientStop Color="#03A9F4" Offset="1"/>
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SuccessBrush" Color="#2E7D32"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#F57F17"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="#C62828"/>
            <SolidColorBrush x:Key="InfoBrush" Color="#1565C0"/>
            <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F5F7"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="BorderBrushSoft" Color="#DDE4EF"/>
            <SolidColorBrush x:Key="TextBrush" Color="#1E293B"/>
            <SolidColorBrush x:Key="MutedTextBrush" Color="#64748B"/>
            <SolidColorBrush x:Key="SidebarBrush" Color="#0D2137"/>
            <SolidColorBrush x:Key="SidebarTextBrush" Color="#FFFFFF"/>

            <Style TargetType="{x:Type Window}">
                <Setter Property="Icon" Value="pack://application:,,,/Assets/eSureHi.ico"/>
            </Style>

            <!-- Global Style Overrides for Visibility -->
            <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="ReadableDataGrid" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="RowBackground" Value="White"/>
                <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#DDE4EF"/>
                <Setter Property="HorizontalGridLinesBrush" Value="#E5EAF2"/>
                <Setter Property="VerticalGridLinesBrush" Value="#E5EAF2"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="CellStyle">
                    <Setter.Value>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
                <Setter Property="RowStyle">
                    <Setter.Value>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#DBEAFE"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="materialDesign:HintAssist.Foreground" Value="#64748B"/>
            </Style>

            <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="materialDesign:HintAssist.Foreground" Value="#64748B"/>
            </Style>

            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="materialDesign:HintAssist.Foreground" Value="#64748B"/>
            </Style>

            <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}">
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                <Setter Property="materialDesign:HintAssist.Foreground" Value="#64748B"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
