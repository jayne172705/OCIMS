<Window x:Class="OCIMS.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCIMS — Login"
        Height="620" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White">

    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A3A5C"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2E86DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A3A5C"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#2E86DE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="#2E86DE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A6FBE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabBtn" TargetType="RadioButton">
            <Setter Property="GroupName" Value="AuthTab"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#7A8FA6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="4,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2E86DE"/>
                                <Setter Property="Foreground" Value="#2E86DE"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Background="White">

            <!-- LOGO HEADER -->
            <Border Background="#1A3A5C" Padding="0,30,0,26">
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="#2E86DE" CornerRadius="16"
                            Width="64" Height="64"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,12">
                        <TextBlock Text="🛡" FontSize="32"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="OCIMS"
                               Foreground="White" FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Office Constituent Insurance Management"
                               Foreground="#7AAFD4" FontSize="11"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- TAB BUTTONS -->
            <Border BorderBrush="#DDE5EF" BorderThickness="0,0,0,1"
                    Padding="40,0" Background="White">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="LoginTab"
                                 Style="{StaticResource TabBtn}"
                                 Content="Sign In"
                                 IsChecked="True"
                                 Margin="0,0,28,0"
                                 Checked="LoginTab_Checked"/>
                    <RadioButton x:Name="SignupTab"
                                 Style="{StaticResource TabBtn}"
                                 Content="Sign Up"
                                 Checked="SignupTab_Checked"/>
                </StackPanel>
            </Border>

            <!-- ========================
                 LOGIN FORM
            ======================== -->
            <StackPanel x:Name="LoginForm"
                        Margin="40,24,40,30"
                        Visibility="Visible">

                <TextBlock Text="Welcome back!"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#1A3A5C" Margin="0,0,0,4"/>
                <TextBlock Text="Sign in to your account to continue."
                           FontSize="12" Foreground="#7A8FA6"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Username"
                           FontSize="12" FontWeight="Medium"
                           Foreground="#4A5F74" Margin="0,0,0,6"/>
                <TextBox x:Name="LoginUsername"
                         Style="{StaticResource InputStyle}"
                         Margin="0,0,0,16"/>

                <TextBlock Text="Password"
                           FontSize="12" FontWeight="Medium"
                           Foreground="#4A5F74" Margin="0,0,0,6"/>
                <PasswordBox x:Name="LoginPassword"
                             Style="{StaticResource PasswordStyle}"
                             Margin="0,0,0,6"/>

                <!-- Error -->
                <TextBlock x:Name="LoginError"
                           Foreground="#C0392B" FontSize="11"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <!-- Sign In Button -->
                <Button Content="Sign In"
                        Style="{StaticResource PrimaryBtn}"
                        Margin="0,20,0,0"
                        Click="LoginBtn_Click"/>

                <!-- Hint -->
                <Border Background="#E8F2FD" CornerRadius="8"
                        Padding="12,8" Margin="0,14,0,0">
                    <TextBlock FontSize="11" Foreground="#1A6FBE"
                               TextWrapping="Wrap">
                        <Run FontWeight="SemiBold">Default Admin Login:</Run>
                        <Run>  Username: </Run>
                        <Run FontWeight="Bold">admin</Run>
                        <Run>   Password: </Run>
                        <Run FontWeight="Bold">admin123</Run>
                    </TextBlock>
                </Border>
            </StackPanel>

            <!-- ========================
                 SIGN UP FORM
            ======================== -->
            <StackPanel x:Name="SignupForm"
                        Margin="40,24,40,30"
                        Visibility="Collapsed">

                <TextBlock Text="Create an account"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#1A3A5C" Margin="0,0,0,4"/>
                <TextBlock Text="Fill in the details below to register."
                           FontSize="12" Foreground="#7A8FA6"
                           Margin="0,0,0,16"/>

                <!-- Full Name -->
                <TextBlock Text="Full Name"
                           FontSize="12" FontWeight="Medium"
                           Foreground="#4A5F74" Margin="0,0,0,6"/>
                <TextBox x:Name="SignupFullName"
                         Style="{StaticResource InputStyle}"
                         Margin="0,0,0,12"/>

                <!-- Username -->
                <TextBlock Text="Username"
                           FontSize="12" FontWeight="Medium"
                           Foreground="#4A5F74" Margin="0,0,0,6"/>
                <TextBox x:Name="SignupUsername"
                         Style="{StaticResource InputStyle}"
                         Margin="0,0,0,12"/>

                <!-- Password -->
                <TextBlock Text="Password"
                           FontSize="12" FontWeight="Medium"
                           Foreground="#4A5F74" Margin="0,0,0,6"/>
                <PasswordBox x:Name="SignupPassword"
                             Style="{StaticResource PasswordStyle}"
                             Margin="0,0,0,12"/>

                <!-- Confirm Password -->
                <TextBlock Text="Confirm Password"
                           FontSize="12" FontWeight="Medium"
                           Foreground="#4A5F74" Margin="0,0,0,6"/>
                <PasswordBox x:Name="SignupConfirmPassword"
                             Style="{StaticResource PasswordStyle}"
                             Margin="0,0,0,6"/>

                <!-- Error -->
                <TextBlock x:Name="SignupError"
                           Foreground="#C0392B" FontSize="11"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <!-- Success -->
                <TextBlock x:Name="SignupSuccess"
                           Foreground="#1A8A4A" FontSize="11"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <!-- Sign Up Button -->
                <Button Content="Create Account"
                        Style="{StaticResource PrimaryBtn}"
                        Margin="0,16,0,0"
                        Click="SignupBtn_Click"/>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>