<Window x:Class="OCIMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCIMS" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen" Background="#F0F4F8">

    <Window.Resources>
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A8C0D6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent"
                                BorderThickness="3,0,0,0" BorderBrush="Transparent">
                            <ContentPresenter Margin="16,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#12FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E86DE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#7EC8F5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Grid Grid.Column="0" Background="#1A3A5C">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Border Grid.Row="0" Padding="16,18,16,14"
                    BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#2E86DE" CornerRadius="10" Width="36" Height="36">
                        <TextBlock Text="🛡" FontSize="18"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="OCIMS" Foreground="White" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Insurance Mgmt" Foreground="#5A8AAA" FontSize="9"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Nav Items -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <StackPanel Margin="0,10,0,0">

                    <RadioButton Style="{StaticResource NavItemStyle}"
                                 IsChecked="True" Click="NavDashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Dashboard" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItemStyle}" Click="NavClients_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👥" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Clients" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItemStyle}" Click="NavPolicies_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Policies" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItemStyle}" Click="NavClaims_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Claims" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItemStyle}" Click="NavPayments_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Payments" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItemStyle}" Click="NavDocuments_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗂" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Documents" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItemStyle}" Click="NavTransactions_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Transactions" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItemStyle}" Click="NavResources_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Resources" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource NavItemStyle}" Click="NavReports_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Reports" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                </StackPanel>
            </ScrollViewer>

            <!-- User Footer -->
            <Border Grid.Row="2" Padding="14,12"
                    BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="16" Background="#2E86DE">
                        <TextBlock x:Name="TxtUserInitials" Text="AD"
                                   Foreground="White" FontSize="11" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtUserName" Text="Admin"
                                   Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUserRole" Text="Administrator"
                                   Foreground="#5A8AAA" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Topbar -->
            <Border Grid.Row="0" Background="White"
                    BorderBrush="#DDE5EF" BorderThickness="0,0,0,1">
                <DockPanel Margin="20,0">
                    <TextBlock x:Name="PageTitle" Text="Dashboard"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="#1A3A5C" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8"
                                Background="#F0F4F8" BorderBrush="#DDE5EF"
                                BorderThickness="1" Cursor="Hand" Margin="0,0,8,0">
                            <Grid>
                                <TextBlock Text="🔔" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="8" Height="8" Fill="#E74C3C"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,4,4,0"/>
                            </Grid>
                        </Border>
                        <Button x:Name="ActionButton" Content="+ New Client"
                                Background="#2E86DE" Foreground="White"
                                BorderThickness="0" Padding="14,7"
                                FontSize="12" FontWeight="SemiBold"
                                Cursor="Hand" Click="ActionButton_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1A6FBE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Frame x:Name="ContentFrame" Grid.Row="1"
                   NavigationUIVisibility="Hidden" Background="#F0F4F8"/>
        </Grid>
    </Grid>
</Window>
