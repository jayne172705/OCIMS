<Page x:Class="OCIMS.Pages.ClaimsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Claims" Background="#F0F4F8">

    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary Strip -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="14,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#7A8FA6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="All Claims" FontSize="10" Foreground="#7A8FA6"/>
                        <TextBlock x:Name="TxtAll" Text="0" FontSize="18" FontWeight="Bold" Foreground="#1A3A5C"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="14,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#D68910" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Pending" FontSize="10" Foreground="#7A8FA6"/>
                        <TextBlock x:Name="TxtPending" Text="0" FontSize="18" FontWeight="Bold" Foreground="#1A3A5C"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="14,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#1A8A4A" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Approved" FontSize="10" Foreground="#7A8FA6"/>
                        <TextBlock x:Name="TxtApproved" Text="0" FontSize="18" FontWeight="Bold" Foreground="#1A3A5C"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#C0392B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Rejected" FontSize="10" Foreground="#7A8FA6"/>
                        <TextBlock x:Name="TxtRejected" Text="0" FontSize="18" FontWeight="Bold" Foreground="#1A3A5C"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Status Filter Chips -->
        <Border Grid.Row="2" Background="White" CornerRadius="10"
                BorderBrush="#DDE5EF" BorderThickness="1" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter by Status:" FontSize="12" Foreground="#7A8FA6"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <RadioButton x:Name="FilterAll" Content="All" GroupName="StatusFilter"
                             IsChecked="True" Margin="0,0,8,0"
                             Checked="StatusFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="12,5"
                                    Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1A3A5C"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#1A3A5C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F0F4F8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="FilterPending" Content="🕐 Pending" GroupName="StatusFilter"
                             Margin="0,0,8,0" Checked="StatusFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="12,5" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FEF5E7"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#D68910"/>
                                    <Setter Property="Foreground" Value="#D68910"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="FilterApproved" Content="✔ Approved" GroupName="StatusFilter"
                             Margin="0,0,8,0" Checked="StatusFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="12,5" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E6F9F0"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#1A8A4A"/>
                                    <Setter Property="Foreground" Value="#1A8A4A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="FilterRejected" Content="✖ Rejected" GroupName="StatusFilter"
                             Margin="0,0,8,0" Checked="StatusFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="12,5" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FDEAEA"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#C0392B"/>
                                    <Setter Property="Foreground" Value="#C0392B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="FilterReleased" Content="💸 Released" GroupName="StatusFilter"
                             Checked="StatusFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="12,5" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E8F2FD"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#2E86DE"/>
                                    <Setter Property="Foreground" Value="#2E86DE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#DDE5EF"
                    BorderThickness="1" CornerRadius="8" Height="38"
                    Width="300" HorizontalAlignment="Left">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                               VerticalAlignment="Center" Foreground="#7A8FA6" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0"
                             Background="Transparent" FontSize="12" Foreground="#1A3A5C"
                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🖨 Print" Height="38" Padding="14,0"
                        Background="White" Foreground="#4A5F74"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                        Click="PrintBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F4F8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="📥  Export" Height="38" Padding="14,0"
                        Background="White" Foreground="#4A5F74"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                        Click="ExportBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F4F8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="＋  File Claim" Height="38" Padding="16,0"
                        Background="#2E86DE" Foreground="White"
                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        Cursor="Hand" Click="FileClaim_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A6FBE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Claims Grid -->
        <Border Grid.Row="6" Background="White" CornerRadius="10"
                BorderBrush="#DDE5EF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="ClaimsGrid" Grid.Row="0"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserResizeColumns="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F4F8"
                          HeadersVisibility="Column" Background="White" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#FAFCFF"
                          FontSize="12" Foreground="#1A3A5C" SelectionMode="Single"
                          ColumnHeaderHeight="42" RowHeight="54"
                          HorizontalScrollBarVisibility="Disabled">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#7A8FA6"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderBrush" Value="#DDE5EF"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CLAIM NO" Binding="{Binding ClaimNo}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CLIENT NAME" Binding="{Binding ClientName}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding ClaimType}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4A5F74"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DATE FILED" Binding="{Binding ClaimDate}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4A5F74"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountDisplay}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="STATUS" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBg}" CornerRadius="6"
                                            Padding="8,3" HorizontalAlignment="Left"
                                            Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ClaimStatus}"
                                                   Foreground="{Binding StatusFg}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                        <Button Content="✔ Approve" Background="#E6F9F0" BorderThickness="0"
                                                Padding="8,4" FontSize="11" Foreground="#1A8A4A"
                                                Cursor="Hand" Margin="0,0,4,0" Click="ApproveClaim_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#C8F0D8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="✖ Reject" Background="#FDEAEA" BorderThickness="0"
                                                Padding="8,4" FontSize="11" Foreground="#C0392B"
                                                Cursor="Hand" Margin="0,0,4,0" Click="RejectClaim_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8C8C8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="🗑" Background="#F0F4F8" BorderThickness="0"
                                                Padding="8,4" FontSize="11" Foreground="#7A8FA6"
                                                Cursor="Hand" Click="DeleteClaim_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DDE5EF"
                        BorderThickness="0,1,0,0" Padding="16,8">
                    <TextBlock x:Name="TotalCount" Text="Total: 0 claims"
                               FontSize="11" Foreground="#7A8FA6"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
