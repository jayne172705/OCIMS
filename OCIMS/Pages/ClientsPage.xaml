<Page x:Class="OCIMS.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Clients"
      Background="#F0F4F8">

    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDE5EF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Height="38"
                    Width="300"
                    HorizontalAlignment="Left">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="🔍"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="#7A8FA6"
                               Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             x:Name="SearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="12"
                             Foreground="#1A3A5C"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ExportBtn"
                        Content="📥  Export"
                        Height="38" Padding="14,0"
                        Background="White"
                        Foreground="#4A5F74"
                        BorderBrush="#DDE5EF"
                        BorderThickness="1"
                        FontSize="12"
                        Cursor="Hand"
                        Margin="0,0,8,0"
                        Click="ExportBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F4F8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="＋  Add Client"
                        Height="38" Padding="16,0"
                        Background="#2E86DE"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="AddClient_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A6FBE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- TABLE -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                BorderBrush="#DDE5EF"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="ClientsGrid"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F0F4F8"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFCFF"
                          FontSize="12"
                          Foreground="#1A3A5C"
                          SelectionMode="Single"
                          ColumnHeaderHeight="42"
                          RowHeight="54"
                          HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="ClientsGrid_SelectionChanged">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"      Value="#F8FAFC"/>
                            <Setter Property="Foreground"      Value="#7A8FA6"/>
                            <Setter Property="FontSize"        Value="11"/>
                            <Setter Property="FontWeight"      Value="SemiBold"/>
                            <Setter Property="Padding"         Value="12,0"/>
                            <Setter Property="BorderBrush"     Value="#DDE5EF"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>

                        <!-- CLIENT ID -->
                        <DataGridTextColumn Header="CLIENT ID"
                                            Binding="{Binding EmployeeNo}"
                                            Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#1A3A5C"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- NAME with Avatar -->
                        <DataGridTemplateColumn Header="NAME" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="12,0"
                                                VerticalAlignment="Center">
                                        <Border Width="32" Height="32"
                                                CornerRadius="16"
                                                Background="#E8F2FD"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="#2E86DE"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="#1A3A5C"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- EMAIL -->
                        <DataGridTextColumn Header="EMAIL"
                                            Binding="{Binding Email}"
                                            Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4A5F74"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- PHONE -->
                        <DataGridTextColumn Header="PHONE"
                                            Binding="{Binding PhoneMobile}"
                                            Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- ADDRESS -->
                        <DataGridTextColumn Header="ADDRESS"
                                            Binding="{Binding Address}"
                                            Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4A5F74"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- STATUS -->
                        <DataGridTemplateColumn Header="STATUS" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBg}"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            HorizontalAlignment="Left"
                                            Margin="12,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EmploymentStatus}"
                                                   Foreground="{Binding StatusFg}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ACTIONS -->
                        <DataGridTemplateColumn Header="ACTIONS" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="8,0"
                                                VerticalAlignment="Center">
                                        <Button Content="👁 View"
                                                Background="#E8F2FD"
                                                BorderThickness="0"
                                                Padding="8,4"
                                                FontSize="11"
                                                Foreground="#2E86DE"
                                                Cursor="Hand"
                                                Margin="0,0,4,0"
                                                Click="ViewClient_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#D0E8F8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="✏ Edit"
                                                Background="#E6F9F0"
                                                BorderThickness="0"
                                                Padding="8,4"
                                                FontSize="11"
                                                Foreground="#1A8A4A"
                                                Cursor="Hand"
                                                Margin="0,0,4,0"
                                                Click="EditClient_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#C8F0D8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="🗑"
                                                Background="#FDEAEA"
                                                BorderThickness="0"
                                                Padding="8,4"
                                                FontSize="11"
                                                Foreground="#C0392B"
                                                Cursor="Hand"
                                                Click="DeleteClient_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8C8C8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Footer -->
                <Border Grid.Row="1"
                        Background="#F8FAFC"
                        BorderBrush="#DDE5EF"
                        BorderThickness="0,1,0,0"
                        Padding="16,8">
                    <DockPanel>
                        <TextBlock x:Name="TotalCount"
                                   Text="Total: 0 clients"
                                   FontSize="11"
                                   Foreground="#7A8FA6"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="SelectedInfo"
                                   Text=""
                                   FontSize="11"
                                   Foreground="#2E86DE"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
