<Page x:Class="OCIMS.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Dashboard"
      Background="#F0F4F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20,18,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE -->
            <StackPanel Grid.Column="0">

                <!-- Stat Cards -->
                <UniformGrid Columns="4" Margin="0,0,0,14">

                    <Border Background="White" CornerRadius="10"
                            BorderBrush="#DDE5EF" BorderThickness="1"
                            Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Total Clients" FontSize="11" Foreground="#7A8FA6"/>
                            <TextBlock x:Name="TxtTotalClients" Text="0"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="#1A3A5C" Margin="0,4,0,2"/>
                            <TextBlock Text="Registered" FontSize="10" Foreground="#2E86DE"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10"
                            BorderBrush="#DDE5EF" BorderThickness="1"
                            Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Active Policies" FontSize="11" Foreground="#7A8FA6"/>
                            <TextBlock Text="312" FontSize="24" FontWeight="Bold"
                                       Foreground="#1A3A5C" Margin="0,4,0,2"/>
                            <TextBlock Text="↑ 12 renewed" FontSize="10" Foreground="#1A8A4A"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10"
                            BorderBrush="#DDE5EF" BorderThickness="1"
                            Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Pending Claims" FontSize="11" Foreground="#7A8FA6"/>
                            <TextBlock Text="37" FontSize="24" FontWeight="Bold"
                                       Foreground="#1A3A5C" Margin="0,4,0,2"/>
                            <TextBlock Text="7 need review" FontSize="10" Foreground="#D68910"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="10"
                            BorderBrush="#DDE5EF" BorderThickness="1"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="Payments Due" FontSize="11" Foreground="#7A8FA6"/>
                            <TextBlock Text="₱84K" FontSize="24" FontWeight="Bold"
                                       Foreground="#1A3A5C" Margin="0,4,0,2"/>
                            <TextBlock Text="This month" FontSize="10" Foreground="#C0392B"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- Analytics Bar Chart -->
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Analytics Overview"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1A3A5C" Margin="0,0,0,14"/>
                        <Grid Height="130">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Border Background="#2E86DE" CornerRadius="4,4,0,0" Width="28" Height="60"/>
                                <TextBlock Text="Jan" FontSize="10" Foreground="#7A8FA6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Border Background="#2E86DE" CornerRadius="4,4,0,0" Width="28" Height="90"/>
                                <TextBlock Text="Feb" FontSize="10" Foreground="#7A8FA6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Border Background="#2E86DE" CornerRadius="4,4,0,0" Width="28" Height="50"/>
                                <TextBlock Text="Mar" FontSize="10" Foreground="#7A8FA6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Border Background="#2E86DE" CornerRadius="4,4,0,0" Width="28" Height="110"/>
                                <TextBlock Text="Apr" FontSize="10" Foreground="#7A8FA6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Border Background="#7EC8F5" CornerRadius="4,4,0,0" Width="28" Height="75"/>
                                <TextBlock Text="May" FontSize="10" Foreground="#7A8FA6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                <Border Background="#7EC8F5" CornerRadius="4,4,0,0" Width="28" Height="45"/>
                                <TextBlock Text="Jun" FontSize="10" Foreground="#7A8FA6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Background="#2E86DE" Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0"/>
                            <TextBlock Text="Claims Filed" FontSize="11" Foreground="#7A8FA6" Margin="0,0,14,0"/>
                            <Border Background="#7EC8F5" Width="10" Height="10" CornerRadius="2" Margin="0,0,5,0"/>
                            <TextBlock Text="Payments Received" FontSize="11" Foreground="#7A8FA6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recent Clients -->
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        Padding="16">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="Recent Clients"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#1A3A5C"/>
                            <TextBlock Text="View all →"
                                       Foreground="#2E86DE" FontSize="11"
                                       HorizontalAlignment="Right" Cursor="Hand"/>
                        </DockPanel>
                        <ItemsControl x:Name="RecentClientsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F0F4F8"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="30" Height="30"
                                                    CornerRadius="15" Background="#E8F2FD">
                                                <TextBlock Text="{Binding Initials}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="#2E86DE"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}"
                                                           FontSize="12" FontWeight="Medium"
                                                           Foreground="#1A3A5C"/>
                                                <TextBlock Text="{Binding Email}"
                                                           FontSize="10" Foreground="#7A8FA6"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#E6F9F0"
                                                    CornerRadius="6" Padding="8,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="Active" FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1A8A4A"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- RIGHT SIDE -->
            <StackPanel Grid.Column="2">

                <!-- Mini Calendar -->
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock x:Name="CalendarTitle"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#1A3A5C"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"/>
                        <UniformGrid Columns="7" Margin="0,0,0,4">
                            <TextBlock Text="Su" FontSize="10" FontWeight="SemiBold" Foreground="#7A8FA6" HorizontalAlignment="Center"/>
                            <TextBlock Text="Mo" FontSize="10" FontWeight="SemiBold" Foreground="#7A8FA6" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tu" FontSize="10" FontWeight="SemiBold" Foreground="#7A8FA6" HorizontalAlignment="Center"/>
                            <TextBlock Text="We" FontSize="10" FontWeight="SemiBold" Foreground="#7A8FA6" HorizontalAlignment="Center"/>
                            <TextBlock Text="Th" FontSize="10" FontWeight="SemiBold" Foreground="#7A8FA6" HorizontalAlignment="Center"/>
                            <TextBlock Text="Fr" FontSize="10" FontWeight="SemiBold" Foreground="#7A8FA6" HorizontalAlignment="Center"/>
                            <TextBlock Text="Sa" FontSize="10" FontWeight="SemiBold" Foreground="#7A8FA6" HorizontalAlignment="Center"/>
                        </UniformGrid>
                        <UniformGrid x:Name="CalendarGrid" Columns="7"/>
                    </StackPanel>
                </Border>

                <!-- Recent Activity -->
                <Border Background="White" CornerRadius="10"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        Padding="14">
                    <StackPanel>
                        <TextBlock Text="Recent Activity"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1A3A5C" Margin="0,0,0,12"/>
                        <DockPanel Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="#2E86DE"
                                     VerticalAlignment="Top" Margin="0,3,8,0"/>
                            <StackPanel>
                                <TextBlock Text="New client registered"
                                           FontSize="11" Foreground="#4A5F74" TextWrapping="Wrap"/>
                                <TextBlock Text="2 min ago" FontSize="10" Foreground="#9AACBD"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="#1A8A4A"
                                     VerticalAlignment="Top" Margin="0,3,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Claim #2034 approved"
                                           FontSize="11" Foreground="#4A5F74" TextWrapping="Wrap"/>
                                <TextBlock Text="1 hour ago" FontSize="10" Foreground="#9AACBD"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Ellipse Width="8" Height="8" Fill="#D68910"
                                     VerticalAlignment="Top" Margin="0,3,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Payment reminder sent"
                                           FontSize="11" Foreground="#4A5F74" TextWrapping="Wrap"/>
                                <TextBlock Text="3 hours ago" FontSize="10" Foreground="#9AACBD"/>
                            </StackPanel>
                        </DockPanel>
                        <DockPanel>
                            <Ellipse Width="8" Height="8" Fill="#C0392B"
                                     VerticalAlignment="Top" Margin="0,3,8,0"/>
                            <StackPanel>
                                <TextBlock Text="Policy #104 expired"
                                           FontSize="11" Foreground="#4A5F74" TextWrapping="Wrap"/>
                                <TextBlock Text="Yesterday" FontSize="10" Foreground="#9AACBD"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
