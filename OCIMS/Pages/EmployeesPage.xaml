<!-- ============================================================
     OCIMS — EmployeesPage.xaml
     Place this in a /Pages/ folder in your WPF project
     ============================================================ -->
<Page x:Class="OCIMS.Pages.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Employees"
      Background="#F0F4F8">

    <Page.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#DDE5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="10"/>
        </Style>
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="GroupName"       Value="EmpFilter"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Foreground"      Value="#7A8FA6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#DDE5EF"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background"   Value="#2E86DE"/>
                                <Setter Property="BorderBrush"  Value="#2E86DE"/>
                                <Setter Property="Foreground"   Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="#DDE5EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Foreground"      Value="#4A5F74"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F4F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="*"/>
            <!-- Table -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <!-- Filter chips -->
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <RadioButton Style="{StaticResource FilterChip}" Content="All"
                             IsChecked="True" Margin="0,0,6,0"/>
                <RadioButton Style="{StaticResource FilterChip}" Content="Active"
                             Margin="0,0,6,0"/>
                <RadioButton Style="{StaticResource FilterChip}" Content="Inactive"
                             Margin="0,0,6,0"/>
                <RadioButton Style="{StaticResource FilterChip}" Content="Retired"/>
            </StackPanel>

            <!-- Right actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBox Width="180" Margin="0,0,8,0"
                         Background="#F0F4F8"
                         BorderBrush="#DDE5EF" BorderThickness="1"
                         Padding="8,6" FontSize="12">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <Button Style="{StaticResource ActionBtn}"
                        Content="📥 Export" Margin="0,0,6,0"/>
                <Button Content="+ Add Employee"
                        Background="#2E86DE" Foreground="White"
                        BorderThickness="0" Padding="12,6" FontSize="12"
                        FontWeight="SemiBold" Cursor="Hand"
                        Click="AddEmployee_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- Employee DataGrid -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <DataGrid x:Name="EmployeeGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F4F8"
                      HeadersVisibility="Column"
                      Background="White" BorderThickness="0"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFCFF"
                      FontSize="12"
                      Foreground="#1A3A5C"
                      SelectionMode="Single"
                      ColumnHeaderHeight="40"
                      RowHeight="48">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"     Value="#F8FAFC"/>
                        <Setter Property="Foreground"     Value="#7A8FA6"/>
                        <Setter Property="FontSize"       Value="11"/>
                        <Setter Property="FontWeight"     Value="SemiBold"/>
                        <Setter Property="Padding"        Value="14,0"/>
                        <Setter Property="BorderBrush"    Value="#DDE5EF"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <!-- Emp No -->
                    <DataGridTextColumn Header="EMP NO."
                                        Binding="{Binding EmployeeNo}"
                                        Width="90"
                                        FontWeight="Medium"/>

                    <!-- Full Name with avatar -->
                    <DataGridTemplateColumn Header="EMPLOYEE NAME" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="14,0">
                                    <Border Width="30" Height="30" CornerRadius="15"
                                            Background="#E8F2FD" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Initials}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="#2E86DE"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="12" FontWeight="Medium"
                                                   Foreground="#1A3A5C"/>
                                        <TextBlock Text="{Binding Email}"
                                                   FontSize="10" Foreground="#7A8FA6"
                                                   Margin="0,1,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Department -->
                    <DataGridTextColumn Header="DEPARTMENT"
                                        Binding="{Binding Department}"
                                        Width="130"/>

                    <!-- Position -->
                    <DataGridTextColumn Header="POSITION"
                                        Binding="{Binding Position}"
                                        Width="140"/>

                    <!-- Coverage -->
                    <DataGridTemplateColumn Header="INSURANCE" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E8F2FD" CornerRadius="6"
                                        Padding="8,3" HorizontalAlignment="Left"
                                        Margin="14,0">
                                    <TextBlock Text="{Binding PolicyCount}"
                                               Foreground="#1A6FBE"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status Badge -->
                    <DataGridTemplateColumn Header="STATUS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding StatusBg}" CornerRadius="6"
                                        Padding="8,3" HorizontalAlignment="Left"
                                        Margin="14,0">
                                    <TextBlock Text="{Binding EmploymentStatus}"
                                               Foreground="{Binding StatusFg}"
                                               FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Date Hired -->
                    <DataGridTextColumn Header="DATE HIRED"
                                        Binding="{Binding DateHired, StringFormat='MMM dd, yyyy'}"
                                        Width="110"
                                        Foreground="#7A8FA6"/>

                    <!-- Action buttons -->
                    <DataGridTemplateColumn Header="" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0">
                                    <Button Content="View"
                                            Style="{StaticResource ActionBtn}"
                                            Margin="0,0,4,0"
                                            Click="ViewEmployee_Click"/>
                                    <Button Content="Edit"
                                            Style="{StaticResource ActionBtn}"
                                            Click="EditEmployee_Click"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
