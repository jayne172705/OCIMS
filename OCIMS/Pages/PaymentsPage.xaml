<Page x:Class="OCIMS.Pages.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Payments" Background="#F0F4F8">

    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="0" Columns="3">
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Payments" FontSize="11" Foreground="#7A8FA6"/>
                    <TextBlock x:Name="TxtTotalCount" Text="0" FontSize="22"
                               FontWeight="Bold" Foreground="#1A3A5C" Margin="0,4,0,2"/>
                    <TextBlock Text="All transactions" FontSize="10" Foreground="#2E86DE"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="16" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Amount" FontSize="11" Foreground="#7A8FA6"/>
                    <TextBlock x:Name="TxtTotalAmt" Text="₱0.00" FontSize="22"
                               FontWeight="Bold" Foreground="#1A3A5C" Margin="0,4,0,2"/>
                    <TextBlock Text="Collected" FontSize="10" Foreground="#1A8A4A"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="16">
                <StackPanel>
                    <TextBlock Text="Unpaid" FontSize="11" Foreground="#7A8FA6"/>
                    <TextBlock x:Name="TxtUnpaid" Text="0" FontSize="22"
                               FontWeight="Bold" Foreground="#1A3A5C" Margin="0,4,0,2"/>
                    <TextBlock Text="Pending collection" FontSize="10" Foreground="#C0392B"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Date Range Filter -->
        <Border Grid.Row="2" Background="White" CornerRadius="10"
                BorderBrush="#DDE5EF" BorderThickness="1" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter by Date:" FontSize="12" Foreground="#7A8FA6"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="From" FontSize="12" Foreground="#4A5F74"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="DpFrom" Width="130" Height="34" FontSize="12"
                            BorderBrush="#DDE5EF"
                            SelectedDateChanged="DateFilter_Changed"/>
                <TextBlock Text="To" FontSize="12" Foreground="#4A5F74"
                           VerticalAlignment="Center" Margin="10,0,6,0"/>
                <DatePicker x:Name="DpTo" Width="130" Height="34" FontSize="12"
                            BorderBrush="#DDE5EF"
                            SelectedDateChanged="DateFilter_Changed"/>
                <Button Content="Clear" Height="34" Padding="12,0"
                        Background="White" Foreground="#7A8FA6"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        FontSize="11" Cursor="Hand" Margin="10,0,0,0"
                        Click="ClearDateFilter_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F4F8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Status filter chips -->
                <TextBlock Text="|" FontSize="14" Foreground="#DDE5EF"
                           VerticalAlignment="Center" Margin="14,0"/>
                <TextBlock Text="Status:" FontSize="12" Foreground="#7A8FA6"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="PayFilterAll" Content="All" GroupName="PayFilter"
                             IsChecked="True" Margin="0,0,6,0"
                             Checked="PayFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="10,4" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1A3A5C"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#1A3A5C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="PayFilterPaid" Content="✔ Paid" GroupName="PayFilter"
                             Margin="0,0,6,0" Checked="PayFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="10,4" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E6F9F0"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#1A8A4A"/>
                                    <Setter Property="Foreground" Value="#1A8A4A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="PayFilterUnpaid" Content="✖ Unpaid" GroupName="PayFilter"
                             Checked="PayFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="10,4" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FDEAEA"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#C0392B"/>
                                    <Setter Property="Foreground" Value="#C0392B"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#DDE5EF"
                    BorderThickness="1" CornerRadius="8" Height="38"
                    Width="300" HorizontalAlignment="Left">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                               VerticalAlignment="Center" Foreground="#7A8FA6" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0"
                             Background="Transparent" FontSize="12" Foreground="#1A3A5C"
                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🖨 Print" Height="38" Padding="14,0"
                        Background="White" Foreground="#4A5F74"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                        Click="PrintBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F4F8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="📥  Export" Height="38" Padding="14,0"
                        Background="White" Foreground="#4A5F74"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                        Click="ExportBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F4F8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="＋  Add Payment" Height="38" Padding="16,0"
                        Background="#2E86DE" Foreground="White"
                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        Cursor="Hand" Click="AddPayment_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A6FBE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Payments Grid -->
        <Border Grid.Row="6" Background="White" CornerRadius="10"
                BorderBrush="#DDE5EF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="PaymentsGrid" Grid.Row="0"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserResizeColumns="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F4F8"
                          HeadersVisibility="Column" Background="White" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#FAFCFF"
                          FontSize="12" Foreground="#1A3A5C" SelectionMode="Single"
                          ColumnHeaderHeight="42" RowHeight="54"
                          HorizontalScrollBarVisibility="Disabled">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#7A8FA6"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderBrush" Value="#DDE5EF"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PAYMENT NO" Binding="{Binding PaymentNo}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CLIENT NAME" Binding="{Binding ClientName}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="AMOUNT" Binding="{Binding AmountDisplay}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DATE" Binding="{Binding PaymentDate}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4A5F74"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="METHOD" Binding="{Binding PaymentMode}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4A5F74"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="STATUS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBg}" CornerRadius="6"
                                            Padding="8,3" HorizontalAlignment="Left"
                                            Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PaymentStatus}"
                                                   Foreground="{Binding StatusFg}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                        <Button Content="👁 View" Background="#E8F2FD" BorderThickness="0"
                                                Padding="8,4" FontSize="11" Foreground="#2E86DE"
                                                Cursor="Hand" Margin="0,0,4,0" Click="ViewPayment_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#D0E8F8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="🗑" Background="#FDEAEA" BorderThickness="0"
                                                Padding="8,4" FontSize="11" Foreground="#C0392B"
                                                Cursor="Hand" Click="DeletePayment_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8C8C8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DDE5EF"
                        BorderThickness="0,1,0,0" Padding="16,8">
                    <DockPanel>
                        <TextBlock x:Name="TotalCount" Text="Total: 0 payments"
                                   FontSize="11" Foreground="#7A8FA6"/>
                        <TextBlock x:Name="FilteredTotal" Text=""
                                   FontSize="11" Foreground="#1A8A4A" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
