<Page x:Class="OCIMS.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Reports" Background="#F0F4F8">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18,20,20">

            <!-- Report Cards -->
            <UniformGrid Columns="2" Margin="0,0,0,16">

                <!-- Clients Report -->
                <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                        BorderThickness="1" Padding="20" Margin="0,0,12,12">
                    <StackPanel>
                        <Border Background="#E8F2FD" CornerRadius="10"
                                Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="👥" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Clients Report" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1A3A5C" Margin="0,0,0,4"/>
                        <TextBlock Text="Export full list of all registered clients"
                                   FontSize="11" Foreground="#7A8FA6" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📥 Excel" Height="34" Padding="12,0"
                                    Background="#2E86DE" Foreground="White"
                                    BorderThickness="0" FontSize="11" FontWeight="SemiBold"
                                    Cursor="Hand" Margin="0,0,8,0" Click="ExportClients_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1A6FBE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="🖨 Print" Height="34" Padding="12,0"
                                    Background="White" Foreground="#4A5F74"
                                    BorderBrush="#DDE5EF" BorderThickness="1"
                                    FontSize="11" Cursor="Hand" Click="PrintClients_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F4F8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Policies Report -->
                <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                        BorderThickness="1" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <Border Background="#E6F9F0" CornerRadius="10"
                                Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Policies Report" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1A3A5C" Margin="0,0,0,4"/>
                        <TextBlock Text="Export all active and expired policies"
                                   FontSize="11" Foreground="#7A8FA6" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📥 Excel" Height="34" Padding="12,0"
                                    Background="#1A8A4A" Foreground="White"
                                    BorderThickness="0" FontSize="11" FontWeight="SemiBold"
                                    Cursor="Hand" Margin="0,0,8,0" Click="ExportPolicies_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#126B38"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="🖨 Print" Height="34" Padding="12,0"
                                    Background="White" Foreground="#4A5F74"
                                    BorderBrush="#DDE5EF" BorderThickness="1"
                                    FontSize="11" Cursor="Hand" Click="PrintPolicies_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F4F8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Claims Report -->
                <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                        BorderThickness="1" Padding="20" Margin="0,0,12,12">
                    <StackPanel>
                        <Border Background="#FEF5E7" CornerRadius="10"
                                Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Claims Report" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1A3A5C" Margin="0,0,0,4"/>
                        <TextBlock Text="Export all claims with status breakdown"
                                   FontSize="11" Foreground="#7A8FA6" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📥 Excel" Height="34" Padding="12,0"
                                    Background="#D68910" Foreground="White"
                                    BorderThickness="0" FontSize="11" FontWeight="SemiBold"
                                    Cursor="Hand" Margin="0,0,8,0" Click="ExportClaims_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#B8770E"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="🖨 Print" Height="34" Padding="12,0"
                                    Background="White" Foreground="#4A5F74"
                                    BorderBrush="#DDE5EF" BorderThickness="1"
                                    FontSize="11" Cursor="Hand" Click="PrintClaims_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F4F8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Payments Report — NEW -->
                <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                        BorderThickness="1" Padding="20" Margin="0,0,0,12">
                    <StackPanel>
                        <Border Background="#FDEAEA" CornerRadius="10"
                                Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="💰" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Payments Report" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#1A3A5C" Margin="0,0,0,4"/>
                        <TextBlock Text="Export all payment transactions and totals"
                                   FontSize="11" Foreground="#7A8FA6" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="📥 Excel" Height="34" Padding="12,0"
                                    Background="#C0392B" Foreground="White"
                                    BorderThickness="0" FontSize="11" FontWeight="SemiBold"
                                    Cursor="Hand" Margin="0,0,8,0" Click="ExportPayments_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#9B2D23"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Content="🖨 Print" Height="34" Padding="12,0"
                                    Background="White" Foreground="#4A5F74"
                                    BorderBrush="#DDE5EF" BorderThickness="1"
                                    FontSize="11" Cursor="Hand" Click="PrintPayments_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F4F8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Summary Stats -->
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="20">
                <StackPanel>
                    <TextBlock Text="Summary Statistics" FontSize="13" FontWeight="SemiBold"
                               Foreground="#1A3A5C" Margin="0,0,0,16"/>
                    <UniformGrid Columns="4">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Total Clients" FontSize="11" Foreground="#7A8FA6"/>
                            <TextBlock x:Name="StatClients" Text="0" FontSize="22"
                                       FontWeight="Bold" Foreground="#2E86DE" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Total Policies" FontSize="11" Foreground="#7A8FA6"/>
                            <TextBlock x:Name="StatPolicies" Text="0" FontSize="22"
                                       FontWeight="Bold" Foreground="#1A8A4A" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Total Claims" FontSize="11" Foreground="#7A8FA6"/>
                            <TextBlock x:Name="StatClaims" Text="0" FontSize="22"
                                       FontWeight="Bold" Foreground="#D68910" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Approved Claims" FontSize="11" Foreground="#7A8FA6"/>
                            <TextBlock x:Name="StatApproved" Text="0" FontSize="22"
                                       FontWeight="Bold" Foreground="#C0392B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
