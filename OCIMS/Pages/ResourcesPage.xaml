<Page x:Class="OCIMS.Pages.ResourcesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Resources" Background="#F0F4F8">

    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="0" Columns="3">
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Total Fund Sources" FontSize="11" Foreground="#7A8FA6"/>
                    <TextBlock x:Name="TxtTotalFunds" Text="0" FontSize="24"
                               FontWeight="Bold" Foreground="#1A3A5C" Margin="0,4,0,2"/>
                    <TextBlock Text="Registered sources" FontSize="10" Foreground="#2E86DE"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="16" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Total Amount" FontSize="11" Foreground="#7A8FA6"/>
                    <TextBlock x:Name="TxtTotalAmount" Text="₱0.00" FontSize="24"
                               FontWeight="Bold" Foreground="#1A3A5C" Margin="0,4,0,2"/>
                    <TextBlock Text="All sources combined" FontSize="10" Foreground="#1A8A4A"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="16">
                <StackPanel>
                    <TextBlock Text="Active Sources" FontSize="11" Foreground="#7A8FA6"/>
                    <TextBlock x:Name="TxtActiveFunds" Text="0" FontSize="24"
                               FontWeight="Bold" Foreground="#1A3A5C" Margin="0,4,0,2"/>
                    <TextBlock Text="Currently active" FontSize="10" Foreground="#D68910"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Toolbar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#DDE5EF"
                    BorderThickness="1" CornerRadius="8" Height="38"
                    Width="300" HorizontalAlignment="Left">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                               VerticalAlignment="Center" Foreground="#7A8FA6" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0"
                             Background="Transparent" FontSize="12" Foreground="#1A3A5C"
                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📥  Export" Height="38" Padding="14,0"
                        Background="White" Foreground="#4A5F74"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                        Click="ExportBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F4F8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="＋  Add Fund Source" Height="38" Padding="16,0"
                        Background="#2E86DE" Foreground="White"
                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        Cursor="Hand" Click="AddFund_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A6FBE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="4" Background="White" CornerRadius="10"
                BorderBrush="#DDE5EF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="FundsGrid" Grid.Row="0"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserResizeColumns="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F4F8"
                          HeadersVisibility="Column" Background="White" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#FAFCFF"
                          FontSize="12" Foreground="#1A3A5C" SelectionMode="Single"
                          ColumnHeaderHeight="42" RowHeight="54"
                          HorizontalScrollBarVisibility="Disabled">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"      Value="#F8FAFC"/>
                            <Setter Property="Foreground"      Value="#7A8FA6"/>
                            <Setter Property="FontSize"        Value="11"/>
                            <Setter Property="FontWeight"      Value="SemiBold"/>
                            <Setter Property="Padding"         Value="12,0"/>
                            <Setter Property="BorderBrush"     Value="#DDE5EF"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>

                        <DataGridTemplateColumn Header="FUND SOURCE" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                        <Border Width="34" Height="34" CornerRadius="8"
                                                Background="#E8F2FD" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Icon}" FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FundName}" FontSize="12"
                                                       FontWeight="Medium" Foreground="#1A3A5C"/>
                                            <TextBlock Text="{Binding FundType}" FontSize="10"
                                                       Foreground="#7A8FA6"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="AMOUNT" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AmountDisplay}" Padding="12,0"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="#1A3A5C" FontSize="13"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="SOURCE / DONOR" Binding="{Binding Source}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4A5F74"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="DATE RECEIVED" Binding="{Binding DateReceived}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4A5F74"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="STATUS" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBg}" CornerRadius="6"
                                            Padding="8,3" HorizontalAlignment="Left"
                                            Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FundStatus}"
                                                   Foreground="{Binding StatusFg}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ACTIONS" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                        <Button Content="👁 View" Background="#E8F2FD" BorderThickness="0"
                                                Padding="8,4" FontSize="11" Foreground="#2E86DE"
                                                Cursor="Hand" Margin="0,0,4,0" Click="ViewFund_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#D0E8F8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="✏ Edit" Background="#E6F9F0" BorderThickness="0"
                                                Padding="8,4" FontSize="11" Foreground="#1A8A4A"
                                                Cursor="Hand" Margin="0,0,4,0" Click="EditFund_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#C8F0D8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="🗑" Background="#FDEAEA" BorderThickness="0"
                                                Padding="8,4" FontSize="11" Foreground="#C0392B"
                                                Cursor="Hand" Click="DeleteFund_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8C8C8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DDE5EF"
                        BorderThickness="0,1,0,0" Padding="16,8">
                    <DockPanel>
                        <TextBlock x:Name="TotalCount" Text="Total: 0 fund sources"
                                   FontSize="11" Foreground="#7A8FA6"/>
                        <TextBlock x:Name="TotalAmountFooter" Text=""
                                   FontSize="11" Foreground="#1A8A4A"
                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
