<Page x:Class="OCIMS.Pages.TransactionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Transactions" Background="#F0F4F8">

    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary Cards -->
        <UniformGrid Grid.Row="0" Columns="4">
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="14,10" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="All Transactions" FontSize="11" Foreground="#7A8FA6"/>
                    <TextBlock x:Name="TxtAll" Text="0" FontSize="22"
                               FontWeight="Bold" Foreground="#1A3A5C" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="14,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📥" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Incoming" FontSize="11" Foreground="#7A8FA6"/>
                        <TextBlock x:Name="TxtIncoming" Text="0" FontSize="22"
                                   FontWeight="Bold" Foreground="#1A3A5C" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="14,10" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📤" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Outgoing" FontSize="11" Foreground="#7A8FA6"/>
                        <TextBlock x:Name="TxtOutgoing" Text="0" FontSize="22"
                                   FontWeight="Bold" Foreground="#1A3A5C" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Background="White" CornerRadius="10" BorderBrush="#DDE5EF"
                    BorderThickness="1" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⏳" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Pending" FontSize="11" Foreground="#7A8FA6"/>
                        <TextBlock x:Name="TxtPending" Text="0" FontSize="22"
                                   FontWeight="Bold" Foreground="#1A3A5C" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Type Filter -->
        <Border Grid.Row="2" Background="White" CornerRadius="10"
                BorderBrush="#DDE5EF" BorderThickness="1" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter by Type:" FontSize="12" Foreground="#7A8FA6"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <RadioButton x:Name="FAll" Content="All" GroupName="TxFilter"
                             IsChecked="True" Margin="0,0,8,0"
                             Checked="TypeFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="12,5" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#1A3A5C"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#1A3A5C"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="FIncoming" Content="📥 Incoming" GroupName="TxFilter"
                             Margin="0,0,8,0" Checked="TypeFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="12,5" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E8F2FD"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#2E86DE"/>
                                    <Setter Property="Foreground" Value="#2E86DE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="FOutgoing" Content="📤 Outgoing" GroupName="TxFilter"
                             Margin="0,0,8,0" Checked="TypeFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="12,5" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#E6F9F0"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#1A8A4A"/>
                                    <Setter Property="Foreground" Value="#1A8A4A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
                <RadioButton x:Name="FInternal" Content="🔄 Internal" GroupName="TxFilter"
                             Checked="TypeFilter_Changed">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="White" BorderBrush="#DDE5EF"
                                    BorderThickness="1" CornerRadius="8" Padding="12,5" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FEF5E7"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#D68910"/>
                                    <Setter Property="Foreground" Value="#D68910"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </RadioButton.Template>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="#DDE5EF"
                    BorderThickness="1" CornerRadius="8" Height="38"
                    Width="300" HorizontalAlignment="Left">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" FontSize="13"
                               VerticalAlignment="Center" Foreground="#7A8FA6" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="SearchBox" BorderThickness="0"
                             Background="Transparent" FontSize="12" Foreground="#1A3A5C"
                             VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📥  Export" Height="38" Padding="14,0"
                        Background="White" Foreground="#4A5F74"
                        BorderBrush="#DDE5EF" BorderThickness="1"
                        FontSize="12" Cursor="Hand" Margin="0,0,8,0"
                        Click="ExportBtn_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F0F4F8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="＋  New Transaction" Height="38" Padding="16,0"
                        Background="#2E86DE" Foreground="White"
                        BorderThickness="0" FontSize="12" FontWeight="SemiBold"
                        Cursor="Hand" Click="AddTransaction_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1A6FBE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Transactions Grid -->
        <Border Grid.Row="6" Background="White" CornerRadius="10"
                BorderBrush="#DDE5EF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DataGrid x:Name="TxGrid" Grid.Row="0"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserResizeColumns="False"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F4F8"
                          HeadersVisibility="Column" Background="White" BorderThickness="0"
                          RowBackground="White" AlternatingRowBackground="#FAFCFF"
                          FontSize="12" Foreground="#1A3A5C" SelectionMode="Single"
                          ColumnHeaderHeight="42" RowHeight="54"
                          HorizontalScrollBarVisibility="Disabled">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"      Value="#F8FAFC"/>
                            <Setter Property="Foreground"      Value="#7A8FA6"/>
                            <Setter Property="FontSize"        Value="11"/>
                            <Setter Property="FontWeight"      Value="SemiBold"/>
                            <Setter Property="Padding"         Value="12,0"/>
                            <Setter Property="BorderBrush"     Value="#DDE5EF"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- TX No + Type Icon -->
                        <DataGridTemplateColumn Header="TRANSACTION" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                                        <Border Width="34" Height="34" CornerRadius="8"
                                                Background="#E8F2FD" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding TypeIcon}" FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TransactionNo}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="#1A3A5C"/>
                                            <TextBlock Text="{Binding TransactionType}"
                                                       FontSize="10" Foreground="#7A8FA6"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="SUBJECT" Binding="{Binding Subject}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="SENDER" Binding="{Binding SenderName}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4A5F74"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="RECEIVER" Binding="{Binding ReceiverName}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4A5F74"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="DATE" Binding="{Binding TransactionDate}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Padding" Value="12,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4A5F74"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="PRIORITY" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding PriorityBg}" CornerRadius="6"
                                            Padding="6,3" HorizontalAlignment="Left"
                                            Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Priority}"
                                                   Foreground="{Binding PriorityFg}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="STATUS" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBg}" CornerRadius="6"
                                            Padding="6,3" HorizontalAlignment="Left"
                                            Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusFg}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ACTIONS" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                        <Button Content="👁 View" Background="#E8F2FD" BorderThickness="0"
                                                Padding="7,4" FontSize="11" Foreground="#2E86DE"
                                                Cursor="Hand" Margin="0,0,4,0" Click="ViewTx_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#D0E8F8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="✔ Complete" Background="#E6F9F0" BorderThickness="0"
                                                Padding="7,4" FontSize="11" Foreground="#1A8A4A"
                                                Cursor="Hand" Margin="0,0,4,0" Click="CompleteTx_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#C8F0D8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <Button Content="🗑" Background="#FDEAEA" BorderThickness="0"
                                                Padding="7,4" FontSize="11" Foreground="#C0392B"
                                                Cursor="Hand" Click="DeleteTx_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#F8C8C8"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#DDE5EF"
                        BorderThickness="0,1,0,0" Padding="16,8">
                    <TextBlock x:Name="TotalCount" Text="Total: 0 transactions"
                               FontSize="11" Foreground="#7A8FA6"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
