<Window x:Class="eSureHi.Views.Admin.AdminShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Icon="pack://application:,,,/Assets/eSureHi.ico"
        Title="Municipality of Sulop - eSureHi+"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Loaded="AdminShell_Loaded">

    <Window.Resources>
        <Style x:Key="SidebarNavButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="8,1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarLogoutButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="8,10,8,12"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FEF2F2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarGroupButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="8,5,8,0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarGroupPanel" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Margin" Value="28,0,8,4"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="SidebarGroupItemButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="16,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Command="{Binding ToggleSidebarCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="42" Height="32"
                            Padding="0"
                            ToolTip="Menu">
                        <materialDesign:PackIcon Kind="Menu" Width="18" Height="18"/>
                    </Button>
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Width="18" Height="18"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="eSureHi+"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="System"
                               FontSize="12"
                               Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               Opacity="0.85"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="CalendarClock"
                                             Width="18" Height="18"
                                             Margin="0,0,8,0"
                                             VerticalAlignment="Center"/>
                    <TextBlock x:Name="CurrentDateTime"
                               Text="Loading..."
                               FontSize="12"
                               FontWeight="Medium"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Background="#FFFFFF"
                            CornerRadius="12"
                            Padding="8,2"
                            Margin="0,0,8,0"
                            Height="24"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{Binding SyncStatusColor, Converter={StaticResource HexToBrushConverter}}"
                                     Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SyncStatusText}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CrossSystemStatusText}"
                                       FontSize="10"
                                       Foreground="#92400E"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding CrossSystemStatusText, Converter={StaticResource StringToVisibilityConverter}}"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Command="{Binding SyncNowCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="24"
                                    Height="22"
                                    Padding="0"
                                    Margin="6,0,0,0"
                                    ToolTip="Sync now">
                                <materialDesign:PackIcon Kind="Sync" Width="14" Height="14" Foreground="#0F172A"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Grid VerticalAlignment="Center" Margin="0,0,12,0">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding ToggleNotificationsCommand}"
                                Width="38" Height="32"
                                Padding="0"
                                Foreground="White"
                                ToolTip="Notifications">
                            <materialDesign:PackIcon Kind="Bell" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Border Background="#FF5252"
                                helpers:Adaptive.UseAdaptiveForeground="True"
                                CornerRadius="8"
                                MinWidth="16" Height="16" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,4,4,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UnreadNotifications}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding UnreadNotifications}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        
                        <Popup IsOpen="{Binding IsNotificationsPanelOpen, Mode=TwoWay}"
                               StaysOpen="False"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Slide">
                            <Border Width="380" MaxHeight="500"
                                    Background="White"
                                    helpers:Adaptive.UseAdaptiveForeground="True"
                                    BorderBrush="#DDE4EF"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12"
                                                      ShadowDepth="3"
                                                      Opacity="0.2"
                                                      Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0"
                                            BorderBrush="#DDE4EF"
                                            BorderThickness="0,0,0,1"
                                            Padding="16,12">
                                        <Grid>
                                            <TextBlock Text="Notifications"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1E293B"
                                                       VerticalAlignment="Center"/>
                                            <Button Command="{Binding NotificationsVm.MarkAllReadCommand}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Foreground="{StaticResource PrimaryBrush}"
                                                    HorizontalAlignment="Right"
                                                    Height="28"
                                                    FontSize="11"
                                                    Padding="8,0">
                                                <TextBlock Text="Mark all read"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="380">
                                        <StackPanel>
                                            <StackPanel HorizontalAlignment="Center"
                                                        Margin="0,32,0,32"
                                                        Visibility="{Binding NotificationsVm.HasItems,
                                                            Converter={StaticResource BoolToVisibilityConverter},
                                                            ConverterParameter=Invert}">
                                                <materialDesign:PackIcon Kind="BellOff"
                                                                         Width="40"
                                                                         Height="40"
                                                                         Foreground="#E0E0E0"
                                                                         HorizontalAlignment="Center"/>
                                                <TextBlock Text="No notifications"
                                                           FontSize="13"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding NotificationsVm.Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#DDE4EF"
                                                                BorderThickness="0,0,0,1"
                                                                Cursor="Hand">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="White"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                            <Setter Property="Background" Value="#EFF6FF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.NotificationsVm.MarkReadCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <Grid Margin="16,12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Grid.Column="0"
                                                                         Width="8"
                                                                         Height="8"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,4,10,0"
                                                                         Fill="{Binding DotColor,
                                                                             Converter={StaticResource HexToBrushConverter}}"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="13"
                                                                               Foreground="#1E293B"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Message}"
                                                                               FontSize="11"
                                                                               Foreground="#64748B"
                                                                               TextWrapping="Wrap"
                                                                               MaxHeight="36"
                                                                               Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding TimeAgo}"
                                                                           FontSize="10"
                                                                           Foreground="#94A3B8"
                                                                           VerticalAlignment="Top"
                                                                           Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border Grid.Row="2"
                                            BorderBrush="#DDE4EF"
                                            BorderThickness="0,1,0,0"
                                            Padding="16,8">
                                        <Button Command="{Binding NotificationsVm.RefreshCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                Height="28"
                                                FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Refresh"
                                                                         Width="14"
                                                                         Height="14"
                                                                         Margin="0,0,6,0"
                                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Width="38"
                            Height="32"
                            Padding="0"
                            Command="{Binding NavSettingsCommand}"
                            Foreground="White"
                            ToolTip="Settings">
                        <materialDesign:PackIcon Kind="Cog" Width="18" Height="18" Foreground="White"/>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Width="38"
                            Height="32"
                            Padding="0"
                            Foreground="White"
                            ToolTip="Help">
                        <materialDesign:PackIcon Kind="HelpCircle" Width="18" Height="18" Foreground="White"/>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignFlatButton}"
                            Width="38"
                            Height="32"
                            Padding="0"
                            Command="{Binding LogoutCommand}"
                            Foreground="White"
                            ToolTip="Logout">
                        <materialDesign:PackIcon Kind="Logout" Width="18" Height="18" Foreground="White"/>
                    </Button>

                    <Button Click="BtnMinimize_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="40" Height="32"
                            Padding="0"
                            Foreground="White">
                        <materialDesign:PackIcon Kind="WindowMinimize" Width="16" Height="16" Foreground="White"/>
                    </Button>

                    <Button x:Name="BtnMaximize"
                            Click="BtnMaximize_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="40" Height="32"
                            Padding="0"
                            Foreground="White">
                        <materialDesign:PackIcon x:Name="MaximizeIcon" Kind="WindowRestore" Width="16" Height="16" Foreground="White"/>
                    </Button>

                    <Button Click="BtnClose_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="40" Height="32"
                            Padding="0"
                            Foreground="White">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDE4EF" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,16,0,10">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="38" Height="38"
                               HorizontalAlignment="Center"/>
                        <TextBlock Text="eSureHi+"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,1"/>
                        <TextBlock Text="Municipality of Sulop"
                                   FontSize="9"
                                   Foreground="#475569"
                                   HorizontalAlignment="Center"/>
                        <Border Width="188"
                                Height="1"
                                Background="#E2E8F0"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Bottom"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SidebarLogoutButton}">
                        <StackPanel Orientation="Horizontal" Margin="8,0">
                            <materialDesign:PackIcon Kind="Logout" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Logout" FontSize="13"/>
                        </StackPanel>
                    </Button>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                        <StackPanel Margin="0,4"
                                    Visibility="{Binding IsAdminNavigationFlow, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Command="{Binding NavHomeCommand}" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Home" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Home" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavDashboardCommand}" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Dashboard" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Visibility="{Binding CanAccessManageMembers, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Command="{Binding OpenMemberManagementCommand}"
                                        Style="{StaticResource SidebarGroupButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="AccountCheck" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Member Management" FontSize="13" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="2">
                                            <materialDesign:PackIcon Kind="ChevronDown"
                                                                     Width="18"
                                                                     Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsMemberManagementPopupOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                            <materialDesign:PackIcon Kind="ChevronUp"
                                                                     Width="18"
                                                                     Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsMemberManagementPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Grid>
                                </Button>
                                <Border Style="{StaticResource SidebarGroupPanel}"
                                        Visibility="{Binding IsMemberManagementPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Command="{Binding NavRegisterMemberCommand}"
                                                Style="{StaticResource SidebarGroupItemButton}"
                                                Visibility="{Binding CanAccessRegisterMember, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20" Margin="0,0,12,0"/>
                                                <TextBlock Text="CRS Listview" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding NavManageMembersCommand}"
                                                Style="{StaticResource SidebarGroupItemButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountCheck" Width="20" Height="20" Margin="0,0,12,0"/>
                                                <TextBlock Text="Manage Members" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding CanAccessClaims, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Command="{Binding OpenClaimsMenuCommand}"
                                        Style="{StaticResource SidebarGroupButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="ClipboardList" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Claims" FontSize="13" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="2">
                                            <materialDesign:PackIcon Kind="ChevronDown"
                                                                     Width="18"
                                                                     Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsClaimsMenuPopupOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                            <materialDesign:PackIcon Kind="ChevronUp"
                                                                     Width="18"
                                                                     Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsClaimsMenuPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Grid>
                                </Button>
                                <Border Style="{StaticResource SidebarGroupPanel}"
                                        Visibility="{Binding IsClaimsMenuPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Command="{Binding NavPendingClaimsCommand}"
                                                Style="{StaticResource SidebarGroupItemButton}"
                                                Visibility="{Binding CanAccessPendingClaims, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ClipboardClock" Width="20" Height="20" Margin="0,0,12,0"/>
                                                <TextBlock Text="Pending Claims" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding NavAllClaimsCommand}"
                                                Style="{StaticResource SidebarGroupItemButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ClipboardCheck" Width="20" Height="20" Margin="0,0,12,0"/>
                                                <TextBlock Text="All Claims" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding CanAccessSourceFunds, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Command="{Binding OpenBudgetFundsCommand}"
                                        Style="{StaticResource SidebarGroupButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Wallet" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Budget Funds" FontSize="13" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="2">
                                            <materialDesign:PackIcon Kind="ChevronDown"
                                                                     Width="18"
                                                                     Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsBudgetFundsPopupOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                            <materialDesign:PackIcon Kind="ChevronUp"
                                                                     Width="18"
                                                                     Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsBudgetFundsPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Grid>
                                </Button>
                                <Border Style="{StaticResource SidebarGroupPanel}"
                                        Visibility="{Binding IsBudgetFundsPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Command="{Binding NavBarangayFundsCommand}"
                                                Style="{StaticResource SidebarGroupItemButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="MapMarkerRadius" Width="20" Height="20" Margin="0,0,12,0"/>
                                                <TextBlock Text="Barangay Funds" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding NavGroupFundsCommand}"
                                                Style="{StaticResource SidebarGroupItemButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AccountMultiple" Width="20" Height="20" Margin="0,0,12,0"/>
                                                <TextBlock Text="Group Funds" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding NavAllocatedFundsCommand}"
                                                Style="{StaticResource SidebarGroupItemButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="BankTransfer" Width="20" Height="20" Margin="0,0,12,0"/>
                                                <TextBlock Text="Allocated Funds" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Visibility="{Binding CanAccessManageAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Command="{Binding OpenAdminToolsCommand}"
                                        Style="{StaticResource SidebarGroupButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="ShieldAccount" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Admin Tools" FontSize="13" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="2">
                                            <materialDesign:PackIcon Kind="ChevronDown"
                                                                     Width="18"
                                                                     Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsAdminToolsPopupOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                                            <materialDesign:PackIcon Kind="ChevronUp"
                                                                     Width="18"
                                                                     Height="18"
                                                                     VerticalAlignment="Center"
                                                                     Visibility="{Binding IsAdminToolsPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Grid>
                                </Button>
                                <Border Style="{StaticResource SidebarGroupPanel}"
                                        Visibility="{Binding IsAdminToolsPopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <Button Command="{Binding NavManageAccountsCommand}"
                                                Style="{StaticResource SidebarGroupItemButton}"
                                                Visibility="{Binding CanAccessManageAccounts, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ShieldAccount" Width="20" Height="20" Margin="0,0,12,0"/>
                                                <TextBlock Text="Manage Accounts" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding NavAnnouncementsCommand}"
                                                Style="{StaticResource SidebarGroupItemButton}"
                                                Visibility="{Binding CanAccessAnnouncements, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Bullhorn" Width="20" Height="20" Margin="0,0,12,0"/>
                                                <TextBlock Text="Announcements" FontSize="13"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,4"
                                    Visibility="{Binding ShowClassicNavigationFlow, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="DASHBOARD" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="16,12,16,4"/>
                            <Button Command="{Binding NavBeneficiaryPortalCommand}" Visibility="{Binding IsBeneficiary, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountHeart" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="My Claim Portal" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavHomeCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Home" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Home" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavDashboardCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ViewDashboard" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Dashboard" FontSize="13"/></StackPanel></Button>

                            <TextBlock Text="MEMBER MANAGEMENT"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#64748B"
                                       Margin="16,16,16,4"
                                       Visibility="{Binding ShowMemberManagementSection, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <StackPanel Visibility="{Binding ShowMemberManagementMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Command="{Binding NavRegisterMemberCommand}"
                                        Style="{StaticResource SidebarNavButton}"
                                        Visibility="{Binding CanAccessRegisterMember, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountPlus"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,12,0"/>
                                        <TextBlock Text="CRS Listview" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding NavManageMembersCommand}"
                                        Style="{StaticResource SidebarNavButton}"
                                        Visibility="{Binding CanAccessManageMembers, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AccountCheck"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Margin="0,0,12,0"/>
                                        <TextBlock Text="Manage Members" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Command="{Binding NavEmployeesCommand}"
                                    Style="{StaticResource SidebarNavButton}"
                                    Visibility="{Binding CanAccessEmployees, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20" Margin="0,0,12,0"/>
                                    <TextBlock Text="Employee Records" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <TextBlock Text="PAYMENT MANAGEMENT" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="16,16,16,4"/>
                            <Button Command="{Binding NavPremiumsCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Payments / Premiums" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavSourceFundsCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Wallet" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Budget Funds" FontSize="13"/></StackPanel></Button>

                            <TextBlock Text="CLAIM MANAGEMENT" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="16,16,16,4"/>
                            <Button Command="{Binding NavClaimsCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ClipboardPlus" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="File / Manage Claims" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavPendingMembersCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountClock" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Pending Members" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavPendingClaimsCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ClipboardClock" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Pending Claims" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavReviewQueueCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ClipboardList" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="All Reviews" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavBenefitsCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="HeartPulse" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Benefit Releases" FontSize="13"/></StackPanel></Button>

                            <TextBlock Text="REPORTING" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="16,16,16,4"/>
                            <Button Command="{Binding NavTransactionsCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="SwapHorizontal" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Audit / Transactions" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavDocumentsCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FolderOpen" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Documents" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavCedulasCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CardAccountDetails" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Cedulas" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavReportsCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ChartBar" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Reports" FontSize="13"/></StackPanel></Button>

                            <TextBlock Text="SETUP" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="16,16,16,4"/>
                            <Button Command="{Binding NavCompanyProfileCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Domain" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Company Profile" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavSettingsCommand}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Cog" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="Settings" FontSize="13"/></StackPanel></Button>

                            <!-- EMPLOYEE SECTION -->
                            <TextBlock Text="MY ACCOUNT" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="16,16,16,4" Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Command="{Binding NavMyProfileCommand}" Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="AccountCircle" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="My Profile" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavMyPoliciesCommand}" Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ShieldStar" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="My Policies" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavMyClaimsCommand}" Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ClipboardList" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="My Claims" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavMyPremiumsCommand}" Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="CashMultiple" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="My Premiums" FontSize="13"/></StackPanel></Button>
                            <Button Command="{Binding NavMyBenefitsCommand}" Visibility="{Binding IsEmployee, Converter={StaticResource BoolToVisibilityConverter}}" Style="{StaticResource SidebarNavButton}"><StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="HeartPulse" Width="20" Height="20" Margin="0,0,12,0"/><TextBlock Text="My Benefits" FontSize="13"/></StackPanel></Button>
                        </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ContentControl x:Name="MainContent"
                            Grid.Column="1"
                            Background="{StaticResource BackgroundBrush}"
                            Focusable="False"/>
        </Grid>
    </Grid>
</Window>

