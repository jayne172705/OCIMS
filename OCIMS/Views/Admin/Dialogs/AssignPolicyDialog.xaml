<Window x:Class="eSureHi.Views.Admin.Dialogs.AssignPolicyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Assign Policy"
        Width="700" Height="670"
        MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#1565C0" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="AccountPlus"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding DialogTitle}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Loading Bar ── -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                     Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsLoading,
                         Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ── Content ── -->
        <Grid Grid.Row="2" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Employee Picker -->
            <Border Grid.Column="0"
                    BorderBrush="#DDE4EF" BorderThickness="1"
                    CornerRadius="4" Background="White" helpers:Adaptive.UseAdaptiveForeground="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Border Grid.Row="0" Padding="12,10"
                            BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Select Employee"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding SearchText,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search name or employee no..."
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Height="48" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Employee List -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredEmployees}"
                             SelectedItem="{Binding SelectedEmployee}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36"
                                            CornerRadius="18" Background="{StaticResource PrimaryBrush}" helpers:Adaptive.UseAdaptiveForeground="True"
                                            Margin="0,0,10,0">
                                        <TextBlock FontSize="13" FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}{1}">
                                                    <Binding Path="FirstName[0]"/>
                                                    <Binding Path="LastName[0]"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="13" FontWeight="Medium"/>
                                        <TextBlock FontSize="11" Foreground="#64748B">
                                            <Run Text="{Binding EmployeeNo}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding EmploymentType}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>

            <!-- Right: Assignment Details -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Assignment Details"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <TextBox Text="{Binding CoverageLimit, UpdateSourceTrigger=LostFocus,
                             StringFormat={}{0:N2}}"
                         materialDesign:HintAssist.Hint="Coverage Limit (PHP, e.g. 50,000.00)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,10" FontSize="13"/>

                <TextBox Text="{Binding EmployeeShare, UpdateSourceTrigger=LostFocus,
                             StringFormat={}{0:N2}}"
                         materialDesign:HintAssist.Hint="Employee Share per month (PHP, e.g. 1,000.00)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,10" FontSize="13"/>

                <TextBox Text="{Binding EmployerShare, UpdateSourceTrigger=LostFocus,
                             StringFormat={}{0:N2}}"
                         materialDesign:HintAssist.Hint="Employer Share per month (PHP, e.g. 1,500.00)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,10" FontSize="13"/>

                <DatePicker SelectedDate="{Binding StartDate}"
                            materialDesign:HintAssist.Hint="Start Date *"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Margin="0,0,0,10" FontSize="13"/>

                <DatePicker SelectedDate="{Binding EndDate}"
                            materialDesign:HintAssist.Hint="End Date (optional)"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Margin="0,0,0,10" FontSize="13"/>

                <ComboBox ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding AssignmentStatus}"
                          materialDesign:HintAssist.Hint="Assignment Status"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,10" FontSize="13"/>

                <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Remarks (optional)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Height="80" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="13"/>

                <!-- Selected Employee Preview -->
                <materialDesign:Card Margin="0,12,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                                     BorderBrush="#DDE4EF"
                                     BorderThickness="1"
                                     materialDesign:ElevationAssist.Elevation="Dp0"
                                     Visibility="{Binding HasSelection,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="Assigning to:"
                                   FontSize="10" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedEmployee.FullName}"
                                   FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedEmployee.EmployeeNo}"
                                   FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedEmployee.EmploymentType}"
                                   FontSize="11" FontWeight="SemiBold" Foreground="#1565C0"/>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </Grid>

        <!-- ── Footer ── -->
        <Border Grid.Row="3"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" Width="90"/>
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy,
                                Converter={StaticResource InverseBoolConverter}}"
                            Background="{StaticResource PrimaryBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="140">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlus"
                                                     Width="16" Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Assign Policy" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
