<Window x:Class="eSureHi.Views.Admin.Dialogs.BarangayFundReleaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Release Barangay Fund"
        Width="540"
        Height="650"
        MinWidth="500"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
            <StackPanel Orientation="Horizontal" Margin="22,0" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CashFast" Width="25" Height="25" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Release Barangay Fund" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BarangayDisplay}" FontSize="12" Opacity="0.86"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,22">
                <Border Background="#E8F2FF" BorderBrush="#BFDBFE" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Current barangay balance" Foreground="#475569"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentBalance, StringFormat=₱{0:N2}}"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </Grid>
                </Border>

                <ComboBox x:Name="SourceFundComboBox"
                          ItemsSource="{Binding SourceOptions}"
                          SelectedItem="{Binding SelectedSource}"
                          DisplayMemberPath="DisplayText"
                          materialDesign:HintAssist.Hint="Source fund"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Height="52"
                          Margin="0,0,0,14"/>

                <TextBox x:Name="AmountTextBox"
                         materialDesign:HintAssist.Hint="Amount to release"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Height="52"
                         Margin="0,0,0,14"/>

                <DatePicker x:Name="ReleaseDatePicker"
                            SelectedDate="{Binding ReleaseDate}"
                            materialDesign:HintAssist.Hint="Release date"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            Height="52"
                            Margin="0,0,0,14"/>

                <TextBox x:Name="ReferenceTextBox"
                         materialDesign:HintAssist.Hint="Reference / voucher number"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Height="52"
                         Margin="0,0,0,14"/>

                <TextBox x:Name="PurposeTextBox"
                         materialDesign:HintAssist.Hint="Purpose"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Height="52"
                         Margin="0,0,0,14"/>

                <TextBox x:Name="RemarksTextBox"
                         materialDesign:HintAssist.Hint="Remarks (optional)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="84"/>

                <TextBlock x:Name="ValidationText"
                           Foreground="{StaticResource ErrorBrush}"
                           TextWrapping="Wrap"
                           Margin="2,12,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE4EF" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0">
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Height="38"
                        Padding="18,0"
                        Margin="0,0,10,0"/>
                <Button Click="Release_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Height="38"
                        Padding="18,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashFast" Width="17" Height="17" Margin="0,0,7,0"/>
                        <TextBlock Text="Release Fund"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
