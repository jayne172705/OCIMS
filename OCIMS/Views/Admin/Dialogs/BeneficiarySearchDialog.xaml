<Window x:Class="eSureHi.Views.Admin.Dialogs.BeneficiarySearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Beneficiaries - Select Record"
        Width="860"
        Height="680"
        MinWidth="740"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="White"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="AccountSearch"
                                         Width="24"
                                         Height="24"
                                         Foreground="{StaticResource PrimaryBrush}"
                                         Margin="0,0,10,0"/>
                <TextBlock Text="Select Beneficiary"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#94A3B8">
                <Run Text="{Binding ActiveFilteredCount, Mode=OneWay}"/>
                <Run Text=" / "/>
                <Run Text="{Binding ActiveTotalCount, Mode=OneWay}"/>
            </TextBlock>

            <Button Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    Height="34"
                    Padding="12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding SourceOptions}"
                      SelectedItem="{Binding SelectedSource}"
                      materialDesign:HintAssist.Hint="Source"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Height="50"
                      FontSize="12"/>

            <TextBox Grid.Column="2"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search name, beneficiary ID..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Height="50"
                     FontSize="12">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>

            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding StatusFilter}"
                      materialDesign:HintAssist.Hint="Status"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Height="50"
                      FontSize="12"
                      Visibility="{Binding IsCrsSource, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <Grid Grid.Row="3">
            <ListBox x:Name="CrsList"
                     ItemsSource="{Binding DisplayedRecords}"
                     SelectedItem="{Binding SelectedRecord}"
                     PreviewMouseLeftButtonUp="ResultList_MouseLeftButtonUp"
                     MouseDoubleClick="ResultList_MouseDoubleClick"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding IsCrsSource, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BeneficiaryId}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding DateOfBirth}" FontSize="12" Foreground="#334155" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#334155">
                                        <Run Text="{Binding Sex, TargetNullValue=No sex}"/>
                                        <Run Text="  |  "/>
                                        <Run Text="{Binding RegistrationDetailText}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11"
                                               Foreground="#64748B"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding IsRegisteredMember, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Run Text="Household: "/>
                                        <Run Text="{Binding RegisteredHouseholdId, TargetNullValue=Not set}"/>
                                        <Run Text="  |  "/>
                                        <Run Text="{Binding RegisteredWorkflowStatus}"/>
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding CivilRegistryId, TargetNullValue=No CRS ID}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="11,5"
                                        CornerRadius="12"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FFF8E1"/>
                                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRegisteredMember}" Value="True">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                    <Setter Property="BorderBrush" Value="#C8E6C9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding RegisteredRoleBadge}" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#92400E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRegisteredMember}" Value="True">
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ListBox x:Name="SystemList"
                     ItemsSource="{Binding DisplayedSystemBeneficiaries}"
                     SelectedItem="{Binding SelectedSystemBeneficiary}"
                     PreviewMouseLeftButtonUp="ResultList_MouseLeftButtonUp"
                     MouseDoubleClick="ResultList_MouseDoubleClick"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding IsSystemSource, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BeneficiaryId}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding Relationship}" FontSize="12" Foreground="#334155" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding FullName}" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding Employee.FullName, TargetNullValue=No employee}" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding SourceOfFunds, TargetNullValue=No source}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Column="3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Padding="11,5"
                                        CornerRadius="12"
                                        Background="#E8F5E9"
                                        BorderBrush="#C8E6C9"
                                        BorderThickness="1">
                                    <TextBlock Text="Saved" FontSize="12" FontWeight="Bold" Foreground="#2E7D32"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Click="ShowAllButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    Height="34"
                    Padding="16,0"
                    Margin="0,0,8,0">
                <TextBlock Text="SHOW ALL" FontSize="12" FontWeight="SemiBold"/>
            </Button>
            <Button Click="CloseButton_Click"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    Height="34"
                    Padding="16,0"
                    Margin="0,0,8,0">
                <TextBlock Text="CLOSE" FontSize="12" FontWeight="SemiBold"/>
            </Button>
            <Button Click="SelectButton_Click"
                    IsEnabled="{Binding HasSelection}"
                    Background="{StaticResource PrimaryBrush}"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="34"
                    Padding="18,0">
                <TextBlock Text="SELECT" FontSize="12" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
