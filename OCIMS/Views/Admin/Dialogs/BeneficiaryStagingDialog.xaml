<Window x:Class="eSureHi.Views.Admin.Dialogs.BeneficiaryStagingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Beneficiary Lookup"
        Width="1240" Height="760"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="0"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1565C0" helpers:Adaptive.UseAdaptiveForeground="True"
                Visibility="Collapsed">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="AccountSearch" Width="20" Height="20"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Beneficiary Lookup" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Click="CloseButton_Click"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                     VerticalAlignment="Top"
                     Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Search/list modal first -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              Visibility="{Binding IsProfileOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
            <materialDesign:Card Width="520"
                                 MaxHeight="620"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Background="White"
                                 materialDesign:ElevationAssist.Elevation="Dp8">
                <Grid Margin="20,18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="AccountSearch"
                                                     Width="22" Height="22"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Margin="0,0,8,0"/>
                            <TextBlock Text="Find Beneficiary"
                                       FontSize="18" FontWeight="SemiBold"/>
                            <Border Background="#E3F2FD" CornerRadius="10" Padding="8,2" Margin="12,0,0,0">
                                <TextBlock FontSize="11" Foreground="#1565C0">
                                    <Run Text="{Binding ActiveFilteredCount, Mode=OneWay}"/>
                                    <Run Text="of"/>
                                    <Run Text="{Binding ActiveTotalCount, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding ImportCommand}"
                                    Background="{StaticResource PrimaryBrush}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="34" Padding="12,0" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="DatabaseImport" Width="16" Height="16"
                                                             Margin="0,0,6,0"/>
                                    <TextBlock Text="Sync CRS" FontSize="12"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    BorderBrush="{StaticResource PrimaryBrush}"
                                    Height="34" Padding="12,0" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                            </Button>
                            <Button Click="CloseButton_Click"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Width="34" Height="34"
                                    ToolTip="Close">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding SourceOptions}"
                                  SelectedItem="{Binding SelectedSource}"
                                  materialDesign:HintAssist.Hint="Source"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Height="48" FontSize="12"/>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding SourceCaption}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"/>

                        <ComboBox Grid.Column="4"
                                  ItemsSource="{Binding StatusOptions}"
                                  SelectedItem="{Binding StatusFilter}"
                                  materialDesign:HintAssist.Hint="Status"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Height="48" FontSize="12"
                                  Visibility="{Binding IsCrsSource, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox"
                                 Grid.Column="0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Search by name or beneficiary ID..."
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="54" FontSize="13">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource PrimaryBrush}"
                                Height="54"
                                Width="54"
                                Margin="8,0,0,0"
                                ToolTip="Search">
                            <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18"/>
                        </Button>

                        <Button Grid.Column="2"
                                Command="{Binding ClearFilterCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource PrimaryBrush}"
                                Height="54" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilterRemove" Width="15" Height="15"
                                                         Margin="0,0,4,0"/>
                                <TextBlock Text="Clear" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding DisplayedRecords}"
                             SelectedItem="{Binding SelectedRecord}"
                             SelectionChanged="ResultList_SelectionChanged"
                             BorderThickness="1"
                             BorderBrush="#DDE4EF"
                             MaxHeight="400"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsCrsSource, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding BeneficiaryId}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding DateOfBirth}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding Sex}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding RegistrationDetailText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRegisteredMember}" Value="True">
                                                            <Setter Property="Foreground" Value="#047857"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontSize="10"
                                                   Foreground="#64748B"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsRegisteredMember, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Run Text="Household: "/>
                                            <Run Text="{Binding RegisteredHouseholdId, TargetNullValue=Not set}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding RegisteredWorkflowStatus}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            CornerRadius="10"
                                            Padding="8,3"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E3F2FD"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LinkStatus}" Value="Unlinked">
                                                        <Setter Property="Background" Value="#FFF8E1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsRegisteredMember}" Value="True">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LinkStatus}" Value="Skipped">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding RegisteredRoleBadge}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#92400E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsRegisteredMember}" Value="True">
                                                            <Setter Property="Foreground" Value="#166534"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LinkStatus}" Value="Skipped">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding DisplayedSystemBeneficiaries}"
                             SelectedItem="{Binding SelectedSystemBeneficiary}"
                             SelectionChanged="ResultList_SelectionChanged"
                             BorderThickness="1"
                             BorderBrush="#DDE4EF"
                             MaxHeight="400"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsSystemSource, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding FullName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11" Foreground="#64748B">
                                            <Run Text="{Binding Employee.FullName, TargetNullValue=No employee}"/>
                                            <Run Text=" - "/>
                                            <Run Text="{Binding Relationship, TargetNullValue=No relationship}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="#E8F5E9"
                                            CornerRadius="10"
                                            Padding="8,3"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Saved"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="4" Margin="0,10,0,0" FontSize="11"
                               Visibility="{Binding IsCrsSource, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Run Text="{Binding ActiveFilteredCount, Mode=OneWay}"/>
                        <Run Text=" record(s) shown - select a beneficiary to view profile"/>
                    </TextBlock>
                    <TextBlock Grid.Row="4" Margin="0,10,0,0" FontSize="11"
                               Visibility="{Binding IsSystemSource, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Run Text="{Binding ActiveFilteredCount, Mode=OneWay}"/>
                        <Run Text=" saved beneficiary record(s) shown from eSureHi database"/>
                    </TextBlock>
                    <TextBlock Grid.Row="4"
                               Text="{Binding ImportMessage}"
                               FontSize="11"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Right"
                               Margin="0,10,0,0"
                               Visibility="{Binding IsImporting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Full profile after selection -->
        <Grid Grid.Row="0"
              Grid.RowSpan="3"
              Background="{StaticResource BackgroundBrush}"
              Visibility="{Binding IsProfileOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#DDE4EF"
                    BorderThickness="0,0,0,1"
                    Padding="16,4">
                <Grid>
                <Button Command="{Binding BackToSearchCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Foreground="{StaticResource PrimaryBrush}"
                        BorderBrush="{StaticResource PrimaryBrush}"
                        Height="36" Padding="12,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Text="Back to Search" FontSize="12"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding LinkCommand}"
                            Background="{StaticResource SuccessBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="36" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountCheck" Width="16" Height="16"
                                                     Margin="0,0,6,0"/>
                            <TextBlock Text="Approve Beneficiary" FontSize="12"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <materialDesign:Card Grid.Column="0" Background="White" materialDesign:ElevationAssist.Elevation="Dp2">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="18">
                            <TextBlock Text="{Binding SelectedRecord.DisplayName}" FontSize="22"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedRecord.BeneficiaryId}" Foreground="#0D47A1"
                                       Margin="0,4,0,14"/>

                            <TextBlock Text="Link Status" FontSize="11" Foreground="#64748B"/>
                            <Border CornerRadius="12" Padding="10,5" Margin="0,4,0,14" Background="#FFF8E1">
                                <TextBlock Text="{Binding SelectedRecord.LinkStatus}" FontWeight="SemiBold"/>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Sex" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedRecord.Sex}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Birth Date" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedRecord.DateOfBirth}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Civil Registry ID" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedRecord.CivilRegistryId, TargetNullValue=None}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Age" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedRecord.Age, TargetNullValue=None}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </UniformGrid>

                            <UniformGrid Columns="2" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Marital Status" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SelectedRecord.MaritalStatus, TargetNullValue=None}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Special Status" FontSize="11" Foreground="#64748B"/>
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="PWD: "/>
                                        <Run Text="{Binding SelectedRecord.IsPwd}"/>
                                        <Run Text=" / Senior: "/>
                                        <Run Text="{Binding SelectedRecord.IsSenior}"/>
                                    </TextBlock>
                                </StackPanel>
                            </UniformGrid>

                            <TextBlock Text="Address" FontSize="11" Foreground="#64748B"/>
                            <TextBlock Text="{Binding ProfileAddress}" TextWrapping="Wrap" Margin="0,2,0,14"/>

                            <TextBlock Text="Validation" FontSize="11" Foreground="#64748B"/>
                            <Border CornerRadius="12" Padding="10,5" Margin="0,4,0,10" Background="#E3F2FD">
                                <TextBlock Text="{Binding ProfileStatus}" Foreground="#0D47A1" FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock Text="Cedula" FontSize="11" Foreground="#64748B"/>
                            <Border CornerRadius="12" Padding="10,5" Margin="0,4,0,10" Background="#F8FAFC">
                                <TextBlock Text="{Binding ProfileCedulaStatus}" FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock Text="Transactions" FontSize="11" Foreground="#64748B"/>
                            <Border CornerRadius="12" Padding="10,5" Margin="0,4,0,18" Background="#F8FAFC">
                                <TextBlock Text="{Binding ProfileTransactionStatus}" FontWeight="SemiBold"/>
                            </Border>

                            <TextBlock Text="Eligibility" FontSize="11" Foreground="#64748B"/>
                            <Border CornerRadius="12" Padding="10,5" Margin="0,4,0,18" Background="#FFF8E1">
                                <TextBlock Text="{Binding EligibilityStatus}" Foreground="#8A5A00" FontWeight="SemiBold"/>
                            </Border>

                            <Separator Margin="0,0,0,14"/>

                            <TextBlock Text="Add Beneficiary Details" FontSize="15" FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <TextBox Text="{Binding EmployeeSearch, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search employee to link..."
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Height="50" Margin="0,0,0,8"/>

                            <ListBox ItemsSource="{Binding FilteredEmployees}"
                                     SelectedItem="{Binding SelectedEmployee}"
                                     Height="120" BorderBrush="#DDE4EF" BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,10">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6,4">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding EmployeeNo}" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ComboBox ItemsSource="{Binding RelationshipOptions}"
                                      SelectedItem="{Binding Relationship}"
                                      materialDesign:HintAssist.Hint="Relationship"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Height="50" Margin="0,0,0,8"/>

                            <ComboBox ItemsSource="{Binding InsurancePolicies}"
                                      SelectedValue="{Binding RecipientsInsurance, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="PolicyName"
                                      materialDesign:HintAssist.Hint="Insurance"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Height="50" Margin="0,0,0,8">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PolicyName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ProviderName, TargetNullValue=No provider}"
                                                       FontSize="11"
                                                       Foreground="#64748B"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox ItemsSource="{Binding SourceOfFundsOptions}"
                                      SelectedItem="{Binding SourceOfFunds}"
                                      materialDesign:HintAssist.Hint="Source of Funds"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Height="50" Margin="0,0,0,8"/>

                            <TextBox Text="{Binding CedulaNo, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Cedula No"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Height="50" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding Received}" Content="Received"
                                          VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding Contribution, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                         materialDesign:HintAssist.Hint="Contribution"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                       TextWrapping="Wrap" FontSize="11"
                                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>
                </materialDesign:Card>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                        <materialDesign:Card Margin="0,0,6,0" Background="White">
                            <StackPanel Margin="14,10">
                                <TextBlock Text="Employee" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ProfileEmployee.FullName, TargetNullValue=Not linked}"
                                           FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="6,0" Background="White">
                            <StackPanel Margin="14,10">
                                <TextBlock Text="Cedula Status" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ProfileCedulaStatus}"
                                           FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="6,0" Background="White">
                            <StackPanel Margin="14,10">
                                <TextBlock Text="Benefits Received" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ProfileBenefits.Count}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="6,0,0,0" Background="White">
                            <StackPanel Margin="14,10">
                                <TextBlock Text="Source of Funds" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding SourceOfFunds}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>

                    <TabControl Grid.Row="1" Background="White">
                        <TabItem Header="Benefits">
                            <DataGrid ItemsSource="{Binding ProfileBenefits}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      Style="{StaticResource ReadableDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Policy" Binding="{Binding EmployeePolicy.Policy.PolicyName}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding BenefitType}" Width="130"/>
                                    <DataGridTextColumn Header="Year" Binding="{Binding YearPeriod}" Width="80"/>
                                    <DataGridTextColumn Header="Used" Binding="{Binding UsedBenefit, StringFormat={}{0:N2}}" Width="110"/>
                                    <DataGridTextColumn Header="Remaining" Binding="{Binding Remaining, StringFormat={}{0:N2}}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Cedula">
                            <DataGrid ItemsSource="{Binding ProfileCedulas}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      Style="{StaticResource ReadableDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Cedula No" Binding="{Binding CedulaNo}" Width="160"/>
                                    <DataGridTextColumn Header="Issue Date" Binding="{Binding IssueDate, StringFormat={}{0:MMM dd, yyyy}}" Width="140"/>
                                    <DataGridTextColumn Header="Place" Binding="{Binding PlaceIssued}" Width="*"/>
                                    <DataGridTextColumn Header="Amount Paid" Binding="{Binding AmountPaid, StringFormat={}{0:N2}}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Transactions">
                            <DataGrid ItemsSource="{Binding ProfileTransactions}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      BorderThickness="0"
                                      Style="{StaticResource ReadableDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No" Binding="{Binding TransactionNo}" Width="140"/>
                                    <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="130"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat={}{0:MMM dd, yyyy}}" Width="130"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Requirements">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ProfileRequirements}" Margin="12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E2E8F0"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="4,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,10,0">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Kind" Value="AlertCircle"/>
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMet}" Value="True">
                                                                        <Setter Property="Kind" Value="CheckCircle"/>
                                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding StatusText}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#DDE4EF" BorderThickness="0,1,0,0"
                Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </Border.Style>
            <TextBlock FontSize="11">
                <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                <Run Text=" CRS record(s) - Select a beneficiary to review validation, cedula, benefits, and transactions"/>
            </TextBlock>
        </Border>
    </Grid>
</Window>
