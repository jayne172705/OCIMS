<Window x:Class="eSureHi.Views.Admin.Dialogs.BenefitFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Benefit"
        Width="700" Height="600"
        MinWidth="640" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="HeartPlus"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding DialogTitle}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Employee Picker -->
            <Border Grid.Column="0"
                    BorderBrush="#DDE4EF" BorderThickness="1"
                    CornerRadius="4" Background="White" helpers:Adaptive.UseAdaptiveForeground="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,10"
                            BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Select Employee *"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding EmployeeSearch,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search name or employee no..."
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Height="50" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredEmployees}"
                             SelectedItem="{Binding SelectedEmployee}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding FullName}"
                                               FontSize="13" FontWeight="Medium"/>
                                    <TextBlock FontSize="11">
                                        <Run Text="{Binding EmployeeNo}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Department.DeptName}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Benefit Details -->
            <StackPanel Grid.Column="2">

                <TextBlock Text="Policy Assignment *"
                           FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>

                <ProgressBar IsIndeterminate="True" Height="2"
                             Margin="0,0,0,8"
                             Foreground="{StaticResource PrimaryBrush}"
                             Visibility="{Binding IsLoadingPolicies,
                                 Converter={StaticResource BoolToVisibilityConverter}}"/>

                <TextBlock Text="{Binding PolicyEmptyMessage}"
                           FontSize="12"
                           Margin="0,0,0,12"
                           TextWrapping="Wrap"
                           Visibility="{Binding HasPolicies,
                               Converter={StaticResource BoolToVisibilityConverter},
                               ConverterParameter=Invert}"/>

                <ComboBox ItemsSource="{Binding EmployeePolicies}"
                          SelectedItem="{Binding SelectedEmployeePolicy}"
                          materialDesign:HintAssist.Hint="Select Policy Assignment"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          IsEnabled="{Binding HasPolicies}"
                          Margin="0,0,0,12" FontSize="13">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Policy.PolicyName}"
                                           FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Policy.PolicyType}"
                                           FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Separator Margin="0,4,0,12" Background="#1C3A5E"/>

                <!-- Benefit Type + Year -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding BenefitTypes}"
                              SelectedItem="{Binding BenefitType}"
                              materialDesign:HintAssist.Hint="Benefit Type *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              FontSize="13"/>
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding YearOptions}"
                              SelectedItem="{Binding YearPeriod}"
                              materialDesign:HintAssist.Hint="Year *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              FontSize="13"/>
                </Grid>

                <!-- Max Benefit -->
                <TextBox x:Name="MaxBenefitTextBox"
                         Text="{Binding MaxBenefitText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Maximum Benefit Amount (PHP, e.g. 5,000.00) *"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,12" FontSize="13"
                         PreviewTextInput="MaxBenefitTextBox_OnPreviewTextInput"
                         PreviewKeyDown="MaxBenefitTextBox_OnPreviewKeyDown"
                         TextChanged="MaxBenefitTextBox_OnTextChanged"
                         GotKeyboardFocus="MaxBenefitTextBox_OnGotKeyboardFocus"/>

                <!-- Notes -->
                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Notes (optional)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Height="100" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="13"/>

                <!-- Selected Employee Preview -->
                <materialDesign:Card Margin="0,12,0,0" Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True"
                                     materialDesign:ElevationAssist.Elevation="Dp0"
                                     Visibility="{Binding HasEmployee,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="Adding benefit for:"
                                   FontSize="10" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedEmployee.FullName}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#2E7D32"/>
                        <TextBlock Text="{Binding SelectedEmployee.EmployeeNo}"
                                   FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </Grid>

        <!-- ── Footer ── -->
        <Border Grid.Row="2"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" Width="90"/>
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy,
                                Converter={StaticResource InverseBoolConverter}}"
                            Background="{StaticResource PrimaryBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="140">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"
                                                     Width="16" Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Save Benefit"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
