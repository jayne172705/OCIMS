<Window x:Class="eSureHi.Views.Admin.Dialogs.ClaimDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Claim Detail"
        Width="780" Height="680"
        MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="DialogLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <Style x:Key="DialogValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#1565C0" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="ClipboardList"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock FontSize="15" FontWeight="Bold" VerticalAlignment="Center">
                        <Run Text="Claim —"/>
                        <Run Text="{Binding Claim.ClaimNo}"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Claim Info -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Employee & Policy -->
                    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1"
                                         Margin="0,0,0,12">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="Beneficiary Claim"
                                       FontSize="14" FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding Claim.Employee.FullName}"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="#0F172A"/>
                            <TextBlock Text="{Binding Claim.Beneficiary.FullName}"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,2,0,0"/>
                            <TextBlock FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       Margin="0,2,0,6">
                                <Run Text="{Binding Claim.Employee.EmployeeNo}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding Claim.Employee.Department.DeptName}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding Claim.Policy.PolicyName}"
                                       FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding Claim.Policy.PolicyType}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Claim Details -->
                    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1"
                                         Margin="0,0,0,12">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="Claim Details"
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Claim Type:"
                                           Style="{StaticResource DialogLabelText}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Claim.ClaimType}"
                                           Style="{StaticResource DialogValueText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Claim Date:"
                                           Style="{StaticResource DialogLabelText}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Claim.ClaimDate,
                                               StringFormat={}{0:MMM dd, yyyy}}"
                                           Style="{StaticResource DialogValueText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Hospital/Clinic:"
                                           Style="{StaticResource DialogLabelText}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Claim.HospitalClinic}"
                                           Style="{StaticResource DialogValueText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Physician:"
                                           Style="{StaticResource DialogLabelText}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Claim.AttendingPhysician}"
                                           Style="{StaticResource DialogValueText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Incident Description:"
                                           Style="{StaticResource DialogLabelText}"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Claim.IncidentDescription}"
                                           Style="{StaticResource DialogValueText}"
                                           LineHeight="19"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Amount Summary -->
                    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1"
                                         Margin="0,0,0,12">
                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="Claimed" FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Claim.AmountClaimed,
                                               StringFormat=₱{0:N2}}"
                                           FontSize="19" FontWeight="Bold"
                                           Foreground="#0F172A"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="Approved" FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Claim.AmountApproved,
                                               StringFormat=₱{0:N2}}"
                                           FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Released" FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding Claim.AmountReleased,
                                               StringFormat=₱{0:N2}}"
                                           FontSize="19" FontWeight="Bold"
                                           Foreground="{StaticResource InfoBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Documents -->
                    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="Documents"
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding Documents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,0,0,6">
                                            <materialDesign:PackIcon Kind="FileDocument"
                                                                     Width="16" Height="16"
                                                                     Foreground="{StaticResource PrimaryBrush}"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding DocType}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="#334155"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No documents attached."
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"
                                       Visibility="{Binding HasNoDocuments,
                                           Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </ScrollViewer>

            <!-- Right: Status + Workflow -->
            <StackPanel Grid.Column="2">

                <!-- Status Badge -->
                <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1"
                                     Margin="0,0,0,12">
                    <StackPanel Margin="16,14" HorizontalAlignment="Center">
                        <TextBlock Text="Current Status"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <Border CornerRadius="16" Padding="20,8"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Setter Property="BorderBrush" Value="#1E293B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClaimStatus}" Value="Draft">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ClaimStatus}" Value="Submitted">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ClaimStatus}" Value="Under Review">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                            <Setter Property="BorderBrush" Value="#F97316"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ClaimStatus}" Value="Approved">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                            <Setter Property="BorderBrush" Value="#16A34A"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ClaimStatus}" Value="Partially Approved">
                                            <Setter Property="Background" Value="#F1F8E9"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ClaimStatus}" Value="Rejected">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                            <Setter Property="BorderBrush" Value="#DC2626"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ClaimStatus}" Value="Released">
                                            <Setter Property="Background" Value="#E0F7FA"/>
                                            <Setter Property="BorderBrush" Value="#0891B2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ClaimStatus}"
                                       FontSize="15" FontWeight="Bold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ClaimStatus}" Value="Submitted">
                                                <Setter Property="Foreground" Value="#1565C0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ClaimStatus}" Value="Under Review">
                                                <Setter Property="Foreground" Value="#E65100"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ClaimStatus}" Value="Approved">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ClaimStatus}" Value="Partially Approved">
                                                <Setter Property="Foreground" Value="#558B2F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ClaimStatus}" Value="Rejected">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ClaimStatus}" Value="Released">
                                                <Setter Property="Foreground" Value="#00838F"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Workflow Actions -->
                <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1"
                                     Margin="0,0,0,12">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="Workflow Actions"
                                   FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                        <!-- Submit -->
                        <Button Command="{Binding SubmitCommand}"
                                Visibility="{Binding CanSubmit,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Height="40" Margin="0,0,0,8"
                                Background="{StaticResource PrimaryBrush}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Send"
                                                         Width="16" Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Submit for Review"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Mark Under Review -->
                        <Button Command="{Binding ReviewCommand}"
                                Visibility="{Binding CanReview,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Height="40" Margin="0,0,0,8"
                                Background="{StaticResource WarningBrush}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClipboardSearch"
                                                         Width="16" Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Mark Under Review"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Approve -->
                        <StackPanel Visibility="{Binding CanApprove,
                                        Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,0,8">
                            <TextBox Text="{Binding AmountApproved,
                                         UpdateSourceTrigger=PropertyChanged,
                                         StringFormat={}{0:N2}}"
                                     materialDesign:HintAssist.Hint="Amount to Approve (₱)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="14"
                                     Padding="12,8"
                                     Height="46"
                                     Margin="0,0,0,8"/>
                            <Button Command="{Binding ApproveCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Height="40"
                                    Background="{StaticResource SuccessBrush}"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckCircle"
                                                             Width="16" Height="16"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Approve Claim"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Reject -->
                        <StackPanel Visibility="{Binding CanReject,
                                        Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,0,8">
                            <TextBox Text="{Binding RejectionReason,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Rejection reason *"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Height="60" VerticalContentAlignment="Top"
                                     FontSize="14"
                                     Padding="12,8"
                                     Margin="0,0,0,8"/>
                            <Button Command="{Binding RejectCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Height="40"
                                    Background="{StaticResource ErrorBrush}"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CloseCircle"
                                                             Width="16" Height="16"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Reject Claim"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Release -->
                        <StackPanel Visibility="{Binding CanRelease,
                                        Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,0,8">
                            <TextBox Text="{Binding AmountReleased,
                                         UpdateSourceTrigger=PropertyChanged,
                                         StringFormat={}{0:N2}}"
                                     materialDesign:HintAssist.Hint="Amount to Release (₱)"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="14"
                                     Padding="12,8"
                                     Height="46"
                                     Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding SourceOfFundsOptions}"
                                      SelectedItem="{Binding SourceOfFunds}"
                                      materialDesign:HintAssist.Hint="Source of Funds"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="14"
                                      Padding="12,8"
                                      Margin="0,0,0,8"/>
                            <Button Command="{Binding ReleaseCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Height="40"
                                    Background="#00838F"
                                    Style="{StaticResource MaterialDesignRaisedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashFast"
                                                             Width="16" Height="16"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Release Payment"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Cancel -->
                        <Button Command="{Binding CancelClaimCommand}"
                                Visibility="{Binding CanCancel,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Height="36"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{StaticResource ErrorBrush}"
                                BorderBrush="{StaticResource ErrorBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cancel"
                                                         Width="16" Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Cancel Claim"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Rejection Reason Display -->
                        <materialDesign:Card Margin="0,8,0,0" Background="#B71C1C" helpers:Adaptive.UseAdaptiveForeground="True"
                                             materialDesign:ElevationAssist.Elevation="Dp0"
                                             Visibility="{Binding ShowRejectionReason,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="12,10">
                                <TextBlock Text="Rejection Reason:"
                                           FontSize="12" Foreground="#FFCDD2"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Claim.RejectionReason}"
                                           FontSize="13" Foreground="White"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                    </StackPanel>
                </materialDesign:Card>

                <!-- Status Message -->
                        <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding StatusMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>

            </StackPanel>
        </Grid>

        <!-- ── Footer ── -->
        <Border Grid.Row="2"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="90"/>
        </Border>
    </Grid>
</Window>
