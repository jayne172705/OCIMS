<Window x:Class="eSureHi.Views.Admin.Dialogs.ClaimQueueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="{Binding DialogTitle}"
        Width="820"
        Height="680"
        MinWidth="720"
        MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="ClipboardCheck"
                                         Width="24"
                                         Height="24"
                                         Foreground="{StaticResource PrimaryBrush}"
                                         Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding SelectionTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding QueueCountText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#94A3B8"/>
            <Button Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    Height="34"
                    Padding="12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search name, claim no, policy..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Height="50"
                     FontSize="12"/>

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding TypeOptions}"
                      SelectedItem="{Binding TypeFilter}"
                      materialDesign:HintAssist.Hint="Claim Type"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Height="50"
                      FontSize="12"/>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#E3F2FD" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InboxArrowDown" Width="15" Height="15" Foreground="#1565C0" Margin="0,0,6,0"/>
                        <TextBlock Text="SUBMITTED" FontSize="12" FontWeight="Bold" Foreground="#1565C0"/>
                        <Border Background="#1565C0" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding SubmittedCount}" Foreground="White" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding SubmittedClaims}"
                          SelectedItem="{Binding SelectedClaim}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5EAF2"
                          RowHeight="42"
                          MaxHeight="150"
                          BorderThickness="0"
                          Style="{StaticResource ReadableDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Claim #" Binding="{Binding ClaimNo}" Width="120"/>
                        <DataGridTextColumn Header="Employee" Binding="{Binding Employee.FullName}" Width="170"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding ClaimType}" Width="110"/>
                        <DataGridTextColumn Header="Policy" Binding="{Binding Policy.PolicyName}" Width="*"/>
                        <DataGridTextColumn Header="Claimed" Binding="{Binding AmountClaimed, StringFormat={}{0:N2}}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#FFF7E0" BorderBrush="#FFE0A3" BorderThickness="0,1,0,1" Padding="10,6" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClipboardSearch" Width="15" Height="15" Foreground="#C2410C" Margin="0,0,6,0"/>
                        <TextBlock Text="UNDER REVIEW" FontSize="12" FontWeight="Bold" Foreground="#C2410C"/>
                        <Border Background="#EA580C" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding UnderReviewCount}" Foreground="White" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding UnderReviewClaims}"
                          SelectedItem="{Binding SelectedClaim}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5EAF2"
                          RowHeight="42"
                          MaxHeight="150"
                          BorderThickness="0"
                          Style="{StaticResource ReadableDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Claim #" Binding="{Binding ClaimNo}" Width="120"/>
                        <DataGridTextColumn Header="Employee" Binding="{Binding Employee.FullName}" Width="170"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding ClaimType}" Width="110"/>
                        <DataGridTextColumn Header="Policy" Binding="{Binding Policy.PolicyName}" Width="*"/>
                        <DataGridTextColumn Header="Claimed" Binding="{Binding AmountClaimed, StringFormat={}{0:N2}}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#E8F5E9" BorderBrush="#C8E6C9" BorderThickness="0,1,0,1" Padding="10,6" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashCheck" Width="15" Height="15" Foreground="#2E7D32" Margin="0,0,6,0"/>
                        <TextBlock Text="APPROVED FOR RELEASE" FontSize="12" FontWeight="Bold" Foreground="#2E7D32"/>
                        <Border Background="#2E7D32" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding ApprovedCount}" Foreground="White" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding ApprovedClaims}"
                          SelectedItem="{Binding SelectedClaim}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5EAF2"
                          RowHeight="42"
                          MaxHeight="150"
                          BorderThickness="0"
                          Style="{StaticResource ReadableDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Claim #" Binding="{Binding ClaimNo}" Width="120"/>
                        <DataGridTextColumn Header="Employee" Binding="{Binding Employee.FullName}" Width="170"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding ClaimStatus}" Width="125"/>
                        <DataGridTextColumn Header="Policy" Binding="{Binding Policy.PolicyName}" Width="*"/>
                        <DataGridTextColumn Header="Approved" Binding="{Binding AmountApproved, StringFormat={}{0:N2}}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,1" Padding="10,6" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArchiveCheck" Width="15" Height="15" Foreground="#475569" Margin="0,0,6,0"/>
                        <TextBlock Text="RELEASED / REJECTED" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                        <Border Background="#475569" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                            <TextBlock Text="{Binding ClosedCount}" Foreground="White" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </Border>
                <DataGrid ItemsSource="{Binding ClosedClaims}"
                          SelectedItem="{Binding SelectedClaim}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5EAF2"
                          RowHeight="42"
                          MinHeight="120"
                          BorderThickness="0"
                          Style="{StaticResource ReadableDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Claim #" Binding="{Binding ClaimNo}" Width="120"/>
                        <DataGridTextColumn Header="Employee" Binding="{Binding Employee.FullName}" Width="170"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding ClaimStatus}" Width="110"/>
                        <DataGridTextColumn Header="Policy" Binding="{Binding Policy.PolicyName}" Width="*"/>
                        <DataGridTextColumn Header="Released" Binding="{Binding AmountReleased, StringFormat={}{0:N2}}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Command="{Binding ShowAllCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    Height="34"
                    Padding="16,0"
                    Margin="0,0,8,0">
                    <TextBlock Text="SHOW ALL" FontSize="12" FontWeight="SemiBold"/>
            </Button>
            <Button Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    Height="34"
                    Padding="16,0"
                    Margin="0,0,8,0">
                <TextBlock Text="CLOSE" FontSize="12" FontWeight="SemiBold"/>
            </Button>
            <Button Command="{Binding SelectCommand}"
                    Background="{StaticResource PrimaryBrush}"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="34"
                    Padding="18,0">
                    <TextBlock Text="SELECT" FontSize="12" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
