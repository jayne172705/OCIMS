<Window x:Class="eSureHi.Views.Admin.Dialogs.ClaimVerificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
         Title="File a Hospitalization Claim"
         Width="960" Height="860"
         MinWidth="900" MinHeight="750"
         WindowStartupLocation="CenterOwner"
         WindowStyle="None"
         AllowsTransparency="False"
         ResizeMode="CanResize"
         Background="#F1F5F9"
         FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <materialDesign:DialogHost Identifier="ClaimVerificationDialogHost" CloseOnClickAway="False">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <materialDesign:PackIcon Kind="FilePlusOutline" Width="18" Height="18" Foreground="#1B5E20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="File a Hospitalization Claim" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="48" Foreground="#64748B" WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
                <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="24" Margin="24">
                    <StackPanel>
                        <!-- Form Header -->
                        <TextBlock Text="File a Hospitalization Claim" FontSize="18" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,20"/>

                        <!-- Card Headers -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Assigned Group Card -->
                            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="AccountGroupOutline" Width="28" Height="28" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="ASSIGNED GROUP" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding SelectedEmployee.EmploymentType}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Available Fund Card -->
                            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="WalletOutline" Width="28" Height="28" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="AVAILABLE FUND" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                        <TextBlock Text="{Binding AvailableFundBalance, StringFormat='₱{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Applicant Info Header -->
                        <TextBlock Text="Applicant Info" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,10,0,10"/>

                        <!-- Applicant Info Fields Grid -->
                        <Grid Margin="0,0,0,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="12"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: Labels & Inputs -->
                            <!-- Applicant Name -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Applicant Name" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding ApplicantName, Mode=OneWay}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         IsReadOnly="True" Focusable="False" Height="42"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="13" Background="#F8FAFC"/>
                            </StackPanel>

                            <!-- Household Head -->
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Household Head" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SelectedEmployee.FullName, Mode=OneWay}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         IsReadOnly="True" Focusable="False" Height="42"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="13" Background="#F8FAFC"/>
                            </StackPanel>

                            <!-- Family Role -->
                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <TextBlock Text="Family Role" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FamilyRole, Mode=OneWay}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         IsReadOnly="True" Focusable="False" Height="42"
                                         Padding="12,0" VerticalContentAlignment="Center" FontSize="13" Background="#F8FAFC"/>
                            </StackPanel>

                            <!-- Row 2: Admission Date, Discharge Date, Hospital -->
                            <!-- Admission Date -->
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Admission Date" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding AdmissionDate}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            Height="42" Padding="12,0" VerticalContentAlignment="Center" FontSize="13"/>
                            </StackPanel>

                            <!-- Discharge Date -->
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Discharge Date" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <DatePicker SelectedDate="{Binding DischargeDate}"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            Height="42" Padding="12,0" VerticalContentAlignment="Center" FontSize="13"/>
                            </StackPanel>

                            <!-- Hospital Dropdown -->
                            <StackPanel Grid.Row="2" Grid.Column="4">
                                <TextBlock Text="Hospital" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding Hospitals}"
                                          SelectedItem="{Binding HospitalClinic}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Height="42" Padding="12,0" VerticalContentAlignment="Center" FontSize="13"/>
                            </StackPanel>
                        </Grid>

                        <!-- Claim Breakdown Header -->
                        <TextBlock Text="Claim Breakdown" FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,12,0,10"/>

                        <!-- Claim Breakdown Table -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Background="White" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Table Header -->
                                <Border Grid.Row="0" Grid.Column="0" Background="#F8FAFC" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                    <TextBlock Text="Type" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="1" Background="#F8FAFC" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                    <TextBlock Text="Requested Amount" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                                <Border Grid.Row="0" Grid.Column="2" Background="#F8FAFC" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="Final Covered Amount" FontSize="12" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>

                                <!-- Row 1: Excess Bill -->
                                <Border Grid.Row="1" Grid.Column="0" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                    <TextBlock Text="Total Excess Bill (Cap ₱20,000.00)" VerticalAlignment="Center" FontSize="13" Foreground="#0F172A"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Padding="12,4" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                    <TextBox Text="{Binding ExcessBillAmount, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Height="36" Padding="8,4" VerticalContentAlignment="Center" FontSize="13"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="2" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding ExcessBillCovered, StringFormat='₱{0:N2}'}" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="#0F172A"/>
                                </Border>

                                <!-- Row 2: Daily Allowance -->
                                <Border Grid.Row="2" Grid.Column="0" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                    <TextBlock Text="Daily Allowance (₱750.00/day, Max 5 days)" VerticalAlignment="Center" FontSize="13" Foreground="#0F172A"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Padding="12,4" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                    <TextBox Text="Auto-calculated from dates" IsEnabled="False"
                                             Focusable="False" IsHitTestVisible="False"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Background="#F1F5F9" Foreground="#94A3B8"
                                             Height="36" Padding="8,4" VerticalContentAlignment="Center" FontSize="11" HorizontalContentAlignment="Center"/>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="2" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding DailyAllowanceAmount, StringFormat='₱{0:N2}'}" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="#0F172A"/>
                                </Border>

                                <!-- Row 3: Outside Diagnostics -->
                                <Border Grid.Row="3" Grid.Column="0" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                    <TextBlock Text="Outside diagnostics (50% Covered, Cap ₱20,000.00)" VerticalAlignment="Center" FontSize="13" Foreground="#0F172A"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="1" Padding="12,4" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                    <TextBox Text="{Binding OutsideDiagnosticsAmount, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Height="36" Padding="8,4" VerticalContentAlignment="Center" FontSize="13"/>
                                </Border>
                                <Border Grid.Row="3" Grid.Column="2" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                    <TextBlock Text="{Binding DiagnosticsCovered, StringFormat='₱{0:N2}'}" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" Foreground="#0F172A"/>
                                </Border>

                                <!-- Row 4: Total Covered Footer -->
                                <Border Grid.Row="4" Grid.Column="0" Padding="12,10" Background="#F8FAFC">
                                    <TextBlock Text="Total Covered" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="1" Padding="12,10" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                                    <TextBlock Text="—" HorizontalAlignment="Center" FontSize="13" Foreground="#64748B"/>
                                </Border>
                                <Border Grid.Row="4" Grid.Column="2" Padding="12,10" Background="#F8FAFC">
                                    <TextBlock Text="{Binding TotalCovered, StringFormat='₱{0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="#1B5E20"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Attachments Header -->
                        <TextBlock Margin="0,8,0,8" FontSize="14" FontWeight="Bold">
                            <Run Text="Attachments" Foreground="#0F172A"/>
                            <Run Text=" (optional)" Foreground="#94A3B8" FontWeight="Normal" FontSize="12"/>
                        </TextBlock>

                        <!-- Attachments Selectors Grid -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Column 0: Hospital Bill -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Hospital Bill (Image/PDF)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding AddHospitalBillCommand}"
                                            Content="Choose File"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#E2E8F0" Foreground="#0F172A" BorderThickness="0"
                                            Height="32" Padding="12,0"/>
                                    <TextBlock Text="{Binding HospitalBillFileName}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                </StackPanel>
                                <TextBlock Text="Max file size: 5MB" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Column 2: Official Receipt -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Official Receipt (Image/PDF)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding AddOfficialReceiptCommand}"
                                            Content="Choose File"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Background="#E2E8F0" Foreground="#0F172A" BorderThickness="0"
                                            Height="32" Padding="12,0"/>
                                    <TextBlock Text="{Binding OfficialReceiptFileName}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis" MaxWidth="250"/>
                                </StackPanel>
                                <TextBlock Text="Max file size: 5MB" FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Error Message text block -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Actions Grid -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveCommand}"
                                    Content="Submit Claim"
                                    Background="#1B5E20" Foreground="White" BorderThickness="0"
                                    FontWeight="SemiBold" FontSize="13"
                                    Height="40" Padding="20,0"
                                    HorizontalAlignment="Left"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </materialDesign:DialogHost>
</Window>
