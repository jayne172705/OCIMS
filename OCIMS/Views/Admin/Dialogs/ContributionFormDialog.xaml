<Window x:Class="eSureHi.Views.Admin.Dialogs.ContributionFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="{Binding DialogTitle}"
        Width="400" Height="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#1565C0" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="{Binding DialogTitle}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44" WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="20">
            <DatePicker SelectedDate="{Binding Date}" materialDesign:HintAssist.Hint="Date *" Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,16" FontSize="13"/>
            <TextBox Text="{Binding Amount}" materialDesign:HintAssist.Hint="Amount *" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16" FontSize="13"/>
            <TextBox Text="{Binding OrNumber}" materialDesign:HintAssist.Hint="O.R. Number" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16" FontSize="13"/>
            <TextBox Text="{Binding Remarks}" materialDesign:HintAssist.Hint="Remarks" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16" FontSize="13" TextWrapping="Wrap" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <!-- ── Footer ── -->
		<Border Grid.Row="2" BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12">
				<Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" Width="90"/>
				<Button Command="{Binding SaveCommand}" Background="{StaticResource PrimaryBrush}" Style="{StaticResource MaterialDesignRaisedButton}" Width="110">
					<StackPanel Orientation="Horizontal">
						<materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
						<TextBlock Text="Save" VerticalAlignment="Center"/>
					</StackPanel>
				</Button>
			</StackPanel>
		</Border>
    </Grid>
</Window>
