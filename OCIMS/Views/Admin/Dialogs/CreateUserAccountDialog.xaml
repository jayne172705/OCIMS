<Window x:Class="eSureHi.Views.Admin.Dialogs.CreateUserAccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Create User Account"
        Width="420" SizeToContent="Height"
        MinWidth="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#1565C0" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="AccountKey"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding DialogTitle}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <StackPanel Grid.Row="1" Margin="20,16">

            <!-- Info Card -->
            <materialDesign:Card Background="#0D47A1" helpers:Adaptive.UseAdaptiveForeground="True"
                                 materialDesign:ElevationAssist.Elevation="Dp0"
                                 Margin="0,0,0,16">
                <StackPanel Margin="12,10">
                    <TextBlock Text="Creating account for:"
                               FontSize="10" Foreground="#64748B"/>
                    <TextBlock Text="{Binding DialogTitle,
                                   StringFormat={}{0}}"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#1565C0"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Username -->
            <TextBox x:Name="UsernameBox"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Username *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,12" FontSize="13"/>

            <!-- Password -->
            <PasswordBox x:Name="PasswordBox"
                         materialDesign:HintAssist.Hint="Password * (min 6 characters)"
                         Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                         Margin="0,0,0,12" FontSize="13"/>

            <!-- Role -->
            <ComboBox ItemsSource="{Binding RoleOptions}"
                      SelectedItem="{Binding Role}"
                      materialDesign:HintAssist.Hint="Role"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,4" FontSize="13"/>

            <!-- Role hint -->
            <TextBlock FontSize="11"
                       TextWrapping="Wrap" Margin="0,4,0,0">
                <Run Text="Super Admin"/>
                <Run Text=" - full access. "/>
                <Run Text="Admin"/>
                <Run Text=" - confirms pending records. "/>
                <Run Text="User"/>
                <Run Text=" - submits records for approval."/>
            </TextBlock>

        </StackPanel>

        <!-- ── Footer ── -->
        <Border Grid.Row="2"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" Width="90"/>
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy,
                                Converter={StaticResource InverseBoolConverter}}"
                            Background="{StaticResource PrimaryBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="150">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlus"
                                                     Width="16" Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Create Account"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

