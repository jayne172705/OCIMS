<Window x:Class="eSureHi.Views.Admin.Dialogs.DocumentFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Document"
        Width="700" Height="580"
        MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="FileUpload"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding DialogTitle}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Employee Picker -->
            <Border Grid.Column="0"
                    BorderBrush="#DDE4EF" BorderThickness="1"
                    CornerRadius="4" Background="White" helpers:Adaptive.UseAdaptiveForeground="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,10"
                            BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Select Employee *"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding EmployeeSearch,
                                         UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search name or employee no..."
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Height="50" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding FilteredEmployees}"
                             SelectedItem="{Binding SelectedEmployee}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock Text="{Binding FullName}"
                                               FontSize="13" FontWeight="Medium"/>
                                    <TextBlock FontSize="11">
                                        <Run Text="{Binding EmployeeNo}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Department.DeptName}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: Document Details -->
            <StackPanel Grid.Column="2">

                <!-- Document Type -->
                <ComboBox ItemsSource="{Binding DocumentTypes}"
                          SelectedItem="{Binding SelectedDocType}"
                          DisplayMemberPath="TypeName"
                          materialDesign:HintAssist.Hint="Document Type *"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Margin="0,0,0,12" FontSize="13"/>

                <!-- Document Title -->
                <TextBox Text="{Binding DocTitle, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Document Title *"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Margin="0,0,0,12" FontSize="13"/>

                <!-- File Picker -->
                <Border BorderBrush="#DDE4EF" BorderThickness="1"
                        CornerRadius="4" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="File (optional)"
                                   FontSize="11"
                                   Margin="0,0,0,8"/>

                        <!-- No file selected -->
                        <StackPanel Visibility="{Binding HasFile,
                                        Converter={StaticResource BoolToVisibilityConverter},
                                        ConverterParameter=Invert}">
                            <Button Command="{Binding BrowseFileCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    BorderBrush="{StaticResource PrimaryBrush}"
                                    HorizontalAlignment="Stretch"
                                    Height="36">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpen"
                                                             Width="16" Height="16"
                                                             Margin="0,0,8,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Browse File"
                                               VerticalAlignment="Center"
                                               FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- File selected -->
                        <StackPanel Visibility="{Binding HasFile,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="FileCheck"
                                                         Width="20" Height="20"
                                                         Foreground="{StaticResource SuccessBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}"
                                               FontSize="12" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FileSize}"
                                               FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Command="{Binding ClearFileCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{StaticResource ErrorBrush}"
                                    HorizontalAlignment="Left"
                                    Height="28" FontSize="11">
                                <TextBlock Text="Remove File"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Remarks -->
                <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Remarks (optional)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         Height="90" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="13"/>

                <!-- Employee Preview -->
                <materialDesign:Card Margin="0,12,0,0" Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True"
                                     materialDesign:ElevationAssist.Elevation="Dp0"
                                     Visibility="{Binding HasEmployee,
                                         Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="12,10">
                        <TextBlock Text="Uploading for:"
                                   FontSize="10" Foreground="#64748B"/>
                        <TextBlock Text="{Binding SelectedEmployee.FullName}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="#2E7D32"/>
                        <TextBlock Text="{Binding SelectedEmployee.EmployeeNo}"
                                   FontSize="11" Foreground="#64748B"/>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </Grid>

        <!-- ── Footer ── -->
        <Border Grid.Row="2"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" Width="90"/>
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy,
                                Converter={StaticResource InverseBoolConverter}}"
                            Background="{StaticResource PrimaryBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="160">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileUpload"
                                                     Width="16" Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Save Document"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
