<Window x:Class="eSureHi.Views.Admin.Dialogs.EmployeeFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Employee"
        Width="720" Height="680"
        MinWidth="680" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="AccountPlus"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding DialogTitle}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Tab Content ── -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource MaterialDesignTabControl}"
                    Margin="16,6,16,0">

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- TAB 1 — Personal                                         -->
            <!-- ════════════════════════════════════════════════════════ -->
            <TabItem Header="Personal">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="4,8,4,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Form Fields -->
                        <StackPanel Grid.Column="0">

                            <!-- Household/Resident ID + Employment Type -->
                            <Grid Margin="0,24,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding EmployeeNo, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Household/Resident ID *"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             FontSize="13"/>
                                    <Button Grid.Column="2"
                                            Command="{Binding SelectCrsRecordCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Padding="0"
                                            ToolTip="Select from CRS"
                                            BorderBrush="{StaticResource PrimaryBrush}"
                                            Foreground="{StaticResource PrimaryBrush}">
                                        <materialDesign:PackIcon Kind="AccountSearch"
                                                                 Width="18" Height="18"
                                                                 HorizontalAlignment="Center"/>
                                    </Button>
                                </Grid>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding EmploymentTypes}"
                                          SelectedItem="{Binding EmploymentType}"
                                          materialDesign:HintAssist.Hint="Employment Type *"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          FontSize="13"/>
                            </Grid>

                            <TextBox Text="{Binding MonthlyContribution, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                     materialDesign:HintAssist.Hint="Monthly Contribution *"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,0,12" FontSize="13"/>

                            <!-- Name Row -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="First Name *"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="13"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding MiddleName, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Middle Name"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="13"/>
                                <TextBox Grid.Column="4"
                                         Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Last Name *"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="13"/>
                                <TextBox Grid.Column="6"
                                         Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Suffix"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="13"/>
                            </Grid>

                            <!-- DOB + Gender -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0"
                                            SelectedDate="{Binding DateOfBirth}"
                                            materialDesign:HintAssist.Hint="Date of Birth *"
                                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                            FontSize="13"/>
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding GenderOptions}"
                                          SelectedItem="{Binding Gender}"
                                          materialDesign:HintAssist.Hint="Gender"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          FontSize="13"/>
                            </Grid>

                            <!-- Civil Status + Nationality -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding CivilStatusOptions}"
                                          SelectedItem="{Binding CivilStatus}"
                                          materialDesign:HintAssist.Hint="Civil Status"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          FontSize="13"/>
                                <TextBox Grid.Column="2"
                                         Text="{Binding Nationality, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="Nationality"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         FontSize="13"/>
                            </Grid>

                        </StackPanel>

                        <!-- Right: Photo Upload -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Photo" FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>

                            <!-- Photo Preview -->
                            <Border Width="130" Height="150"
                                    CornerRadius="6"
                                    BorderBrush="#DDE4EF"
                                    BorderThickness="1"
                                    ClipToBounds="True">
                                <Grid>
                                    <!-- Placeholder when no photo -->
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Visibility="{Binding HasPhoto,
                                                    Converter={StaticResource BoolToVisibilityConverter},
                                                    ConverterParameter=Invert}">
                                        <materialDesign:PackIcon Kind="AccountCircle"
                                                                 Width="60" Height="60"
                                                                 HorizontalAlignment="Center"/>
                                        <TextBlock Text="No photo"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Actual photo -->
                                    <Image Source="{Binding PhotoPath,
                                               Converter={StaticResource PathToImageConverter}}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding HasPhoto,
                                               Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </Grid>
                            </Border>

                            <!-- Browse Button -->
                            <Button Command="{Binding BrowsePhotoCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    BorderBrush="{StaticResource PrimaryBrush}"
                                    Width="130" Height="32"
                                    Margin="0,8,0,4" FontSize="11">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Upload"
                                                             Width="14" Height="14"
                                                             Margin="0,0,6,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Browse" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Clear Button -->
                            <Button Command="{Binding ClearPhotoCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Width="130" Height="28" FontSize="11"
                                    Visibility="{Binding HasPhoto,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Remove Photo"/>
                            </Button>

                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- TAB 2 — Contact                                          -->
            <!-- ════════════════════════════════════════════════════════ -->
            <TabItem Header="Contact">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel>

                        <!-- Email -->
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Email Address *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,24,0,12" FontSize="13"/>

                        <!-- Phone -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding PhoneMobile, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Mobile Phone"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="13"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding PhoneOffice, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Office Phone"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="13"/>
                        </Grid>

                        <!-- Address -->
                        <TextBox Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Address Line 1"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" FontSize="13"/>

                        <TextBox Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Address Line 2"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" FontSize="13"/>

                        <!-- City + Barangay + Province + ZIP -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="City"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="13"/>
                            <TextBox Grid.Column="2"
                                     Text="{Binding Barangay, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Barangay"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="13"/>
                            <TextBox Grid.Column="4"
                                     Text="{Binding Province, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Province"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="13"/>
                            <TextBox Grid.Column="6"
                                     Text="{Binding ZipCode, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="ZIP Code"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     FontSize="13"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════════════════════════════════════════════════════ -->
            <!-- TAB 3 — Employment                                       -->
            <!-- ════════════════════════════════════════════════════════ -->
            <TabItem Header="Employment">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel>

                        <!-- Department -->
                        <ComboBox ItemsSource="{Binding Departments}"
                                  SelectedItem="{Binding SelectedDepartment}"
                                  DisplayMemberPath="DeptName"
                                  materialDesign:HintAssist.Hint="Department"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,12,0,12" FontSize="13"/>

                        <!-- Position Title -->
                        <TextBox Text="{Binding PositionTitle, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Position / Job Title"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" FontSize="13"/>

                        <!-- Employment Type + Status -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding EmploymentTypes}"
                                      SelectedItem="{Binding EmploymentType}"
                                      materialDesign:HintAssist.Hint="Employment Type"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="13"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding EmploymentStatus}"
                                      materialDesign:HintAssist.Hint="Employment Status"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="13"/>
                        </Grid>

                        <TextBox Text="{Binding MonthlyContribution, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                 materialDesign:HintAssist.Hint="Monthly Contribution *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" FontSize="13"/>

                        <!-- Date Hired + Date Separated -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding DateHired}"
                                        materialDesign:HintAssist.Hint="Date Hired *"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        FontSize="13"/>
                            <DatePicker Grid.Column="2"
                                        SelectedDate="{Binding DateSeparated}"
                                        materialDesign:HintAssist.Hint="Date Separated (if any)"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        FontSize="13"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4 — Beneficiaries -->
            <TabItem Header="Beneficiaries">
                <Grid Margin="4,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding AddBeneficiaryCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource PrimaryBrush}"
                                Height="32" Padding="8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Add Beneficiary" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteBeneficiaryCommand}" 
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource ErrorBrush}"
                                Height="32" Padding="8,0" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Remove" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Beneficiaries}" 
                              SelectedItem="{Binding SelectedBeneficiary}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              Style="{StaticResource ReadableDataGrid}"
                              Background="White" BorderThickness="1" BorderBrush="#DDE4EF">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Relationship" Binding="{Binding Relationship}" Width="100"/>
                            <DataGridTextColumn Header="Insurance" Binding="{Binding RecipientsInsurance}" Width="120"/>
                            <DataGridTextColumn Header="Cedula No" Binding="{Binding CedulaNo}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Received" Binding="{Binding Received}" Width="80"/>
                            <DataGridTextColumn Header="Contribution" Binding="{Binding Contribution, StringFormat=N2}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- ── Footer ── -->
        <Border Grid.Row="2"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Grid>
                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" Width="90"/>
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy,
                                Converter={StaticResource InverseBoolConverter}}"
                            Background="{StaticResource PrimaryBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="150">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"
                                                     Width="16" Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Save Employee" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
