<Window x:Class="eSureHi.Views.Admin.Dialogs.EmployeeSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Employee Summary"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#1565C0" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="AccountDetails" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Employee Summary" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CloseCommand}" Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44" WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- Summary Header -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE4EF" BorderThickness="0,0,0,1" Padding="20"
                helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <materialDesign:PackIcon Grid.Column="0" Kind="AccountCircle" Width="64" Height="64" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,16,0"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FullName}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Position}" FontSize="14" Foreground="#64748B" Margin="0,2,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding EmployeeNo}" FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="Medium"/>
                        <TextBlock Text=" • " FontSize="12"/>
                        <TextBlock Text="{Binding Department}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Details TabControl -->
        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignTabControl}" Margin="16,10,16,0">

            <!-- Tab 1: Policies (Primary for an insurance system) -->
            <TabItem Header="Assigned Policies">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="List of active and historical insurance policies assigned to this employee." 
                               Foreground="#64748B" FontSize="11" Margin="4,8"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding AssignedPolicies}" 
                              AutoGenerateColumns="False" IsReadOnly="True" 
                              SelectionMode="Single" 
                              Style="{StaticResource ReadableDataGrid}"
                              Background="White" RowBackground="White" 
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Policy Name" Binding="{Binding Policy.PolicyName}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat={}{0:MMM dd, yyyy}}" Width="110"/>
                            <DataGridTextColumn Header="Limit" Binding="{Binding CoverageLimit, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="Emp Share" Binding="{Binding EmployeeShare, StringFormat=N2}" Width="100"/>
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" Background="#0D47A1" helpers:Adaptive.UseAdaptiveForeground="True" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding AssignmentStatus}" FontSize="10" Foreground="#64748B" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 2: Contributions -->
            <TabItem Header="Contributions">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,8">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontSize="14" FontWeight="SemiBold">
                            <Run Text="Total: ₱"/>
                            <Run Text="{Binding TotalContributions, StringFormat=N2}"/>
                        </TextBlock>
                        <Button Command="{Binding AddContributionCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource PrimaryBrush}" Height="30" Padding="12,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Add Contribution" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EditContributionCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource PrimaryBrush}" Height="30" Padding="12,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Edit" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteContributionCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{StaticResource ErrorBrush}" BorderBrush="{StaticResource ErrorBrush}" Height="30" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Delete" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Contributions}" SelectedItem="{Binding SelectedContribution}" 
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" 
                              Style="{StaticResource ReadableDataGrid}" 
                              Background="White" RowBackground="White" 
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="O.R. Number" Binding="{Binding OrNumber}" Width="150"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=N2}" Width="150"/>
                            <DataGridTextColumn Header="Remarks" Binding="{Binding Remarks}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 3: Training -->
            <TabItem Header="Trainings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Toolbar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,8">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" FontSize="14" FontWeight="SemiBold">
                            <Run Text="Total Trainings: "/>
                            <Run Text="{Binding TotalTrainings}"/>
                        </TextBlock>
                        <Button Command="{Binding AddTrainingCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="{StaticResource PrimaryBrush}" Height="30" Padding="12,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Add Training" FontSize="12"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteTrainingCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{StaticResource ErrorBrush}" BorderBrush="{StaticResource ErrorBrush}" Height="30" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="Delete" FontSize="12"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Trainings}" SelectedItem="{Binding SelectedTraining}" 
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" 
                              Style="{StaticResource ReadableDataGrid}" 
                              Background="White" RowBackground="White" 
                              AlternatingRowBackground="#F8FAFC"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateAttended, StringFormat={}{0:MMM dd, yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationHours, StringFormat={}{0} hrs}" Width="80"/>
                            <DataGridTextColumn Header="Instructor/Venue" Binding="{Binding InstructorOrVenue}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
