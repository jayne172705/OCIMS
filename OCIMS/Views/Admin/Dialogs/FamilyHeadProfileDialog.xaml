<Window x:Class="eSureHi.Views.Admin.Dialogs.FamilyHeadProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Family Head Profile"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource PrimaryBrush}" helpers:Adaptive.UseAdaptiveForeground="True" Padding="20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource MaterialDesignToolButton}" Command="{Binding CloseCommand}" Foreground="White" Margin="0,0,10,0">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                </Button>
                <materialDesign:PackIcon Kind="Account" Width="32" Height="32" Margin="0,0,12,0" Foreground="White"/>
                <StackPanel>
                    <TextBlock Text="{Binding Head.FullName}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{Binding Head.EmploymentType}" FontSize="14" Opacity="0.9" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10" Style="{StaticResource MaterialDesignFilledTabControl}">
            <TabItem Header="Personal Info">
                <ScrollViewer Margin="20">
                    <StackPanel>
                        <TextBlock Text="Personal Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="First Name:" FontWeight="SemiBold" Grid.Row="0" Grid.Column="0"/>
                            <TextBlock Text="{Binding Head.FirstName}" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Text="Last Name:" FontWeight="SemiBold" Grid.Row="1" Grid.Column="0"/>
                            <TextBlock Text="{Binding Head.LastName}" Grid.Row="1" Grid.Column="1"/>

                            <TextBlock Text="Gender:" FontWeight="SemiBold" Grid.Row="2" Grid.Column="0"/>
                            <TextBlock Text="{Binding Head.Gender}" Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Text="Civil Status:" FontWeight="SemiBold" Grid.Row="3" Grid.Column="0"/>
                            <TextBlock Text="{Binding Head.CivilStatus}" Grid.Row="3" Grid.Column="1"/>

                            <TextBlock Text="Barangay:" FontWeight="SemiBold" Grid.Row="4" Grid.Column="0"/>
                            <TextBlock Text="{Binding Head.Barangay}" Grid.Row="4" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Dependents">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Dependents List" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Dependents}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Relationship" Binding="{Binding Relationship}" Width="150"/>
                            <DataGridTextColumn Header="Date of Birth" Binding="{Binding DateOfBirth, StringFormat=d}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Transaction History">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Consolidated Transactions" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Transactions}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="120"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=₱{0:N2}}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
