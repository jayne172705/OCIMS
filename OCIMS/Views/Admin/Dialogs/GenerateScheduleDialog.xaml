<Window x:Class="eSureHi.Views.Admin.Dialogs.GenerateScheduleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Generate Premium Schedule"
        Width="720" Height="620"
        MinWidth="640" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#1565C0" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="CalendarMultiple"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Generate Premium Schedule"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Loading Bar ── -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                     Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsLoading,
                         Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ── Date Range Picker ── -->
        <materialDesign:Card Grid.Row="2"
                             Margin="16,12,16,0"
                             materialDesign:ElevationAssist.Elevation="Dp1">
            <Grid Margin="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DatePicker Grid.Column="0"
                            SelectedDate="{Binding FromMonth}"
                            materialDesign:HintAssist.Hint="From Month"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            FontSize="13"/>

                <TextBlock Grid.Column="1" Text="to"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" FontSize="13"/>

                <DatePicker Grid.Column="2"
                            SelectedDate="{Binding ToMonth}"
                            materialDesign:HintAssist.Hint="To Month"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                            FontSize="13"/>

                <Button Grid.Column="4"
                        Command="{Binding GenerateCommand}"
                        IsEnabled="{Binding IsBusy,
                            Converter={StaticResource InverseBoolConverter}}"
                        Background="{StaticResource SuccessBrush}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="40" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CalendarCheck"
                                                 Width="16" Height="16"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Generate" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </materialDesign:Card>

        <!-- ── Summary Cards ── -->
        <UniformGrid Grid.Row="3" Columns="3" Margin="16,8,16,0">
            <materialDesign:Card Margin="0,0,4,0"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel Margin="16,12" HorizontalAlignment="Center">
                    <TextBlock Text="New Records"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding NewCount}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Margin="4,0,4,0"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel Margin="16,12" HorizontalAlignment="Center">
                    <TextBlock Text="Already Exists"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SkipCount}"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Margin="4,0,0,0"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel Margin="16,12" HorizontalAlignment="Center">
                    <TextBlock Text="Total Amount"
                               FontSize="11"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat=₱{0:N0}}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <!-- ── Preview Grid ── -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding PreviewItems}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E5EAF2"
                  RowHeight="40"
                  BorderThickness="0"
                  Background="White"
                  Margin="16,8,16,0"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
                  Style="{StaticResource ReadableDataGrid}">
            <DataGrid.Columns>

                <DataGridTextColumn Header="Employee"
                                    Binding="{Binding EmployeeName}"
                                    Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,0"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Policy"
                                    Binding="{Binding PolicyName}"
                                    Width="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Billing Month"
                                    Binding="{Binding BillingMonth}"
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Employee Share"
                                    Binding="{Binding EmployeeAmount,
                                        StringFormat=₱{0:N2}}"
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Employer Share"
                                    Binding="{Binding EmployerAmount,
                                        StringFormat=₱{0:N2}}"
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Total"
                                    Binding="{Binding TotalAmount,
                                        StringFormat=₱{0:N2}}"
                                    Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,0"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="Foreground" Value="#2E7D32"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Status -->
                <DataGridTemplateColumn Header="Status" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="8,2"
                                    HorizontalAlignment="Left"
                                    Margin="12,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AlreadyExists}"
                                                         Value="True">
                                                <Setter Property="Background" Value="#FFF3E0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10" FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="New"/>
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding AlreadyExists}"
                                                             Value="True">
                                                    <Setter Property="Text" Value="Skip"/>
                                                    <Setter Property="Foreground"
                                                            Value="#E65100"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Footer ── -->
        <Border Grid.Row="5"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="12"
                               Visibility="{Binding ErrorMessage,
                                   Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource SuccessBrush}"
                               FontSize="12"
                               Visibility="{Binding StatusMessage,
                                   Converter={StaticResource StringToVisibilityConverter}}"/>
                </StackPanel>
                <Button Content="Close"
                        Command="{Binding CancelCommand}"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Width="90"/>
            </Grid>
        </Border>

    </Grid>
</Window>
