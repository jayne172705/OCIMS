<Window x:Class="eSureHi.Views.Admin.Dialogs.MemberEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Update Member"
        Width="700" Height="640"
        MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#2E7D32" Padding="24,18" helpers:Adaptive.UseAdaptiveForeground="True">
            <StackPanel>
                <TextBlock Text="Update Member" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Update insurance-member information. CRS identity details are managed separately."
                           FontSize="12" Opacity="0.9" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="24,20,24,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                    <TextBlock Text="CRS identity information is managed only in CRS and cannot be changed from eSureHi."
                               Foreground="#1E40AF" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding RelationshipOptions}" SelectedItem="{Binding Relationship}"
                              materialDesign:HintAssist.Hint="Relationship"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                    <TextBox Grid.Column="2" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Email"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding RecipientsInsurance, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Recipient's insurance"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    <TextBox Grid.Column="2" Text="{Binding SourceOfFunds, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Source of funds"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ContributionText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Contribution (PHP)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    <TextBox Grid.Column="2" Text="{Binding CedulaNo, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Cedula number"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                </Grid>

                <WrapPanel>
                    <CheckBox Content="Primary member" IsChecked="{Binding IsPrimary}" Margin="0,0,24,0"/>
                    <CheckBox Content="Active member" IsChecked="{Binding IsMemberActive}" Margin="0,0,24,0"/>
                    <CheckBox Content="Benefit received" IsChecked="{Binding Received}"/>
                </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Width="96"/>
                    <Button Click="Save_Click" Background="#2E7D32" Foreground="White" Style="{StaticResource MaterialDesignRaisedButton}" Width="118">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,7,0"/>
                            <TextBlock Text="Save changes"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
