<Window x:Class="eSureHi.Views.Admin.Dialogs.PolicyFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Policy"
        Width="640" Height="580"
        MinWidth="580" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="ShieldStar"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding DialogTitle}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource MaterialDesignTabControl}"
                    Margin="16,12,16,0">

            <!-- ================================================== -->
            <!-- TAB 1 — Policy Info                                  -->
            <!-- ================================================== -->
            <TabItem Header="Policy Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel>

                        <!-- Policy Code (read-only) -->
                        <TextBox Text="{Binding PolicyCode}"
                                 IsReadOnly="True"
                                 materialDesign:HintAssist.Hint="Policy Code (auto-generated)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Background="#F8FAFC"
                                 Margin="0,12,0,12" FontSize="13"/>

                        <!-- Policy Name -->
                        <TextBox Text="{Binding PolicyName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Employee Track Name *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" FontSize="13"/>

                        <!-- Type + Status -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding PolicyTypes}"
                                      Text="{Binding PolicyType, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      materialDesign:HintAssist.Hint="Employment Type *"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="13"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding PolicyStatus}"
                                      materialDesign:HintAssist.Hint="Status"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="13"/>
                        </Grid>

                        <!-- Coverage Amount -->
                        <TextBox Text="{Binding CoverageAmount, UpdateSourceTrigger=PropertyChanged,
                                     StringFormat={}{0:N2}}"
                                 materialDesign:HintAssist.Hint="Budget Allocation (PHP)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" FontSize="13"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================== -->
            <!-- TAB 2 — Provider & Dates                             -->
            <!-- ================================================== -->
            <TabItem Header="Provider &amp; Dates">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel>

                        <!-- Provider Name -->
                        <TextBox Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Funding Office / Program Owner"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,12,0,12" FontSize="13"/>

                        <!-- Provider Contact -->
                        <TextBox Text="{Binding ProviderContact, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Office Contact (phone / email)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" FontSize="13"/>

                        <!-- Effective + Expiry -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding EffectiveDate}"
                                        materialDesign:HintAssist.Hint="Effective Date *"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        FontSize="13"/>
                            <DatePicker Grid.Column="2"
                                        SelectedDate="{Binding ExpiryDate}"
                                        materialDesign:HintAssist.Hint="Expiry Date"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        FontSize="13"/>
                        </Grid>

                        <!-- Renewal Date -->
                        <DatePicker SelectedDate="{Binding RenewalDate}"
                                    materialDesign:HintAssist.Hint="Budget Review Date"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    Margin="0,0,0,12" FontSize="13"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================== -->
            <!-- TAB 3 — Details                                      -->
            <!-- ================================================== -->
            <TabItem Header="Details">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel>

                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Description"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="120" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Margin="0,12,0,12" FontSize="13"/>

                        <TextBox Text="{Binding TermsConditions, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Eligibility / Fund Request Notes"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="160" VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 FontSize="13"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" Width="90"/>
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy,
                                Converter={StaticResource InverseBoolConverter}}"
                            Background="{StaticResource PrimaryBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="130">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"
                                                     Width="16" Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Save Track" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
