<UserControl x:Class="eSureHi.Views.Admin.Dialogs.QRScannerDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="White"
             Width="500" Height="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Background="#2E7D32" Padding="15">
            <TextBlock Text="Scan Beneficiary QR Code" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
        </Border>
        
        <Border Grid.Row="1" Background="Black" Margin="15">
            <Grid>
                <Image x:Name="CameraPreview" Stretch="Uniform"/>
                <TextBlock x:Name="NoCameraText" Text="No camera detected" Foreground="White" FontSize="16"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="15">
            <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource MaterialDesignOutlinedButton}" Click="CancelBtn_Click" Width="120" Height="40"/>
        </StackPanel>
    </Grid>
</UserControl>
