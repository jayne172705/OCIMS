<Window x:Class="eSureHi.Views.Admin.Dialogs.RecordPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Record Payment"
        Width="420" SizeToContent="Height"
        MinWidth="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="CashCheck"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Record Payment"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <StackPanel Grid.Row="1" Margin="20,16">

            <!-- Summary Card -->
            <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1"
                     Margin="0,0,0,16" Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True">
                <Grid Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Total Due" FontSize="10"
                       Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalAmount, Mode=OneWay, StringFormat=₱{0:N2}}"
                       FontSize="14" FontWeight="Bold"
                       Foreground="#2E7D32"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Already Paid" FontSize="10"
                       Foreground="#64748B"/>
                        <TextBlock Text="{Binding AlreadyPaid, Mode=OneWay, StringFormat=₱{0:N2}}"
                       FontSize="14" FontWeight="Bold"
                       Foreground="#81C784"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Balance" FontSize="10"
                       Foreground="#64748B"/>
                        <TextBlock Text="{Binding Balance, Mode=OneWay, StringFormat=₱{0:N2}}"
                       FontSize="14" FontWeight="Bold"
                       Foreground="#EF9A9A"/>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- Employee + Policy info -->
            <TextBlock FontSize="13"
           Margin="0,0,0,2">
    <Run Text="{Binding EmployeeName, Mode=OneWay}" FontWeight="Bold"/>
    <Run Text=" · "/>
    <Run Text="{Binding PolicyName, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Text="{Binding BillingMonth, Mode=OneWay}"
           FontSize="12"
           Margin="0,0,0,16"/>

            <!-- Amount Paid -->
            <TextBox Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged,
                         StringFormat={}{0:N2}}"
                     materialDesign:HintAssist.Hint="Amount Being Paid (₱) *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,12" FontSize="13"/>

            <!-- Payment Mode -->
            <ComboBox ItemsSource="{Binding PaymentModes}"
                      SelectedItem="{Binding PaymentMode}"
                      materialDesign:HintAssist.Hint="Payment Mode"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,12" FontSize="13"/>

            <!-- Paid Date -->
            <DatePicker SelectedDate="{Binding PaidDate}"
                        materialDesign:HintAssist.Hint="Payment Date *"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,0,12" FontSize="13"/>

            <!-- Reference No -->
            <TextBox Text="{Binding ReferenceNo, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Reference No (optional)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,12" FontSize="13"/>

            <!-- Late Fee -->
            <TextBox Text="{Binding LateFee, UpdateSourceTrigger=PropertyChanged,
                         StringFormat={}{0:N2}}"
                     materialDesign:HintAssist.Hint="Late Fee (₱) — leave 0 if none"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,12" FontSize="13"/>

            <!-- Remarks -->
            <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Remarks (optional)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     Height="70" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="13"/>

        </StackPanel>

        <!-- ── Footer ── -->
        <Border Grid.Row="2"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" Width="90"/>
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy,
                                Converter={StaticResource InverseBoolConverter}}"
                            Background="{StaticResource SuccessBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="160">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashCheck"
                                                     Width="16" Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Record Payment"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
