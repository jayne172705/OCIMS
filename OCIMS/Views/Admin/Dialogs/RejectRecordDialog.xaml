<UserControl x:Class="eSureHi.Views.Admin.Dialogs.RejectRecordDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             MaxWidth="440" Width="440">

    <Border Background="White" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" Padding="20,16" Background="#B91C1C">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CloseCircleOutline" Width="24" Height="24"
                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Reject Distribution Record" FontSize="17" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="{Binding BeneficiaryName}" FontSize="12" Foreground="#FECACA" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="20,18">
                <TextBlock Text="This beneficiary will be moved out of On Hold Pending and into Rejected."
                           FontSize="12" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock Text="Reason for rejection" FontSize="11" FontWeight="SemiBold"
                           Foreground="#64748B" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="e.g. Family member already claimed"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="80" VerticalContentAlignment="Top"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
            </StackPanel>

            <!-- Actions -->
            <Border Grid.Row="2" Padding="16,12" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            CommandParameter="{x:Null}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,8,0"/>
                    <Button Content="CONFIRM REJECT"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            CommandParameter="Reject"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#B91C1C" BorderBrush="#B91C1C" Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
