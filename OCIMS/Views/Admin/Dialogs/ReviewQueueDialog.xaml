<Window x:Class="eSureHi.Views.Admin.Dialogs.ReviewQueueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Review Queue — Select Record"
        Width="900"
        Height="650"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">
    
    <Window.Resources>
        <ResourceDictionary>
            <Style x:Key="QueueRowStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,2"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,10">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E0F2FE"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Group Header Style -->
            <Style x:Key="StatusGroupHeaderStyle" TargetType="GroupItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupItem">
                            <StackPanel>
                                <Border Background="#F1F5F9" Padding="16,6" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Name}" 
                                               FontSize="13" 
                                               FontWeight="Bold" 
                                               Foreground="#334155"/>
                                </Border>
                                <ItemsPresenter />
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.15" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="White" Padding="20,16" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Review Queue — Select Record"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Manage and process insurance workflow records"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Padding="0"
                            Width="32" Height="32"
                            Command="{Binding CloseCommand}">
                        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="#64748B"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Filters -->
            <Border Grid.Row="1" Background="White" Padding="20,12" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" MinWidth="150"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*" MinWidth="130"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.6*" MinWidth="200"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Queue Type" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding QueueTypes}"
                                  SelectedItem="{Binding SelectedQueueType}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Queue Type"
                                  Height="46"
                                  FontSize="13"
                                  Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Status" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Statuses}"
                                  SelectedItem="{Binding SelectedStatus}"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  materialDesign:HintAssist.Hint="Status"
                                  Height="46"
                                  FontSize="13"
                                  Padding="10,8"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Search Record" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,5"/>
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Name or Reference #"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Height="46"
                                     FontSize="13"
                                     Padding="36,8,12,8"/>
                            <materialDesign:PackIcon Kind="Search"
                                                     Width="18" Height="18"
                                                     Foreground="#94A3B8"
                                                     VerticalAlignment="Center"
                                                     Margin="12,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <Button Grid.Column="6"
                            Command="{Binding RefreshCommand}"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="46"
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Content List -->
            <Grid Grid.Row="2">
                <ProgressBar IsIndeterminate="True" 
                             VerticalAlignment="Top"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                             Panel.ZIndex="1"/>
                
                <ListBox ItemsSource="{Binding FilteredItems}"
                         ItemContainerStyle="{StaticResource QueueRowStyle}"
                         SelectedItem="{Binding SelectedItem}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle ContainerStyle="{StaticResource StatusGroupHeaderStyle}"/>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ReferenceNo}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Text="{Binding DateDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding Type}" FontSize="13" FontWeight="SemiBold" Foreground="#334155"/>
                                </StackPanel>

                                <Border Grid.Column="2" 
                                        HorizontalAlignment="Left" 
                                        VerticalAlignment="Center"
                                        Padding="9,3" 
                                        CornerRadius="4"
                                        Background="#F8FAFC"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding Type}" 
                                               FontSize="12" 
                                               FontWeight="SemiBold" 
                                               Foreground="#334155"/>
                                </Border>

                                <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Padding="11,5" CornerRadius="12" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1">
                                        <TextBlock Text="{Binding Status}" 
                                                   FontSize="12" 
                                                   FontWeight="Bold" 
                                                   Foreground="{Binding StatusColor}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding FilteredItems.Count, Converter={StaticResource ComparisonConverter}, ConverterParameter='0'}">
                    <materialDesign:PackIcon Kind="InboxOutline" Width="64" Height="64" Foreground="#E2E8F0"/>
                    <TextBlock Text="No records found" FontSize="16" FontWeight="Bold" Foreground="#475569" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="3" Background="#F8FAFC" Padding="20,16" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid>
                    <Button Command="{Binding ShowAllCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            HorizontalAlignment="Left"
                            Padding="12,0">
                            <TextBlock Text="SHOW ALL" FontSize="13" FontWeight="Bold"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CloseCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#334155"
                                BorderBrush="#CBD5E1"
                                Height="38"
                                Padding="20,0"
                                Margin="0,0,12,0">
                            <TextBlock Text="CLOSE" FontSize="13" FontWeight="Bold"/>
                        </Button>
                        <Button Command="{Binding OpenCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{StaticResource PrimaryBrush}"
                                Height="38"
                                Padding="24,0">
                            <TextBlock Text="SELECT / OPEN" FontSize="13" FontWeight="Bold" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
