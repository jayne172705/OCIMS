<Window x:Class="eSureHi.Views.Admin.Dialogs.TransactionDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Transaction Detail"
        Width="760" Height="620"
        MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="SwapHorizontal"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                        <Run Text="Transaction —"/>
                        <Run Text="{Binding Transaction.TransactionNo, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CloseCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <Grid Grid.Row="1" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Transaction Details -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Header Info -->
                    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1"
                                         Margin="0,0,0,12">
                        <Grid Margin="16,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="{Binding Transaction.Subject, Mode=OneWay}"
                                           FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border CornerRadius="10" Padding="8,2" Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Transaction.TransactionType, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                    </Border>
                                    <Border CornerRadius="10" Padding="8,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Transaction.Priority, Mode=OneWay}" Value="Urgent">
                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Transaction.Priority, Mode=OneWay}" Value="High">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Transaction.Priority, Mode=OneWay}"
                                                   FontSize="11" FontWeight="Medium"
                                                   Foreground="{Binding PriorityColor, Mode=OneWay}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Transaction Date" FontSize="10"/>
                                    <TextBlock Text="{Binding Transaction.TransactionDate,
                                                   Mode=OneWay, StringFormat={}{0:MMM dd, yyyy}}"
                                               FontSize="12" FontWeight="Medium"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Due Date" FontSize="10"/>
                                    <TextBlock Text="{Binding Transaction.DueDate,
                                                   Mode=OneWay, StringFormat={}{0:MMM dd, yyyy}}"
                                               FontSize="12" FontWeight="Medium"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Sender & Receiver -->
                    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1"
                                         Margin="0,0,0,12">
                        <Grid Margin="16,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="FROM" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Transaction.Sender.SenderName, Mode=OneWay}"
                                           FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Transaction.Sender.SenderType, Mode=OneWay}"
                                           FontSize="11"/>
                                <TextBlock Text="{Binding Transaction.Sender.Email, Mode=OneWay}"
                                           FontSize="11" Foreground="#64748B"/>
                            </StackPanel>

                            <materialDesign:PackIcon Grid.Column="1"
                                                     Kind="ArrowRight"
                                                     Width="20" Height="20"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="TO" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Transaction.Receiver.ReceiverName, Mode=OneWay}"
                                           FontSize="13" FontWeight="Medium"/>
                                <TextBlock Text="{Binding Transaction.Receiver.ReceiverType, Mode=OneWay}"
                                           FontSize="11"/>
                                <TextBlock Text="{Binding Transaction.Receiver.Department, Mode=OneWay}"
                                           FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>

                    <!-- Description & Remarks -->
                    <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="Description" FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Transaction.Description, Mode=OneWay}"
                                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <TextBlock Text="Remarks" FontSize="11"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding Transaction.Remarks, Mode=OneWay}"
                                       FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </ScrollViewer>

            <!-- Right: Status + Workflow -->
            <StackPanel Grid.Column="2">

                <!-- Status Badge -->
                <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1"
                                     Margin="0,0,0,12">
                    <StackPanel Margin="16,14" HorizontalAlignment="Center">
                        <TextBlock Text="Current Status"
                                   FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <Border CornerRadius="16" Padding="20,8"
                                HorizontalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#1E293B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TxStatus}" Value="Pending">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TxStatus}" Value="In Transit">
                                            <Setter Property="Background" Value="#ECFDF3"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TxStatus}" Value="Received">
                                            <Setter Property="Background" Value="#F3E5F5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TxStatus}" Value="Acknowledged">
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TxStatus}" Value="Completed">
                                            <Setter Property="Background" Value="#E0F7FA"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TxStatus}" Value="Cancelled">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding TxStatus}"
                                       FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TxStatus}" Value="Pending">
                                                <Setter Property="Foreground" Value="#E65100"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TxStatus}" Value="In Transit">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TxStatus}" Value="Received">
                                                <Setter Property="Foreground" Value="#6A1B9A"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TxStatus}" Value="Acknowledged">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TxStatus}" Value="Completed">
                                                <Setter Property="Foreground" Value="#00838F"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TxStatus}" Value="Cancelled">
                                                <Setter Property="Foreground" Value="#C62828"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Workflow Actions -->
                <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1">
                    <StackPanel Margin="16,14">
                        <TextBlock Text="Workflow Actions"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <!-- Remarks for transition -->
                        <TextBox Text="{Binding TransitionRemarks,
                                     UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Add remarks (optional)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="60" VerticalContentAlignment="Top"
                                 FontSize="12" Margin="0,0,0,12"/>

                        <!-- In Transit -->
                        <Button Command="{Binding InTransitCommand}"
                                Visibility="{Binding CanMarkInTransit,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Height="40" Margin="0,0,0,8"
                                Background="{StaticResource PrimaryBrush}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="TruckDelivery"
                                                         Width="16" Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Mark In Transit"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Received -->
                        <Button Command="{Binding ReceivedCommand}"
                                Visibility="{Binding CanMarkReceived,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Height="40" Margin="0,0,0,8"
                                Background="#6A1B9A"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PackageVariantClosed"
                                                         Width="16" Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Mark Received"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Acknowledged -->
                        <Button Command="{Binding AcknowledgedCommand}"
                                Visibility="{Binding CanMarkAcknowledged,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Height="40" Margin="0,0,0,8"
                                Background="{StaticResource SuccessBrush}"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle"
                                                         Width="16" Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Acknowledge"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Complete -->
                        <Button Command="{Binding CompleteCommand}"
                                Visibility="{Binding CanComplete,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Height="40" Margin="0,0,0,8"
                                Background="#00838F"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckAll"
                                                         Width="16" Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Mark Completed"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Cancel -->
                        <Button Command="{Binding CancelTxCommand}"
                                Visibility="{Binding CanCancel,
                                    Converter={StaticResource BoolToVisibilityConverter}}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Height="36"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="{StaticResource ErrorBrush}"
                                BorderBrush="{StaticResource ErrorBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Cancel"
                                                         Width="16" Height="16"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Cancel Transaction"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Status Message -->
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="{Binding StatusMessage,
                                       Converter={StaticResource StringToVisibilityConverter}}"/>

                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </Grid>

        <!-- ── Footer ── -->
        <Border Grid.Row="2"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Button Content="Close"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="90"/>
        </Border>
    </Grid>
</Window>
