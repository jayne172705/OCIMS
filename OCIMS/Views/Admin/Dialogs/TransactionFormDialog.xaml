<Window x:Class="eSureHi.Views.Admin.Dialogs.TransactionFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Transaction"
        Width="740" Height="660"
        MinWidth="680" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="SwapHorizontal"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding DialogTitle}"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource MaterialDesignTabControl}"
                    Margin="16,12,16,0">

            <!-- ================================================== -->
            <!-- TAB 1 — Transaction Info                         -->
            <!-- ================================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocument"
                                     Width="16" Height="16"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"/>
                        <TextBlock Text="Transaction Info"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel>

                        <!-- Type + Priority -->
                        <Grid Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding TransactionTypes}"
                                      SelectedItem="{Binding TransactionType}"
                                      materialDesign:HintAssist.Hint="Transaction Type *"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="13"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding PriorityOptions}"
                                      SelectedItem="{Binding Priority}"
                                      materialDesign:HintAssist.Hint="Priority"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      FontSize="13"/>
                        </Grid>

                        <!-- Subject -->
                        <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Subject *"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" FontSize="13"/>

                        <!-- Transaction Date + Due Date -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding TransactionDate}"
                                        materialDesign:HintAssist.Hint="Transaction Date *"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        FontSize="13"/>
                            <DatePicker Grid.Column="2"
                                        SelectedDate="{Binding DueDate}"
                                        materialDesign:HintAssist.Hint="Due Date (optional)"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        FontSize="13"/>
                        </Grid>

                        <!-- Description -->
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Description (optional)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="100" VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,12" FontSize="13"/>

                        <!-- Remarks -->
                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Remarks (optional)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 Height="70" VerticalContentAlignment="Top"
                                 FontSize="13"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================== -->
            <!-- TAB 2 — Sender & Receiver                        -->
            <!-- ================================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountSwitch"
                         Width="16" Height="16"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0"
                         Foreground="{StaticResource WarningBrush}"/>
                        <TextBlock Text="Sender &amp; Receiver"/>
                        <Border Background="{StaticResource WarningBrush}" helpers:Adaptive.UseAdaptiveForeground="True"
                    CornerRadius="8" Padding="5,1"
                    Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Required"
                           FontSize="9"
                           FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Sender -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Sender"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,12,0,8"/>

                            <ComboBox ItemsSource="{Binding Senders}"
                                      SelectedItem="{Binding SelectedSender}"
                                      materialDesign:HintAssist.Hint="Select Sender"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Margin="0,0,0,8" FontSize="13">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SenderName}"
                                                       FontSize="13" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding SenderType}"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Command="{Binding ToggleAddSenderCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    HorizontalAlignment="Left"
                                    Height="28" FontSize="11" Padding="4,0"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus"
                                                             Width="14" Height="14"
                                                             Margin="0,0,4,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Add New Sender"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Quick-Add Sender -->
                            <Border BorderBrush="#DDE4EF" BorderThickness="1"
                                    CornerRadius="4" Padding="10" Margin="0,0,0,8" Background="#F8FAFC" helpers:Adaptive.UseAdaptiveForeground="True"
                                    Visibility="{Binding ShowAddSender,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBox Text="{Binding NewSenderName,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Sender Name *"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Margin="0,0,0,8" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding SenderTypes}"
                                              SelectedItem="{Binding NewSenderType}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Margin="0,0,0,8" FontSize="12"/>
                                    <Button Command="{Binding AddSenderCommand}"
                                            Background="{StaticResource PrimaryBrush}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Height="32" FontSize="12">
                                        <TextBlock Text="Add Sender"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Selected Sender Preview -->
                            <materialDesign:Card Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True"
                                                 materialDesign:ElevationAssist.Elevation="Dp0"
                                                 Visibility="{Binding SelectedSender,
                                                     Converter={StaticResource NullToBoolConverter}}">
                                <StackPanel Margin="12,10">
                                    <TextBlock Text="{Binding SelectedSender.SenderName}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="#2E7D32"/>
                                    <TextBlock Foreground="#64748B" FontSize="11">
                                        <Run Text="{Binding SelectedSender.SenderType}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding SelectedSender.Email}"/>
                                    </TextBlock>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>

                        <!-- Receiver -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Receiver"
                                       FontSize="13" FontWeight="SemiBold" Margin="0,12,0,8"/>

                            <ComboBox ItemsSource="{Binding Receivers}"
                                      SelectedItem="{Binding SelectedReceiver}"
                                      materialDesign:HintAssist.Hint="Select Receiver"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Margin="0,0,0,8" FontSize="13">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ReceiverName}"
                                                       FontSize="13" FontWeight="Medium"/>
                                            <TextBlock FontSize="11">
                                                <Run Text="{Binding ReceiverType}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Department}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Command="{Binding ToggleAddReceiverCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    HorizontalAlignment="Left"
                                    Height="28" FontSize="11" Padding="4,0"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus"
                                                             Width="14" Height="14"
                                                             Margin="0,0,4,0"
                                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Add New Receiver"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Quick-Add Receiver -->
                            <Border BorderBrush="#DDE4EF" BorderThickness="1"
                                    CornerRadius="4" Padding="10" Margin="0,0,0,8" Background="#F8FAFC" helpers:Adaptive.UseAdaptiveForeground="True"
                                    Visibility="{Binding ShowAddReceiver,
                                        Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBox Text="{Binding NewReceiverName,
                                                 UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Receiver Name *"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Margin="0,0,0,8" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding ReceiverTypes}"
                                              SelectedItem="{Binding NewReceiverType}"
                                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              Margin="0,0,0,8" FontSize="12"/>
                                    <Button Command="{Binding AddReceiverCommand}"
                                            Background="{StaticResource PrimaryBrush}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Height="32" FontSize="12">
                                        <TextBlock Text="Add Receiver"/>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Selected Receiver Preview -->
                            <materialDesign:Card Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True"
                                                 materialDesign:ElevationAssist.Elevation="Dp0"
                                                 Visibility="{Binding SelectedReceiver,
                                                     Converter={StaticResource NullToBoolConverter}}">
                                <StackPanel Margin="12,10">
                                    <TextBlock Text="{Binding SelectedReceiver.ReceiverName}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="#81C784"/>
                                    <TextBlock Foreground="#81C784" FontSize="11">
                                        <Run Text="{Binding SelectedReceiver.ReceiverType}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding SelectedReceiver.Department}"/>
                                    </TextBlock>
                                </StackPanel>
                            </materialDesign:Card>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ================================================== -->
            <!-- TAB 3 — Linked Document                          -->
            <!-- ================================================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Paperclip"
                                     Width="16" Height="16"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0"/>
                        <TextBlock Text="Linked Document"/>
                        <Border Background="#1C3A5E" helpers:Adaptive.UseAdaptiveForeground="True"
                    CornerRadius="8" Padding="5,1"
                    Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Optional"
                           FontSize="9"
                           FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8">
                    <StackPanel>
                        <TextBlock Text="Link an existing document to this transaction (optional)."
                                   FontSize="12"
                                   Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <ComboBox ItemsSource="{Binding Documents}"
                                  SelectedItem="{Binding SelectedDocument}"
                                  materialDesign:HintAssist.Hint="Select Document (optional)"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,0,0,12" FontSize="13">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DocTitle, Mode=OneWay}"
                       FontSize="13" FontWeight="Medium"/>
                                        <TextBlock FontSize="11">
                <Run Text="{Binding Employee.FullName, Mode=OneWay,
                         TargetNullValue='Unknown Employee'}"/>
                <Run Text=" · "/>
                <Run Text="{Binding FileName, Mode=OneWay,
                         TargetNullValue='No file'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Selected Document Preview -->
                        <materialDesign:Card Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True"
                                             materialDesign:ElevationAssist.Elevation="Dp1"
                                             Visibility="{Binding SelectedDocument,
                                                 Converter={StaticResource NullToBoolConverter}}">
                            <Grid Margin="16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="FileDocument"
                                                         Width="32" Height="32"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedDocument.DocTitle}"
                                               FontSize="14" FontWeight="Bold"
                                               Foreground="#2E7D32"/>
                                    <TextBlock FontSize="12" Foreground="#64748B">
                                        <Run Text="{Binding SelectedDocument.Employee.FullName, Mode=OneWay,
                                                 TargetNullValue='Unknown Employee'}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding SelectedDocument.FileName, Mode=OneWay,
                                                 TargetNullValue='No file'}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedDocument.FileSize}"
                                               FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>

                        <Button Content="Clear Link"
                                Command="{Binding ClearDocumentCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="{StaticResource ErrorBrush}"
                                HorizontalAlignment="Left"
                                Height="28" FontSize="11"
                                Margin="0,8,0,0"
                                Visibility="{Binding SelectedDocument,
                                    Converter={StaticResource NullToBoolConverter}}"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" Width="90"/>
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy,
                                Converter={StaticResource InverseBoolConverter}}"
                            Background="{StaticResource PrimaryBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="170">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"
                                                     Width="16" Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Save Transaction"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
