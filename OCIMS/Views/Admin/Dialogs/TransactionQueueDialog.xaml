<Window x:Class="eSureHi.Views.Admin.Dialogs.TransactionQueueDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Transactions - Select Transaction"
        Width="760"
        Height="640"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="SwapHorizontal"
                                         Width="24"
                                         Height="24"
                                         Foreground="{StaticResource PrimaryBrush}"
                                         Margin="0,0,10,0"/>
                <TextBlock Text="Select Transaction"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding QueueCountText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#94A3B8"/>
            <Button Command="{Binding RefreshCommand}"
                    HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    Height="34"
                    Padding="12,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                    <TextBlock Text="Refresh" FontSize="12"/>
                </StackPanel>
            </Button>
        </Grid>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Search transaction, subject, sender..."
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Height="50"
                     FontSize="12"/>

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding TypeOptions}"
                      SelectedItem="{Binding TypeFilter}"
                      materialDesign:HintAssist.Hint="Type"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Height="50"
                      FontSize="12"/>

            <ComboBox Grid.Column="4"
                      ItemsSource="{Binding PriorityOptions}"
                      SelectedItem="{Binding PriorityFilter}"
                      materialDesign:HintAssist.Hint="Priority"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Height="50"
                      FontSize="12"/>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#E3F2FD" BorderBrush="#BBDEFB" BorderThickness="0,0,0,1" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClockAlertOutline"
                                                 Width="15"
                                                 Height="15"
                                                 Foreground="#1565C0"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Text="PENDING"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#1565C0"/>
                        <Border Background="#1565C0"
                                CornerRadius="8"
                                Padding="6,1"
                                Margin="8,0,0,0">
                            <TextBlock Text="{Binding PendingCount}" Foreground="White" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding PendingTransactions}"
                          SelectedItem="{Binding SelectedTransaction}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5EAF2"
                          RowHeight="42"
                          MaxHeight="190"
                          BorderThickness="0"
                          Style="{StaticResource ReadableDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Transaction #" Binding="{Binding TransactionNo}" Width="140"/>
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                        <DataGridTextColumn Header="From" Binding="{Binding Sender.SenderName}" Width="150"/>
                        <DataGridTextColumn Header="To" Binding="{Binding Receiver.ReceiverName}" Width="150"/>
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#FFF7E0" BorderBrush="#FFE0A3" BorderThickness="0,1,0,1" Padding="10,6" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TransitConnectionVariant"
                                                 Width="15"
                                                 Height="15"
                                                 Foreground="#C2410C"
                                                 Margin="0,0,6,0"/>
                        <TextBlock Text="ACTIVE QUEUE"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="#C2410C"/>
                        <Border Background="#EA580C"
                                CornerRadius="8"
                                Padding="6,1"
                                Margin="8,0,0,0">
                            <TextBlock Text="{Binding ActiveCount}" Foreground="White" FontSize="10"/>
                        </Border>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding ActiveTransactions}"
                          SelectedItem="{Binding SelectedTransaction}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E5EAF2"
                          RowHeight="42"
                          MinHeight="190"
                          BorderThickness="0"
                          Style="{StaticResource ReadableDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Transaction #" Binding="{Binding TransactionNo}" Width="140"/>
                        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110"/>
                        <DataGridTextColumn Header="From" Binding="{Binding Sender.SenderName}" Width="150"/>
                        <DataGridTextColumn Header="To" Binding="{Binding Receiver.ReceiverName}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Command="{Binding ShowAllCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    Height="34"
                    Padding="16,0"
                    Margin="0,0,8,0">
                <TextBlock Text="SHOW ALL" FontSize="12" FontWeight="SemiBold"/>
            </Button>
            <Button Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Foreground="{StaticResource PrimaryBrush}"
                    BorderBrush="{StaticResource PrimaryBrush}"
                    Height="34"
                    Padding="16,0"
                    Margin="0,0,8,0">
                <TextBlock Text="CLOSE" FontSize="12" FontWeight="SemiBold"/>
            </Button>
            <Button Command="{Binding SelectCommand}"
                    Background="{StaticResource PrimaryBrush}"
                    Foreground="White"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="34"
                    Padding="18,0">
                <TextBlock Text="SELECT" FontSize="12" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>
    </Grid>
</Window>
