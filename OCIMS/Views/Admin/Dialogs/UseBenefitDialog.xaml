<Window x:Class="eSureHi.Views.Admin.Dialogs.UseBenefitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Use Benefit"
        Width="400" SizeToContent="Height"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Title Bar ── -->
        <Border Grid.Row="0" Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="HeartMinus"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Use Benefit"
                               FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="48" Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <StackPanel Grid.Row="1" Margin="20,16">

            <!-- Benefit Summary -->
            <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1"
                                 Margin="0,0,0,16">
                <Grid Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding EmployeeName, Mode=OneWay}"
                                   FontSize="14" FontWeight="Bold"/>
                        <TextBlock FontSize="12">
                            <Run Text="{Binding PolicyName, Mode=OneWay}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding BenefitType, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding YearPeriod, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <UniformGrid Grid.Row="2" Columns="3">
                        <StackPanel>
                            <TextBlock Text="Maximum" FontSize="10"/>
                            <TextBlock Text="{Binding MaxBenefit, Mode=OneWay,
                                           StringFormat=₱{0:N2}}"
                                       FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Used" FontSize="10"/>
                            <TextBlock Text="{Binding UsedBenefit, Mode=OneWay,
                                           StringFormat=₱{0:N2}}"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource WarningBrush}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Remaining" FontSize="10"/>
                            <TextBlock Text="{Binding Remaining, Mode=OneWay,
                                           StringFormat=₱{0:N2}}"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </materialDesign:Card>

            <!-- Amount Used -->
            <TextBox Text="{Binding AmountUsed,
                         UpdateSourceTrigger=PropertyChanged,
                         StringFormat={}{0:N2}}"
                     materialDesign:HintAssist.Hint="Amount Being Used (₱) *"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,12" FontSize="13"/>

            <!-- Date Used -->
            <DatePicker SelectedDate="{Binding UsedDate}"
                        materialDesign:HintAssist.Hint="Date Used *"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,0,12" FontSize="13"/>

            <ComboBox ItemsSource="{Binding SourceOfFundsOptions}"
                      SelectedItem="{Binding SourceOfFunds}"
                      materialDesign:HintAssist.Hint="Source of Funds *"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,12"
                      FontSize="13"/>

            <!-- Notes -->
            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Notes (optional)"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     Height="80" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="13"/>

        </StackPanel>

        <!-- ── Footer ── -->
        <Border Grid.Row="2"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True" Padding="16,12">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" Width="90"/>
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy,
                                Converter={StaticResource InverseBoolConverter}}"
                            Background="{StaticResource WarningBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="130">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="HeartMinus"
                                                     Width="16" Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Use Benefit"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
