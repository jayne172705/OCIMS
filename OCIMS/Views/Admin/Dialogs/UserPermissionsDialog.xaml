<Window x:Class="eSureHi.Views.Admin.Dialogs.UserPermissionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Manage Access"
        Width="460"
        SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <materialDesign:PackIcon Kind="ShieldAccount"
                                             Width="20"
                                             Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Manage Access"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Width="48"
                        Height="44"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="620">
            <StackPanel Margin="20,16">
                <Border Background="White"
                        BorderBrush="#DDE4EF"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="14,12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding UserHeader}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text="Choose which admin pages this account can see."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <UniformGrid Columns="2">
                    <CheckBox Content="Dashboard" IsChecked="{Binding CanAccessDashboard}" Margin="0,0,12,10"/>
                    <CheckBox Content="Employees" IsChecked="{Binding CanAccessEmployees}" Margin="0,0,12,10"/>
                    <CheckBox Content="Beneficiaries" IsChecked="{Binding CanAccessBeneficiaries}" Margin="0,0,12,10"/>
                    <CheckBox Content="Policies" IsChecked="{Binding CanAccessPolicies}" Margin="0,0,12,10"/>
                    <CheckBox Content="Claims" IsChecked="{Binding CanAccessClaims}" Margin="0,0,12,10"/>
                    <CheckBox Content="Premiums" IsChecked="{Binding CanAccessPremiums}" Margin="0,0,12,10"/>
                    <CheckBox Content="Benefits" IsChecked="{Binding CanAccessBenefits}" Margin="0,0,12,10"/>
                    <CheckBox Content="Documents" IsChecked="{Binding CanAccessDocuments}" Margin="0,0,12,10"/>
                    <CheckBox Content="Transactions" IsChecked="{Binding CanAccessTransactions}" Margin="0,0,12,10"/>
                    <CheckBox Content="Cedulas" IsChecked="{Binding CanAccessCedulas}" Margin="0,0,12,10"/>
                    <CheckBox Content="Reports" IsChecked="{Binding CanAccessReports}" Margin="0,0,12,10"/>
                    <CheckBox Content="Company Profile" IsChecked="{Binding CanAccessCompanyProfile}" Margin="0,0,12,10"/>
                    <CheckBox Content="Settings" IsChecked="{Binding CanAccessSettings}" Margin="0,0,12,10"/>
                </UniformGrid>

                <Border Background="#F0FDF4"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="12,10"
                        Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline"
                                                 Width="18"
                                                 Height="18"
                                                 Foreground="{StaticResource PrimaryBrush}"
                                                 Margin="0,0,8,0"/>
                        <TextBlock Text="Changes take effect on the user's next login."
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                BorderBrush="#DDE4EF"
                BorderThickness="0,1,0,0"
                Background="White"
                helpers:Adaptive.UseAdaptiveForeground="True"
                Padding="16,12">
            <Grid>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           MaxWidth="240"
                           Visibility="{Binding ErrorMessage,
                               Converter={StaticResource StringToVisibilityConverter}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"
                            Width="90"/>
                    <Button Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy,
                                Converter={StaticResource InverseBoolConverter}}"
                            Background="{StaticResource PrimaryBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Width="130">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave"
                                                     Width="16"
                                                     Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Save Access" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
