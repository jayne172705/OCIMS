<Window x:Class="eSureHi.Views.Admin.EmployeeShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Icon="pack://application:,,,/Assets/eSureHi.ico"
        xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin"
        Title="eSureHi+ — Employee Portal"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Loaded="EmployeeShell_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="5"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ROW 0 — Custom Title Bar                                    -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Branding -->
                <Border Grid.Column="0" Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True"
                        BorderBrush="#1976D2" BorderThickness="0,0,1,0">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="16,0">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               Width="20" Height="20"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="eSureHi+" FontWeight="SemiBold"
                                   FontSize="14" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="— Employee Portal"
                                   Foreground="#64748B" FontSize="11"
                                   Margin="4,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Center: Page Title -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding CurrentPageTitle}" FontWeight="SemiBold"
                               FontSize="14" Margin="0,0,16,0"
                               VerticalAlignment="Center"/>
                    <materialDesign:PackIcon Kind="CalendarClock"
                                             Width="16" Height="16"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"/>
                    <TextBlock x:Name="CurrentDateTime"
                               Text="Loading..." FontSize="12"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Action: Notifications -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">

                    <!-- User Info -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Command="{Binding ChangeProfileImageCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Width="40" Height="40"
                                Padding="4"
                                ToolTip="Change profile image">
                            <Border Width="30" Height="30" CornerRadius="15"
                                    Background="#1B5E20"
                                    helpers:Adaptive.UseAdaptiveForeground="True"
                                    ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding UserInitials}"
                                               FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding HasProfileImage,
                                                   Converter={StaticResource BoolToVisibilityConverter},
                                                   ConverterParameter=Invert}"/>
                                    <Ellipse Width="30"
                                             Height="30"
                                             Visibility="{Binding HasProfileImage,
                                                 Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Ellipse.Fill>
                                            <ImageBrush ImageSource="{Binding ProfileImagePath,
                                                         Converter={StaticResource PathToImageConverter}}"
                                                        Stretch="UniformToFill"
                                                        AlignmentX="Center"
                                                        AlignmentY="Center"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            </Border>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding EmployeeFullName}"
                                       FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentRole}"
                                       FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Bell -->
                    <Grid VerticalAlignment="Center" Margin="4,0,4,0"
                          WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource MaterialDesignFlatButton}"
                                Command="{Binding ToggleNotificationsCommand}" Width="50" Height="44"
                                ToolTip="Notifications">
                            <materialDesign:PackIcon Kind="Bell" Width="20" Height="20"/>
                        </Button>
                        <Border x:Name="NotifBadge" Background="#FF5252" helpers:Adaptive.UseAdaptiveForeground="True" CornerRadius="8"
                                MinWidth="16" Height="16" Padding="3,0"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,4,4,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UnreadNotifications}"
                                                     Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding UnreadNotifications}" FontSize="9"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Notifications Popup -->
                        <Popup IsOpen="{Binding IsNotificationsPanelOpen, Mode=TwoWay}"
                               StaysOpen="False"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Slide">
                            <Border Width="380" MaxHeight="500" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                                    BorderBrush="#DDE4EF" BorderThickness="1"
                                    CornerRadius="4">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3"
                                                      Opacity="0.2" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="#DDE4EF"
                                            BorderThickness="0,0,0,1" Padding="16,12">
                                        <Grid>
                                            <TextBlock Text="Notifications"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Button Command="{Binding NotificationsVm.MarkAllReadCommand}"
                                                    Style="{StaticResource MaterialDesignFlatButton}"
                                                    Foreground="{StaticResource PrimaryBrush}"
                                                    HorizontalAlignment="Right"
                                                    Height="28" FontSize="11" Padding="8,0">
                                                <TextBlock Text="Mark all read"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  MaxHeight="380">
                                        <StackPanel>
                                            <StackPanel HorizontalAlignment="Center"
                                                        Margin="0,32,0,32"
                                                        Visibility="{Binding NotificationsVm.HasItems,
                                                            Converter={StaticResource BoolToVisibilityConverter},
                                                            ConverterParameter=Invert}">
                                                <materialDesign:PackIcon Kind="BellOff"
                                                                         Width="40" Height="40"
                                                                         Foreground="#E0E0E0"
                                                                         HorizontalAlignment="Center"/>
                                                <TextBlock Text="No notifications"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,8,0,0"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding NotificationsVm.Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#DDE4EF"
                                                                BorderThickness="0,0,0,1"
                                                                Cursor="Hand">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="White"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsRead}"
                                                                                     Value="False">
                                                                            <Setter Property="Background"
                                                                                    Value="#F0FDF4"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick"
                                                                              Command="{Binding DataContext.NotificationsVm.MarkReadCommand,
                                                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                                                              CommandParameter="{Binding}"/>
                                                            </Border.InputBindings>
                                                            <Grid Margin="16,12">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Grid.Column="0"
                                                                         Width="8" Height="8"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,4,10,0"
                                                                         Fill="{Binding DotColor,
                                                                             Converter={StaticResource HexToBrushConverter}}"/>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               FontSize="13"
                                                                               TextTrimming="CharacterEllipsis">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                        
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <TextBlock Text="{Binding Message}"
                                                                               FontSize="11"
                                                                               TextWrapping="Wrap" MaxHeight="36"
                                                                               Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2"
                                                                           Text="{Binding TimeAgo}"
                                                                           FontSize="10"
                                                                           VerticalAlignment="Top"
                                                                           Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <Border Grid.Row="2" BorderBrush="#DDE4EF"
                                            BorderThickness="0,1,0,0" Padding="16,8">
                                        <Button Command="{Binding NotificationsVm.RefreshCommand}"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{StaticResource PrimaryBrush}"
                                                HorizontalAlignment="Center"
                                                Height="28" FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Refresh"
                                                                         Width="14" Height="14"
                                                                         Margin="0,0,6,0"
                                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="Refresh"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Click="BtnMinimize_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="48" Height="44">
                        <materialDesign:PackIcon Kind="WindowMinimize"
                                                 Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="BtnMaximize" Click="BtnMaximize_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="48" Height="44">
                        <materialDesign:PackIcon x:Name="MaximizeIcon"
                                                 Kind="WindowRestore"
                                                 Width="18" Height="18"/>
                    </Button>
                    <Button Click="BtnClose_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Width="48" Height="44">
                        <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- ROW 1 — Sidebar + Content                                   -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ── -->
            <Border Grid.Column="0" Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True">
                <DockPanel>

                    <!-- TOP: Logo -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,24,0,16">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                                                 Width="52" Height="52"
                                                 HorizontalAlignment="Center"
                                                 RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="eSureHi+"
                                   FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,2"/>
                        <TextBlock Text="Employee Portal"
                                   FontSize="10" Foreground="#64748B"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Separator DockPanel.Dock="Top"
                               Background="#1976D2" Margin="16,0,16,8"/>

                    <!-- BOTTOM: Logout -->
                    <Button DockPanel.Dock="Bottom"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#EF9A9A"
                            Height="48" Margin="8,8,8,12"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Margin="8,0">
                            <materialDesign:PackIcon Kind="Logout"
                                                     Width="20" Height="20"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,10,0"/>
                            <TextBlock Text="Logout" FontSize="13"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator DockPanel.Dock="Bottom"
                               Background="#1976D2" Margin="16,0"/>

                    <!-- BOTTOM: User Badge -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="16,12,16,4">
                        <TextBlock Text="Logged in as"
                                   FontSize="10" Foreground="#64748B"/>
                        <TextBlock Text="{Binding EmployeeFullName}"
                                   FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentRole}"
                                   FontSize="10" Foreground="#64748B"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- MIDDLE: Nav -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,4">

                            <Button Command="{Binding NavDashboardCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48" Margin="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewDashboardOutline"
                                                             Width="20" Height="20"
                                                             Margin="0,0,12,0"/>
                                    <TextBlock Text="Dashboard" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavMyProfileCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48" Margin="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountCircle"
                                                             Width="20" Height="20"
                                                             Margin="0,0,12,0"/>
                                    <TextBlock Text="My Profile" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavMyPoliciesCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48" Margin="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldStar"
                                                             Width="20" Height="20"
                                                             Margin="0,0,12,0"/>
                                    <TextBlock Text="My Policies" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavMyClaimsCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48" Margin="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardList"
                                                             Width="20" Height="20"
                                                             Margin="0,0,12,0"/>
                                    <TextBlock Text="My Claims" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavMyPremiumsCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48" Margin="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashMultiple"
                                                             Width="20" Height="20"
                                                             Margin="0,0,12,0"/>
                                    <TextBlock Text="My Premiums" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavMyBenefitsCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48" Margin="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="HeartPulse"
                                                             Width="20" Height="20"
                                                             Margin="0,0,12,0"/>
                                    <TextBlock Text="My Benefits" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavBeneficiariesCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48" Margin="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountSearch"
                                                             Width="20" Height="20"
                                                             Margin="0,0,12,0"/>
                                    <TextBlock Text="Beneficiaries" FontSize="13"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding NavTransactionsCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalContentAlignment="Left" Height="48" Margin="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SwapHorizontal"
                                                             Width="20" Height="20"
                                                             Margin="0,0,12,0"/>
                                    <TextBlock Text="Transactions" FontSize="13"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>

                </DockPanel>
            </Border>

            <!-- ── Main Content ── -->
            <ContentControl x:Name="MainContent"
                            Grid.Column="1"
                            Background="{StaticResource BackgroundBrush}"
                            Focusable="False"/>
        </Grid>
    </Grid>
</Window>
