<UserControl x:Class="eSureHi.Views.Admin.UserControls.AdvancePaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:eSureHi.Helpers">

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="CashFast"
                                             Width="24" Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="Advance Payment" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="Record an advance payment for a beneficiary or family."
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding BackToDashboardCommand}"
                        Background="#D32F2F"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="34" Padding="16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Exit" FontSize="12"
                                   FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── Content ── -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Search + Record Form ── -->
            <Border Grid.Column="0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                    CornerRadius="8" BorderBrush="#DDE4EF" BorderThickness="1"
                    Padding="20" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Find Member" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search name or family/member ID..."
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Height="50" FontSize="12"/>

                    <ListBox ItemsSource="{Binding SearchResults}"
                             MaxHeight="180"
                             Margin="0,8,0,0"
                             BorderThickness="1" BorderBrush="#E5EAF2"
                             Visibility="{Binding HasSearchResults, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BeneficiaryId, StringFormat=' ({0})'}" FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="MouseLeftButtonUp" Handler="SearchResult_Click"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Border Background="#F1F8E9" CornerRadius="6" Padding="12" Margin="0,14,0,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Selected Member" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding SelectedFamilyLabel}" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Months to Pay in Advance" FontSize="12" FontWeight="Medium" Margin="0,18,0,6"/>
                    <ComboBox ItemsSource="{Binding MonthsOptions}"
                              SelectedItem="{Binding SelectedMonths}"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Height="46" FontSize="12"/>

                    <TextBlock Text="Amount (per month)" FontSize="12" FontWeight="Medium" Margin="0,14,0,6"/>
                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="₱0.00"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Height="46" FontSize="12"/>

                    <TextBlock Text="{Binding StatusMessage}"
                               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibilityConverter}}"
                               FontSize="11" Foreground="{StaticResource PrimaryBrush}"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>

                    <Button Command="{Binding RecordPaymentCommand}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="42" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CashCheck" Width="16" Height="16"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}"/>
                            <ProgressBar IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <TextBlock Text="Record Payment" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ── Right: Recent Advance Payments ── -->
            <Border Grid.Column="2" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                    CornerRadius="8" BorderBrush="#DDE4EF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Recent Advance Payments" FontSize="13" FontWeight="SemiBold"
                               Margin="16,14,16,10"/>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RecentPayments}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5EAF2"
                              RowHeight="44"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
                              Style="{StaticResource ReadableDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Member" Binding="{Binding MemberName}" Width="*"/>
                            <DataGridTextColumn Header="Family ID" Binding="{Binding FamilyId}" Width="120"/>
                            <DataGridTextColumn Header="Billing Month" Binding="{Binding BillingMonth, StringFormat={}{0:MMM yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=₱{0:N2}}" Width="110"/>
                            <DataGridTextColumn Header="Budget Source" Binding="{Binding SourceOfFunds}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasRecentPayments, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                        <materialDesign:PackIcon Kind="CashRemove" Width="40" Height="40"
                                                 Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                        <TextBlock Text="No advance payments recorded yet." FontSize="12" Foreground="#94A3B8"
                                   Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
