<UserControl x:Class="eSureHi.Views.Admin.UserControls.AnnouncementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin">
    <UserControl.DataContext>
        <vm:AnnouncementsViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Bullhorn" Width="24" Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Announcements" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#1B5E20"
                            helpers:Adaptive.UseAdaptiveForeground="True"
                            CornerRadius="10"
                            Padding="8,2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="White">
                            <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding MarkSelectedReadCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Mark Selected Read" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding MarkVisibleReadCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckAll" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Mark Visible Read" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding BackToDashboardCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Exit" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <UniformGrid Grid.Row="2" Columns="2" Margin="24,18,24,12">
            <materialDesign:Card Background="White" Margin="0,0,10,0">
                <StackPanel Margin="18,12">
                    <TextBlock Text="Unread" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding UnreadCount}" FontSize="22" FontWeight="Bold" Foreground="#B45309"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Background="White">
                <StackPanel Margin="18,12">
                    <TextBlock Text="Visible Items" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding FilteredCount}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="16,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search title, message, recipient, type"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Height="46"/>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding TypeOptions}"
                              SelectedItem="{Binding SelectedType}"
                              materialDesign:HintAssist.Hint="Type"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Height="46"/>

                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding ReadOptions}"
                              SelectedItem="{Binding SelectedReadState}"
                              materialDesign:HintAssist.Hint="Read State"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Height="46"/>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding DisplayedAnnouncements}"
                      SelectedItem="{Binding SelectedAnnouncement}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      RowHeight="48"
                      Style="{StaticResource ReadableDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding CreatedAtText}" Width="170"/>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="220"/>
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2*"/>
                    <DataGridTextColumn Header="Recipient" Binding="{Binding RecipientName}" Width="130"/>
                    <DataGridTextColumn Header="Type" Binding="{Binding NotifType}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#DDE4EF"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="{StaticResource PrimaryBrush}"
                       TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </Border>
    </Grid>
</UserControl>
