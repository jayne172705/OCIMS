<UserControl x:Class="eSureHi.Views.Admin.UserControls.BeneficiariesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:eSureHi.Helpers"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FooterActionButton" BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountSearch"
                                             Width="24"
                                             Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Beneficiaries" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Background="#E3F2FD" CornerRadius="10" Padding="8,2" Margin="12,0,0,0">
                        <TextBlock FontSize="11" Foreground="#1565C0">
                            <Run Text="{Binding ActiveFilteredCount, Mode=OneWay}"/>
                            <Run Text=" shown"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding CreateAccountCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountKey" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Create Account" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BackToDashboardCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Exit" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <Grid Grid.Row="2" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDE4EF" BorderThickness="1">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Select Beneficiary"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#0F172A"/>
                        <TextBlock Text="Choose a CRS/master-list record first, review the complete details, then add the person to insurance records."
                                   FontSize="12"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Search name, beneficiary ID..."
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="46"/>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding SourceOptions}"
                                      SelectedItem="{Binding SelectedSource}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Source"
                                      Height="46"
                                      FontSize="12"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding StatusFilter}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      materialDesign:HintAssist.Hint="Support status"
                                      Height="46"
                                      FontSize="12"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox ItemsSource="{Binding DisplayedRecords}"
                                 SelectedItem="{Binding SelectedRecord}"
                                 BorderBrush="#E2E8F0"
                                 BorderThickness="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 Visibility="{Binding IsCrsSource, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="17" Background="#EFF6FF" Margin="0,0,10,0">
                                                <materialDesign:PackIcon Kind="Account"
                                                                         Width="19"
                                                                         Height="19"
                                                                         Foreground="{StaticResource PrimaryBrush}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" MinWidth="0">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="11" Foreground="#64748B" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding BeneficiaryId}"/>
                                                    <Run Text="  |  "/>
                                                    <Run Text="{Binding Sex, TargetNullValue='No sex'}"/>
                                                    <Run Text="  |  "/>
                                                    <Run Text="{Binding DateOfBirth, TargetNullValue='No birth date'}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Padding="8,3"
                                                    CornerRadius="10"
                                                    VerticalAlignment="Center"
                                                    Margin="10,0,0,0"
                                                    BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FFF8E1"/>
                                                        <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LinkStatus}" Value="Linked">
                                                                <Setter Property="Background" Value="#E8F5E9"/>
                                                                <Setter Property="BorderBrush" Value="#C8E6C9"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding LinkStatus}" Value="Skipped">
                                                                <Setter Property="Background" Value="#F1F5F9"/>
                                                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding LinkStatus}" FontSize="10" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#B78103"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding LinkStatus}" Value="Linked">
                                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding LinkStatus}" Value="Skipped">
                                                                    <Setter Property="Foreground" Value="#475569"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ListBox ItemsSource="{Binding DisplayedSystemBeneficiaries}"
                                 SelectedItem="{Binding SelectedSystemBeneficiary}"
                                 BorderBrush="#E2E8F0"
                                 BorderThickness="1"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Visibility="{Binding IsSystemSource, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FullName}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="#64748B" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding BeneficiaryId, TargetNullValue='No ID'}"/>
                                                <Run Text="  |  "/>
                                                <Run Text="{Binding Employee.FullName, TargetNullValue='No linked employee'}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDE4EF"
                    BorderThickness="1"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                    <materialDesign:PackIcon Kind="AccountDetailsOutline"
                                             Width="64"
                                             Height="64"
                                             Foreground="#CBD5E1"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a beneficiary name"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,6"/>
                    <TextBlock Text="Full CRS/master-list details and the insurance add form will appear here before anything is saved."
                               FontSize="13"
                               Foreground="#64748B"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="20,16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Beneficiary #" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding SelectedRecord.BeneficiaryId}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <TextBlock Text="Full Name" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding SelectedRecord.DisplayName}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <TextBlock Text="Address" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding ProfileAddress, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>

                                <UniformGrid Grid.Column="1" Columns="2" Margin="20,0,0,0">
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Sex" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.Sex, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Birth Date" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.DateOfBirth, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Age" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.Age, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Civil Status" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.MaritalStatus, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="CRS ID" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.CivilRegistryId, TargetNullValue='None'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Master List Status" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding ProfileStatus}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <Border Grid.Column="2"
                                        CornerRadius="16"
                                        BorderBrush="#94A3B8"
                                        BorderThickness="1"
                                        Padding="14,7"
                                        VerticalAlignment="Top"
                                        Background="#F8FAFC">
                                    <TextBlock Text="{Binding SelectedRecord.LinkStatus}" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="20,16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="CRS / Master List Data" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="PWD" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.IsPwd}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="PWD ID" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.PwdIdNo, TargetNullValue='None'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Disability Type" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.DisabilityType, TargetNullValue='None'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Senior Citizen" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.IsSenior}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Senior ID" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.SeniorIdNo, TargetNullValue='None'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Imported" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.ImportedAt, StringFormat={}{0:MMM dd, yyyy}}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="20,16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Address, Relationship, and Contact" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Linked Employee" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding ProfileEmployee.FullName, TargetNullValue='No employee linked'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Relationship" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding Relationship}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Mobile" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding ProfileEmployee.PhoneMobile, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Email" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding ProfileEmployee.Email, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#DDE4EF" BorderThickness="1" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="Add to Insurance Records" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Columns="4" Margin="0,0,0,12">
                                    <TextBox Text="{Binding SelectedRecord.FirstName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="First Name or Name *"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Height="48"
                                             Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding SelectedRecord.LastName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Last Name (optional)"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Height="48"
                                             Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding SelectedRecord.Sex, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Sex"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Height="48"
                                             Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding SelectedRecord.DateOfBirth, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Birth Date"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Height="48"/>
                                </UniformGrid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBox Text="{Binding EmployeeSearch, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Search employee to link (optional)..."
                                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="48"
                                                 Margin="0,0,0,8"/>
                                        <ListBox ItemsSource="{Binding FilteredEmployees}"
                                                 SelectedItem="{Binding SelectedEmployee}"
                                                 Height="120"
                                                 BorderBrush="#DDE4EF"
                                                 BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="6,4">
                                                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding EmployeeNo}" FontSize="11" Foreground="#64748B"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox ItemsSource="{Binding RelationshipOptions}"
                                                  SelectedItem="{Binding Relationship}"
                                                  materialDesign:HintAssist.Hint="Relationship"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Height="48"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding InsurancePolicies}"
                                                  SelectedItem="{Binding SelectedPolicy}"
                                                  DisplayMemberPath="PolicyName"
                                                  materialDesign:HintAssist.Hint="Insurance Type / Policy"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Height="48"/>

                                        <TextBox Grid.Row="2"
                                                 Text="{Binding CedulaNo, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Cedula No (optional)"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="48"/>
                                        <ComboBox Grid.Row="2"
                                                  Grid.Column="2"
                                                  ItemsSource="{Binding SourceOfFundsOptions}"
                                                  SelectedItem="{Binding SourceOfFunds}"
                                                  materialDesign:HintAssist.Hint="Source of Funds"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Height="48"/>

                                        <CheckBox Grid.Row="4"
                                                  IsChecked="{Binding Received}"
                                                  Content="Verified for insurance records"
                                                  VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4"
                                                 Grid.Column="2"
                                                 Text="{Binding Contribution, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                                 materialDesign:HintAssist.Hint="Initial Balance"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="48"/>
                                    </Grid>
                                </Grid>

                                <TextBlock Text="{Binding QualificationReason}"
                                           Foreground="#64748B"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" Background="White" BorderBrush="#DDE4EF" BorderThickness="1,0,1,1" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="Review beneficiary details before adding"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Employee link is optional; approving adds this person to insurance records."
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Command="{Binding RemoveBeneficiaryCommand}"
                                    IsEnabled="{Binding CanRemoveBeneficiary}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{StaticResource ErrorBrush}"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    Height="42"
                                    MinWidth="118"
                                    Padding="14,0"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountRemove" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="REMOVE" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ApproveMemberCommand}"
                                    IsEnabled="{Binding CanApproveMember}"
                                    Background="{StaticResource PrimaryBrush}"
                                    Style="{StaticResource FooterActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="CONFIRM MEMBER" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding LinkCommand}"
                                    IsEnabled="{Binding CanAddBeneficiary}"
                                    Background="{StaticResource SuccessBrush}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="42"
                                    MinWidth="250"
                                    Padding="16,0"
                                    Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding AddMemberButtonText}" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
