<UserControl x:Class="eSureHi.Views.Admin.UserControls.BeneficiariesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:eSureHi.Helpers"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="FooterActionButton" BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <helpers:QRCodeConverter x:Key="QRCodeConverter"/>
    </UserControl.Resources>

    <materialDesign:DialogHost Identifier="BeneficiariesDialogHost" CloseOnClickAway="True">
        <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountSearch"
                                             Width="24"
                                             Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Beneficiaries" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Background="#ECFDF3" CornerRadius="10" Padding="8,2" Margin="12,0,0,0">
                        <TextBlock FontSize="11" Foreground="#2E7D32">
                            <Run Text="{Binding ActiveFilteredCount, Mode=OneWay}"/>
                            <Run Text=" shown"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Reopens the search modal to pick someone else. Hidden while
                         nothing is selected, since the empty state carries its own
                         Search Beneficiary button. -->
                    <Button Click="OpenSearchButton_Click"
                            Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountSearch" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Change Selection" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CreateAccountCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountKey" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Create Account" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BackToDashboardCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Exit" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- Search/select lives in SelectBeneficiaryDialog now (shown through
             BeneficiariesDialogHost above), so this row is the detail panel alone. -->
        <Grid Grid.Row="2" Margin="18">

            <Border Background="White"
                    BorderBrush="#DDE4EF"
                    BorderThickness="1"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                    <materialDesign:PackIcon Kind="AccountDetailsOutline"
                                             Width="64"
                                             Height="64"
                                             Foreground="#CBD5E1"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a beneficiary name"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,6"/>
                    <TextBlock Text="Full CRS/master-list details and the insurance add form will appear here before anything is saved."
                               FontSize="13"
                               Foreground="#64748B"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Click="OpenSearchButton_Click"
                            Background="{StaticResource PrimaryBrush}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            HorizontalAlignment="Center"
                            Height="40"
                            MinWidth="200"
                            Padding="16,0"
                            Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountSearch" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="SEARCH BENEFICIARY" FontSize="13" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="20,16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Beneficiary #" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding SelectedRecord.BeneficiaryId}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <TextBlock Text="Full Name" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding SelectedRecord.DisplayName}" FontSize="17" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,14"/>
                                    <TextBlock Text="Address" Style="{StaticResource InfoLabel}"/>
                                    <TextBlock Text="{Binding ProfileAddress, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                </StackPanel>

                                <UniformGrid Grid.Column="1" Columns="2" Margin="20,0,0,0">
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Sex" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.Sex, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Birth Date" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.DateOfBirth, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Age" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.Age, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Civil Status" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.MaritalStatus, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="CRS ID" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.CivilRegistryId, TargetNullValue='None'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Family Role" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.DemographicFamilyRole, TargetNullValue='Unknown'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Master List Status" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding ProfileStatus}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                </UniformGrid>

                                <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                    <Border CornerRadius="16"
                                            BorderBrush="#94A3B8"
                                            BorderThickness="1"
                                            Padding="14,7"
                                            Background="#F8FAFC"
                                            Margin="0,0,0,10">
                                        <TextBlock Text="{Binding SelectedRecord.LinkStatus}" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                                    </Border>
                                    
                                    <Border CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="5" Background="White" Width="100" Height="100">
                                        <Image Source="{Binding SelectedRecord.BeneficiaryId, Converter={StaticResource QRCodeConverter}}" Stretch="Uniform" ToolTip="Scan for Distribution"/>
                                    </Border>
                                    <Button Content="Print ID" Style="{StaticResource MaterialDesignOutlinedButton}" Click="PrintIdCardBtn_Click" Margin="0,10,0,0" Height="30" FontSize="11" Padding="8,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="20,16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="CRS / Master List Data" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="PWD" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.IsPwd}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="PWD ID" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.PwdIdNo, TargetNullValue='None'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Disability Type" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.DisabilityType, TargetNullValue='None'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Senior Citizen" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.IsSenior}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Senior ID" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.SeniorIdNo, TargetNullValue='None'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Imported" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding SelectedRecord.ImportedAt, StringFormat={}{0:MMM dd, yyyy}}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="20,16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Address, Relationship, and Contact" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Linked Employee" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding ProfileEmployee.FullName, TargetNullValue='No employee linked'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Relationship" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding Relationship}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="Mobile" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding ProfileEmployee.PhoneMobile, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Email" Style="{StaticResource InfoLabel}"/>
                                        <TextBlock Text="{Binding ProfileEmployee.Email, TargetNullValue='Not available'}" Style="{StaticResource InfoValue}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8FAFC" BorderBrush="#DDE4EF" BorderThickness="1" Padding="20,16">
                            <StackPanel>
                                <TextBlock Text="Add to Insurance Records" Style="{StaticResource SectionTitle}"/>
                                <UniformGrid Columns="4" Margin="0,0,0,12">
                                    <TextBox Text="{Binding SelectedRecord.FirstName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="First Name or Name *"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Height="48"
                                             Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding SelectedRecord.LastName, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Last Name (optional)"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Height="48"
                                             Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding SelectedRecord.Sex, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Sex"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Height="48"
                                             Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding SelectedRecord.DateOfBirth, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="Birth Date"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Height="48"/>
                                </UniformGrid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="Family Members" FontWeight="SemiBold" FontSize="14" Foreground="#1E293B"/>
                                                <Border Background="#DCFCE7" CornerRadius="10" Padding="6,2" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding FamilyMembers.Count}" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12" Foreground="#64748B" Margin="0,0,0,8" TextWrapping="Wrap">
                                                <Run Text="All residents sharing Family ID "/>
                                                <Run Text="{Binding SelectedRecord.DemographicFamilyId}" FontWeight="SemiBold"/>
                                            </TextBlock>
                                            <ListBox ItemsSource="{Binding FamilyMembers}" Height="150" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="13" Foreground="#334155" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding FamilyRole}" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="{Binding RegistrationStatusBackground}" CornerRadius="10" Padding="6,2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RegistrationStatus}" Foreground="{Binding RegistrationStatusForeground}" FontSize="10" FontWeight="SemiBold"/>
                                                            </Border>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <ComboBox ItemsSource="{Binding RelationshipOptions}"
                                                  SelectedItem="{Binding Relationship}"
                                                  materialDesign:HintAssist.Hint="Relationship"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Height="48"/>
                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding InsurancePolicies}"
                                                  SelectedItem="{Binding SelectedPolicy}"
                                                  DisplayMemberPath="PolicyName"
                                                  materialDesign:HintAssist.Hint="Insurance Type / Policy"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Height="48"/>

                                        <TextBox Grid.Row="2"
                                                 Text="{Binding CedulaNo, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Cedula No (optional)"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="48"/>
                                        <ComboBox Grid.Row="2"
                                                  Grid.Column="2"
                                                  ItemsSource="{Binding SourceOfFundsOptions}"
                                                  SelectedItem="{Binding SourceOfFunds}"
                                                  materialDesign:HintAssist.Hint="Source of Funds"
                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                  Height="48"/>

                                        <CheckBox Grid.Row="4"
                                                  IsChecked="{Binding Received}"
                                                  Content="Verified for insurance records"
                                                  VerticalAlignment="Center"/>
                                        <TextBox Grid.Row="4"
                                                 Grid.Column="2"
                                                 Text="{Binding Contribution, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                                 materialDesign:HintAssist.Hint="Initial Balance"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="48"/>
                                    </Grid>
                                </Grid>

                                <TextBlock Text="{Binding QualificationReason}"
                                           Foreground="#64748B"
                                           TextWrapping="Wrap"
                                           Margin="0,12,0,0"/>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="{StaticResource ErrorBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"
                                           Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" Background="White" BorderBrush="#DDE4EF" BorderThickness="1,0,1,1" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="Review beneficiary details before adding"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#0F172A"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="Employee link is optional; approving adds this person to insurance records."
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Command="{Binding RemoveBeneficiaryCommand}"
                                    IsEnabled="{Binding CanRemoveBeneficiary}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{StaticResource ErrorBrush}"
                                    BorderBrush="{StaticResource ErrorBrush}"
                                    Height="42"
                                    MinWidth="118"
                                    Padding="14,0"
                                    Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountRemove" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="REMOVE" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ApproveMemberCommand}"
                                    IsEnabled="{Binding CanApproveMember}"
                                    Visibility="{Binding ShowApprovalControls, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{StaticResource PrimaryBrush}"
                                    Style="{StaticResource FooterActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="CONFIRM MEMBER" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding LinkCommand}"
                                    IsEnabled="{Binding CanAddBeneficiary}"
                                    Background="{StaticResource SuccessBrush}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="42"
                                    MinWidth="250"
                                    Padding="16,0"
                                    Margin="0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding AddMemberButtonText}" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </materialDesign:DialogHost>
</UserControl>