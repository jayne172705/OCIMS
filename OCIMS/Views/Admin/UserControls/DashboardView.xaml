<UserControl x:Class="eSureHi.Views.Admin.UserControls.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin">
    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ViewDashboard"
                                             Width="24"
                                             Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="Dashboard"
                                   FontSize="20"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Insurance, beneficiary, funding, and activity records"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="36"
                            Padding="12,0"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding BackToDashboardCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="36"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Exit" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <UniformGrid Grid.Row="2" Columns="5" Margin="22,18,22,12">
            <materialDesign:Card Background="White" Margin="0,0,10,0">
                <StackPanel Margin="16,12">
                    <TextBlock Text="Active Employees" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding ActiveEmployees, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="covered workforce" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Background="White" Margin="0,0,10,0">
                <StackPanel Margin="16,12">
                    <TextBlock Text="Beneficiaries" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalBeneficiaries, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="linked records" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Background="White" Margin="0,0,10,0">
                <StackPanel Margin="16,12">
                    <TextBlock Text="Pending Claims" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding PendingClaims, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#B45309"/>
                    <TextBlock Text="for review" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Background="White" Margin="0,0,10,0">
                <StackPanel Margin="16,12">
                    <TextBlock Text="Premiums Due" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding PremiumsDueFormatted, Mode=OneWay}" FontSize="26" FontWeight="Bold" Foreground="#B91C1C"/>
                    <TextBlock Text="this month" FontSize="11" Foreground="#94A3B8"/>
                </StackPanel>
            </materialDesign:Card>

            <materialDesign:Card Background="White">
                <StackPanel Margin="16,12">
                    <TextBlock Text="GGMS Remaining" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding GgmsRemaining, Mode=OneWay, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="#15803D"/>
                    <TextBlock Text="{Binding GgmsStatus, Mode=OneWay, TargetNullValue=online}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="22,0,22,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Grid.Column="0" Background="White">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Claims by Status" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ClaimStatusItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1"
                                                 Height="10"
                                                 Minimum="0"
                                                 Maximum="120"
                                                 Value="{Binding BarHeight}"
                                                 Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Count}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="0" Grid.Column="2" Background="White">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Premium Status" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding PremiumStatusItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1"
                                                 Height="10"
                                                 Minimum="0"
                                                 Maximum="120"
                                                 Value="{Binding BarHeight}"
                                                 Foreground="#2E8D31"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Count}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Grid.Column="0" Background="White">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Operational Summary" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <UniformGrid Grid.Row="1" Columns="2">
                        <Border Background="#F0FDF4" CornerRadius="6" Padding="14" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Active Policies" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding ActivePolicies, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F0FDF4" CornerRadius="6" Padding="14" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Benefits" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalBenefits, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#FFF7ED" CornerRadius="6" Padding="14" Margin="0,8,8,0">
                            <StackPanel>
                                <TextBlock Text="Documents" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalDocuments, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#F8FAFC" CornerRadius="6" Padding="14" Margin="8,8,0,0">
                            <StackPanel>
                                <TextBlock Text="System Users" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalUsers, Mode=OneWay}" FontSize="24" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>
            </materialDesign:Card>

            <materialDesign:Card Grid.Row="2" Grid.Column="2" Background="White">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Recent Activity" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentActivityItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Action}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TimeAgo}"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
