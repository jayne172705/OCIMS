<UserControl x:Class="eSureHi.Views.Admin.UserControls.DistributionBatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             Background="White">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="LocalBoolToVis"/>

        <!-- ============ Palette ============
             Three status colours drive the whole board. Each has a solid tone for
             text/icons, a tint for header bands, and a soft tone for badges and the
             empty-state medallion. Neutrals are shared across every card. -->
        <SolidColorBrush x:Key="StatusGreen"      Color="#2E7D32"/>
        <SolidColorBrush x:Key="StatusGreenTint"  Color="#E8F5E9"/>
        <SolidColorBrush x:Key="StatusGreenSoft"  Color="#C8E6C9"/>

        <SolidColorBrush x:Key="StatusOrange"     Color="#F57C00"/>
        <SolidColorBrush x:Key="StatusOrangeTint" Color="#FFF3E0"/>
        <SolidColorBrush x:Key="StatusOrangeSoft" Color="#FFE0B2"/>

        <SolidColorBrush x:Key="StatusRed"        Color="#D32F2F"/>
        <SolidColorBrush x:Key="StatusRedTint"    Color="#FFEBEE"/>
        <SolidColorBrush x:Key="StatusRedSoft"    Color="#FFCDD2"/>

        <SolidColorBrush x:Key="InkBrush"         Color="#0F172A"/>
        <SolidColorBrush x:Key="MutedBrush"       Color="#64748B"/>
        <SolidColorBrush x:Key="FaintBrush"       Color="#94A3B8"/>
        <SolidColorBrush x:Key="LineBrush"        Color="#E2E8F0"/>
        <SolidColorBrush x:Key="HairlineBrush"    Color="#EEF2F7"/>
        <SolidColorBrush x:Key="RowLineBrush"     Color="#F1F5F9"/>
        <SolidColorBrush x:Key="CanvasBrush"      Color="#F8FAFC"/>

        <!-- ============ Surfaces ============ -->
        <Style x:Key="SurfaceCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="StatusColumnCard" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <!-- Icon chip: a tinted rounded square holding a single glyph. -->
        <Style x:Key="IconChip" TargetType="Border">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Typography ============ -->
        <Style x:Key="ColumnHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ColumnTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CountBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Stat tiles ============ -->
        <Style x:Key="StatTile" TargetType="Border" BasedOn="{StaticResource SurfaceCard}">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- ============ Buttons ============ -->
        <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="{StaticResource StatusGreen}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StatusGreen}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="SecondaryAction" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>

        <!-- Small square glyph button used for the inline scan affordance. -->
        <Style x:Key="SquareIconButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="PagerButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="ColumnMenuButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ Empty state ============ -->
        <Style x:Key="EmptyStateMedallion" TargetType="Border">
            <Setter Property="Width" Value="104"/>
            <Setter Property="Height" Value="104"/>
            <Setter Property="CornerRadius" Value="52"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EmptyStateGlyph" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="EmptyStateText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,14,0,0"/>
        </Style>

        <!-- ============ Rows ============ -->
        <Style x:Key="RecordRow" TargetType="Border">
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="BorderBrush" Value="{StaticResource RowLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="RecordId" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="RecordName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="RecordNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="RecordDate" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ColumnFooter" TargetType="Border">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background" Value="#FCFDFE"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="CornerRadius" Value="0,0,10,10"/>
        </Style>

        <Style x:Key="FooterText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource FaintBrush}"/>
        </Style>

        <Style x:Key="TableHeaderBand" TargetType="Border">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
        </Style>
    </UserControl.Resources>

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadDataCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <materialDesign:DialogHost Identifier="DistributionDialogHost" CloseOnClickAway="True">
        <Grid Background="{StaticResource CanvasBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title + program + batch action -->
                <RowDefinition Height="Auto"/> <!-- Total funds / search / stat tiles -->
                <RowDefinition Height="*"/>    <!-- Status columns -->
                <RowDefinition Height="Auto"/> <!-- Processing hint -->
            </Grid.RowDefinitions>

            <!-- ============ 1. Page header ============ -->
            <Border Background="White" Padding="30,24" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Distribution Management" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock Text="Manage batch distribution of beneficiaries"
                                   FontSize="13" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Batch parameters (Program, Fund, Amount) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Program -->
                        <Border Style="{StaticResource SurfaceCard}" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="16" Height="16" Foreground="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Program:" FontWeight="Bold" Foreground="{StaticResource InkBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}" Width="110" FontSize="12" FontWeight="SemiBold" Style="{StaticResource MaterialDesignComboBox}" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Source of Fund -->
                        <Border Style="{StaticResource SurfaceCard}" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="WalletOutline" Width="16" Height="16" Foreground="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Fund:" FontWeight="Bold" Foreground="{StaticResource InkBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{Binding SourceFunds}" SelectedValue="{Binding SelectedSourceFundId}" SelectedValuePath="SourceFundId" DisplayMemberPath="FundName" Width="110" FontSize="12" FontWeight="SemiBold" Style="{StaticResource MaterialDesignComboBox}" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Amount -->
                        <Border Style="{StaticResource SurfaceCard}" CornerRadius="8" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CurrencyPhp" Width="16" Height="16" Foreground="{StaticResource StatusGreen}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock Text="Amount:" FontWeight="Bold" Foreground="{StaticResource InkBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding AmountPerBeneficiary, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="80" FontSize="12" FontWeight="SemiBold" Style="{StaticResource MaterialDesignTextBox}" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" BorderThickness="0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Grid.Column="2" Content="Confirm Batch" Command="{Binding ConfirmBatchCommand}"
                            Style="{StaticResource PrimaryAction}" Margin="14,0,0,0"/>
                </Grid>
            </Border>

            <!-- ============ 2. Toolbar card ============ -->
            <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Margin="30,20,30,0" Padding="22,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- wallet chip -->
                        <ColumnDefinition Width="Auto"/> <!-- total funds -->
                        <ColumnDefinition Width="Auto"/> <!-- divider -->
                        <ColumnDefinition Width="1.4*" MinWidth="200"/> <!-- search -->
                        <ColumnDefinition Width="Auto"/> <!-- inline scan -->
                        <ColumnDefinition Width="Auto"/> <!-- search button -->
                        <ColumnDefinition Width="Auto"/> <!-- scan via camera -->
                        <ColumnDefinition Width="*"/>    <!-- flex gap -->
                        <ColumnDefinition Width="Auto"/> <!-- stat tiles -->
                    </Grid.ColumnDefinitions>

                    <!-- Total funds -->
                    <Border Grid.Column="0" Style="{StaticResource IconChip}"
                            Background="{StaticResource StatusGreenTint}" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="WalletOutline" Width="24" Height="24"
                                                 Foreground="{StaticResource StatusGreen}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,22,0">
                        <TextBlock Text="Total Funds" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock Text="{Binding TotalFunds, StringFormat='₱{0:N2}'}"
                                   FontSize="22" FontWeight="Bold" Foreground="{StaticResource StatusGreen}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Width="1" Background="{StaticResource LineBrush}" Margin="0,4,22,4"/>

                    <!-- Search -->
                    <TextBox Grid.Column="3" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Enter beneficiary name / beneficiary ID"
                             MinHeight="44" FontSize="14"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.HasClearButton="True"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             Padding="0,6">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Inline scan affordance; same command as the labelled button below. -->
                    <Button Grid.Column="4" Command="{Binding ScanCameraCommand}"
                            Style="{StaticResource SquareIconButton}" Margin="10,0,0,0"
                            ToolTip="Scan a beneficiary ID">
                        <materialDesign:PackIcon Kind="LineScan" Width="20" Height="20"/>
                    </Button>

                    <Button Grid.Column="5" Content="Search" Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryAction}" Margin="12,0,0,0"/>

                    <Button Grid.Column="6" Command="{Binding ScanCameraCommand}"
                            Style="{StaticResource SecondaryAction}" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Camera" Width="18" Height="18"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Scan via Camera" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Stat tiles: one bordered tile per board column -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalUnreleasedAmount, StringFormat='₱{0:N2}'}" Style="{StaticResource StatNumber}"
                                           Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding UnreleasedRecords.Count, StringFormat='{}{0} Unreleased'}" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalPendingAmount, StringFormat='₱{0:N2}'}" Style="{StaticResource StatNumber}"
                                           Foreground="{StaticResource StatusOrange}"/>
                                <TextBlock Text="{Binding PendingRecords.Count, StringFormat='{}{0} On Hold'}" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalReleasedAmount, StringFormat='₱{0:N2}'}" Style="{StaticResource StatNumber}"
                                           Foreground="{StaticResource StatusGreen}"/>
                                <TextBlock Text="{Binding ReleasedRecords.Count, StringFormat='{}{0} Released'}" Style="{StaticResource StatLabel}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Live status message -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Bottom" Margin="52,0,0,-18">
                <materialDesign:PackIcon Kind="{Binding StatusIconKind}" Foreground="{Binding StatusIconColor}"
                                         Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="Medium"
                           Foreground="{Binding StatusIconColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- ============ 3. Board ============ -->
            <UniformGrid Grid.Row="2" Rows="1" Margin="30,28,16,10">

                <!-- Unreleased -->
                <Border Style="{StaticResource StatusColumnCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource RowLineBrush}" Padding="18,15" CornerRadius="10,10,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Kind="AccountOutline" Width="20" Height="20"
                                                             Foreground="{StaticResource MutedBrush}"
                                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Unreleased" Style="{StaticResource ColumnTitle}"
                                               Foreground="{StaticResource MutedBrush}"/>
                                    <Border Style="{StaticResource CountBadge}" Background="{StaticResource LineBrush}">
                                        <TextBlock Text="{Binding UnreleasedRecords.Count}"
                                                   Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <Button Style="{StaticResource ColumnMenuButton}"
                                        Foreground="{StaticResource MutedBrush}"
                                        Click="DotsButton_Click" ToolTip="Column options">
                                    <materialDesign:PackIcon Kind="DotsHorizontal" Width="20" Height="20"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource TableHeaderBand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="BENEFICIARY ID /" Style="{StaticResource ColumnHeaderLabel}"/>
                                <TextBlock Grid.Column="1" Text="BENEFICIARY NAME" Style="{StaticResource ColumnHeaderLabel}"/>
                                <TextBlock Grid.Column="2" Text="AMOUNT" Style="{StaticResource ColumnHeaderLabel}"/>
                                <TextBlock Grid.Column="3" Text="DATE ADDED" Style="{StaticResource ColumnHeaderLabel}"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <ItemsControl ItemsSource="{Binding UnreleasedRecords}" Margin="0,4"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RecordRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding BeneficiaryId}" Style="{StaticResource RecordId}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BeneficiaryName}" Style="{StaticResource RecordName}"/>
                                                    <TextBlock Text="Waiting to claim" Style="{StaticResource RecordNote}"
                                                               Foreground="{StaticResource StatusOrange}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Style="{StaticResource RecordId}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}">
                                                    <TextBlock.Text>
                                                        <PriorityBinding>
                                                            <Binding Path="Model.Batch.AmountPerBeneficiary" StringFormat="₱{0:N2}"/>
                                                            <Binding Path="DataContext.AmountPerBeneficiary" RelativeSource="{RelativeSource AncestorType=UserControl}" StringFormat="₱{0:N2}"/>
                                                        </PriorityBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Text="—" Style="{StaticResource RecordDate}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                        Visibility="{Binding HasUnreleasedRecords, Converter={StaticResource LocalBoolToVis}, ConverterParameter=Invert}">
                                <Border Style="{StaticResource EmptyStateMedallion}" Background="{StaticResource StatusGreenTint}">
                                    <materialDesign:PackIcon Kind="InboxOutline" Style="{StaticResource EmptyStateGlyph}"
                                                             Foreground="{StaticResource StatusGreen}"/>
                                </Border>
                                <TextBlock Text="No unreleased beneficiaries." Style="{StaticResource EmptyStateText}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource ColumnFooter}">
                            <Grid>
                                <TextBlock Style="{StaticResource FooterText}"
                                           Text="{Binding UnreleasedRecords.Count, StringFormat='Showing {0} of {0}'}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PagerButton}" ToolTip="First page">
                                        <materialDesign:PackIcon Kind="PageFirst" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource PagerButton}" ToolTip="Previous page">
                                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource PagerButton}" ToolTip="Next page">
                                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource PagerButton}" ToolTip="Last page">
                                        <materialDesign:PackIcon Kind="PageLast" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- On Hold Pending -->
                <Border Style="{StaticResource StatusColumnCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource StatusOrangeTint}" Padding="18,15" CornerRadius="10,10,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20"
                                                             Foreground="{StaticResource StatusOrange}"
                                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="On Hold Pending" Style="{StaticResource ColumnTitle}"
                                               Foreground="{StaticResource StatusOrange}"/>
                                    <Border Style="{StaticResource CountBadge}" Background="{StaticResource StatusOrangeSoft}">
                                        <TextBlock Text="{Binding PendingRecords.Count}"
                                                   Foreground="{StaticResource StatusOrange}" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <Button Style="{StaticResource ColumnMenuButton}"
                                        Foreground="{StaticResource StatusOrange}"
                                        Click="DotsButton_Click" ToolTip="Column options">
                                    <materialDesign:PackIcon Kind="DotsHorizontal" Width="20" Height="20"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource TableHeaderBand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="BENEFICIARY ID /" Style="{StaticResource ColumnHeaderLabel}"/>
                                <TextBlock Grid.Column="1" Text="BENEFICIARY NAME" Style="{StaticResource ColumnHeaderLabel}"/>
                                <TextBlock Grid.Column="2" Text="AMOUNT" Style="{StaticResource ColumnHeaderLabel}"/>
                                <TextBlock Grid.Column="3" Text="DATE MOVED" Style="{StaticResource ColumnHeaderLabel}"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <ItemsControl ItemsSource="{Binding PendingRecords}" Margin="0,4"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RecordRow}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding BeneficiaryId}" Style="{StaticResource RecordId}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BeneficiaryName}" Style="{StaticResource RecordName}"/>
                                                    <TextBlock Text="{Binding Remarks, TargetNullValue='Pending verification'}"
                                                               Style="{StaticResource RecordNote}"
                                                               Foreground="{StaticResource StatusOrange}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Style="{StaticResource RecordId}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}">
                                                    <TextBlock.Text>
                                                        <PriorityBinding>
                                                            <Binding Path="Model.Batch.AmountPerBeneficiary" StringFormat="₱{0:N2}"/>
                                                            <Binding Path="DataContext.AmountPerBeneficiary" RelativeSource="{RelativeSource AncestorType=UserControl}" StringFormat="₱{0:N2}"/>
                                                        </PriorityBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Text="{Binding ProcessedAt, StringFormat='{}{0:MMM dd, yyyy}'}"
                                                           Style="{StaticResource RecordDate}"/>
                                                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal"
                                                            HorizontalAlignment="Right" Margin="0,8,0,0"
                                                            Visibility="{Binding DataContext.ShowRowReviewActions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource LocalBoolToVis}}">
                                                    <Button Content="Approve"
                                                            Command="{Binding DataContext.ApproveRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                                            Height="28" Padding="14,0" FontSize="11"
                                                            Background="{StaticResource StatusGreen}"
                                                            BorderBrush="{StaticResource StatusGreen}" Foreground="White"
                                                            materialDesign:ButtonAssist.CornerRadius="8"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                        Visibility="{Binding HasPendingRecords, Converter={StaticResource LocalBoolToVis}, ConverterParameter=Invert}">
                                <Border Style="{StaticResource EmptyStateMedallion}" Background="{StaticResource StatusOrangeTint}">
                                    <materialDesign:PackIcon Kind="InboxOutline" Style="{StaticResource EmptyStateGlyph}"
                                                             Foreground="{StaticResource StatusOrange}"/>
                                </Border>
                                <TextBlock Text="No beneficiaries on hold." Style="{StaticResource EmptyStateText}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource ColumnFooter}">
                            <Grid>
                                <TextBlock Style="{StaticResource FooterText}"
                                           Text="{Binding PendingRecords.Count, StringFormat='Showing {0} of {0}'}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PagerButton}" ToolTip="First page">
                                        <materialDesign:PackIcon Kind="PageFirst" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource PagerButton}" ToolTip="Previous page">
                                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource PagerButton}" ToolTip="Next page">
                                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource PagerButton}" ToolTip="Last page">
                                        <materialDesign:PackIcon Kind="PageLast" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Released -->
                <Border Style="{StaticResource StatusColumnCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource StatusGreenTint}" Padding="18,15" CornerRadius="10,10,0,0">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="20" Height="20"
                                                             Foreground="{StaticResource StatusGreen}"
                                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Released" Style="{StaticResource ColumnTitle}"
                                               Foreground="{StaticResource StatusGreen}"/>
                                    <Border Style="{StaticResource CountBadge}" Background="{StaticResource StatusGreenSoft}">
                                        <TextBlock Text="{Binding ReleasedRecords.Count}"
                                                   Foreground="{StaticResource StatusGreen}" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <Button Style="{StaticResource ColumnMenuButton}"
                                        Foreground="{StaticResource StatusGreen}"
                                        Click="DotsButton_Click" ToolTip="Column options">
                                    <materialDesign:PackIcon Kind="DotsHorizontal" Width="20" Height="20"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource TableHeaderBand}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="BENEFICIARY ID /" Style="{StaticResource ColumnHeaderLabel}"/>
                                <TextBlock Grid.Column="1" Text="BENEFICIARY NAME" Style="{StaticResource ColumnHeaderLabel}"/>
                                <TextBlock Grid.Column="2" Text="AMOUNT" Style="{StaticResource ColumnHeaderLabel}"/>
                                <TextBlock Grid.Column="3" Text="DATE RELEASED" Style="{StaticResource ColumnHeaderLabel}"/>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <ItemsControl ItemsSource="{Binding ReleasedRecords}" Margin="0,4"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource RecordRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding BeneficiaryId}" Style="{StaticResource RecordId}"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding BeneficiaryName}" Style="{StaticResource RecordName}"/>
                                                    <TextBlock Text="{Binding Remarks, TargetNullValue='Released'}"
                                                               Style="{StaticResource RecordNote}"
                                                               Foreground="{StaticResource StatusGreen}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Style="{StaticResource RecordId}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}">
                                                    <TextBlock.Text>
                                                        <PriorityBinding>
                                                            <Binding Path="Model.Batch.AmountPerBeneficiary" StringFormat="₱{0:N2}"/>
                                                            <Binding Path="DataContext.AmountPerBeneficiary" RelativeSource="{RelativeSource AncestorType=UserControl}" StringFormat="₱{0:N2}"/>
                                                        </PriorityBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Grid.Column="3" Text="{Binding ProcessedAt, StringFormat='{}{0:MMM dd, yyyy}'}"
                                                           Style="{StaticResource RecordDate}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                        Visibility="{Binding HasReleasedRecords, Converter={StaticResource LocalBoolToVis}, ConverterParameter=Invert}">
                                <Border Style="{StaticResource EmptyStateMedallion}" Background="{StaticResource StatusGreenTint}">
                                    <materialDesign:PackIcon Kind="InboxOutline" Style="{StaticResource EmptyStateGlyph}"
                                                             Foreground="{StaticResource StatusGreen}"/>
                                </Border>
                                <TextBlock Text="No released beneficiaries." Style="{StaticResource EmptyStateText}"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="3" Style="{StaticResource ColumnFooter}">
                            <Grid>
                                <TextBlock Style="{StaticResource FooterText}"
                                           Text="{Binding ReleasedRecords.Count, StringFormat='Showing {0} of {0}'}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PagerButton}" ToolTip="First page">
                                        <materialDesign:PackIcon Kind="PageFirst" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource PagerButton}" ToolTip="Previous page">
                                        <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource PagerButton}" ToolTip="Next page">
                                        <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource PagerButton}" ToolTip="Last page">
                                        <materialDesign:PackIcon Kind="PageLast" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- ============ 4. Processing hint ============ -->
            <Border Grid.Row="3" Style="{StaticResource SurfaceCard}" Margin="30,0,30,20" Padding="18,13">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                             Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="Search or scan a beneficiary to release or hold their distribution."
                               FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>
