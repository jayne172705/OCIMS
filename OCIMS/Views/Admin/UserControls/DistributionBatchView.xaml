<UserControl x:Class="eSureHi.Views.Admin.UserControls.DistributionBatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             Background="White">

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadDataCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <materialDesign:DialogHost Identifier="DistributionDialogHost" CloseOnClickAway="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Batch Info & Actions -->
                <RowDefinition Height="Auto"/> <!-- Search/Scan -->
                <RowDefinition Height="*"/>    <!-- 3 Columns -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar (Green) -->
            <Border Background="#2E7D32" Padding="15,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#2E7D32"/>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="36" Height="36" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="24" Height="24"/>
                    </Button>
                    
                    <TextBlock Grid.Column="1" Text="Distribution Management" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    
                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignToolButton}" Foreground="White" Width="36" Height="36">
                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 2. Batch Info Row & Action Buttons -->
            <Border Grid.Row="1" Padding="20,15" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Batch Info -->
                    <StackPanel>
                        <TextBlock Text="{Binding ProjectTitle, TargetNullValue='New Distribution Batch'}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ProjectDescription, TargetNullValue='Program Type'}" FontSize="14" Foreground="#475569" Margin="0,0,10,0"/>
                            <TextBlock Text="•" FontSize="14" Foreground="#94A3B8" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding AmountPerBeneficiary, StringFormat='₱{0:N2} / beneficiary'}" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,10,0"/>
                            <TextBlock Text="•" FontSize="14" Foreground="#94A3B8" Margin="0,0,10,0"/>
                            <!-- Fund Name and Balance -->
                            <TextBlock FontSize="14">
                                <Hyperlink Command="{Binding ViewFundCommand}" TextDecorations="None" Foreground="#2E7D32">
                                    <Run Text="{Binding SelectedSourceFundName, TargetNullValue='Select Fund'}"/>
                                </Hyperlink>
                                <Run Text=" "/>
                                <Run Text="{Binding RemainingFundBalance, StringFormat='(₱{0:N2} remaining)'}" Foreground="#64748B"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Program / track selector -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="AccountSwitch" Width="18" Height="18" Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Program:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding Programs}"
                                      SelectedItem="{Binding SelectedProgram, Mode=TwoWay}"
                                      materialDesign:HintAssist.Hint="Program"
                                      MinWidth="150" MaxWidth="260" Height="46"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </Grid>
                    </StackPanel>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="Confirm Batch" Command="{Binding ConfirmBatchCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#2E7D32" BorderBrush="#2E7D32" Foreground="White" Margin="0,0,8,0" Height="36"/>
                        <Button Content="Rename" Command="{Binding RenameBatchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" Height="36"/>
                        <Button Content="Reuse Batch" Command="{Binding ReuseBatchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" Height="36"/>
                        <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Refresh" Margin="0,0,8,0" Width="36" Height="36">
                            <materialDesign:PackIcon Kind="Refresh"/>
                        </Button>
                        <Button Content="Delete Batch" Command="{Binding DeleteBatchCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#D32F2F" BorderBrush="#D32F2F" Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Search Bar & Status -->
            <Border Grid.Row="2" Padding="20,15" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" MinWidth="200"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Type Beneficiary ID / SC Code..."
                             Height="46" FontSize="15"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:TextFieldAssist.HasClearButton="True">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="2" Content="Process" Command="{Binding SearchCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Height="42"/>

                    <Button Grid.Column="4" Command="{Binding ScanCameraCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="42" Foreground="#0F172A" BorderBrush="#CBD5E1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Camera" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="Scan via Camera"/>
                        </StackPanel>
                    </Button>

                    <!-- Live Status Message -->
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="{Binding StatusIconKind}" Foreground="{Binding StatusIconColor}" Width="20" Height="20" Margin="0,0,8,0" Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="15" FontWeight="Medium" Foreground="{Binding StatusIconColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Running Counter -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ReleasedRecords.Count, StringFormat='{}{0} released'}" Foreground="#166534" FontWeight="SemiBold" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding UnreleasedRecords.Count, StringFormat='{}{0} unreleased'}" Foreground="#9A3412" FontWeight="SemiBold" Margin="0,0,15,0"/>
                        <TextBlock Text="{Binding PendingRecords.Count, StringFormat='{}{0} on hold'}" Foreground="#991B1B" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 4. Three-Column Board -->
            <Grid Grid.Row="3" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Column 1: Released -->
                <Border Grid.Column="0" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#DCFCE7" Padding="15,12" CornerRadius="6,6,0,0" BorderBrush="#BBF7D0" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Released" FontWeight="Bold" Foreground="#166534" FontSize="15"/>
                                <Border Background="#BBF7D0" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ReleasedRecords.Count}" Foreground="#166534" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ListView Grid.Row="1" ItemsSource="{Binding ReleasedRecords}" Margin="10" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding BeneficiaryName}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding BeneficiaryId}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding ProcessedAt, StringFormat='{}{0:MMM dd, yyyy h:mm tt}'}" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding DataContext.UndoRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconForegroundButton}" ToolTip="Undo Release" Width="28" Height="28" Padding="0" Foreground="#64748B">
                                                <materialDesign:PackIcon Kind="Undo" Width="18" Height="18"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Column 2: Unreleased -->
                <Border Grid.Column="2" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#FFEDD5" Padding="15,12" CornerRadius="6,6,0,0" BorderBrush="#FED7AA" BorderThickness="0,0,0,1">
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Unreleased" FontWeight="Bold" Foreground="#9A3412" FontSize="15"/>
                                        <Border Background="#FED7AA" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding UnreleasedRecords.Count}" Foreground="#9A3412" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Auto-listed from active beneficiaries" FontSize="11" Foreground="#C2410C" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ListView Grid.Row="1" ItemsSource="{Binding UnreleasedRecords}" Margin="10" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding BeneficiaryName}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding BeneficiaryId}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                                <TextBlock Text="Waiting to claim" FontSize="11" Foreground="#F59E0B" Margin="0,4,0,0" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Column 3: On Hold Pending -->
                <Border Grid.Column="4" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#FEE2E2" Padding="15,12" CornerRadius="6,6,0,0" BorderBrush="#FECACA" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="On Hold Pending" FontWeight="Bold" Foreground="#991B1B" FontSize="15"/>
                                <Border Background="#FECACA" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding PendingRecords.Count}" Foreground="#991B1B" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ListView Grid.Row="1" ItemsSource="{Binding PendingRecords}" Margin="10" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding BeneficiaryName}" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                                                <TextBlock Text="{Binding BeneficiaryId}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Remarks, TargetNullValue='Pending verification'}" FontSize="11" Foreground="#EF4444" Margin="0,4,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding DataContext.UndoRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconForegroundButton}" ToolTip="Undo Hold" Width="28" Height="28" Padding="0" Foreground="#64748B">
                                                <materialDesign:PackIcon Kind="Undo" Width="18" Height="18"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>