<UserControl x:Class="eSureHi.Views.Admin.UserControls.DistributionBatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             Background="White">

    <UserControl.Resources>
        <helpers:BoolToVisibilityConverter x:Key="LocalBoolToVis"/>

        <Style x:Key="ColumnHeaderLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusColumnCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
        </Style>

        <Style x:Key="PagerButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
        </Style>
    </UserControl.Resources>

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadDataCommand}"/>
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <materialDesign:DialogHost Identifier="DistributionDialogHost" CloseOnClickAway="True">
        <Grid Background="#F8FAFC">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title + batch actions -->
                <RowDefinition Height="Auto"/> <!-- Total Funds / search / counters -->
                <RowDefinition Height="*"/>    <!-- Status columns -->
                <RowDefinition Height="Auto"/> <!-- Processing hint -->
            </Grid.RowDefinitions>

                <!-- 1. White header with title and Program selection -->
                <Border Background="White" Padding="30,22" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Distribution Management" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="Manage batch distribution of beneficiaries"
                                       FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Program Selector Card -->
                        <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,8" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20" Foreground="#166534" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Program:" FontWeight="Bold" Foreground="#0F172A" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding Programs}" SelectedItem="{Binding SelectedProgram}"
                                          Width="180" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"
                                          Style="{StaticResource MaterialDesignComboBox}"
                                          materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                                          BorderThickness="0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button Grid.Column="2" Content="Confirm Batch" Command="{Binding ConfirmBatchCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#166534" BorderBrush="#166534" Foreground="White"
                                Height="44" Padding="22,0" Margin="14,0,0,0" VerticalAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="6"/>
                    </Grid>
                </Border>

                <!-- 2. Total Funds + Search + Scan + Counters -->
                <Border Grid.Row="1" Background="White" CornerRadius="10" Margin="30,20,30,0"
                        Padding="22,18" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1.4*" MinWidth="200"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Funds rollup -->
                        <materialDesign:PackIcon Grid.Column="0" Kind="WalletOutline" Width="30" Height="30"
                                                 Foreground="#166534" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,22,0">
                            <TextBlock Text="Total Funds" FontSize="12" Foreground="#64748B"/>
                            <TextBlock Text="{Binding TotalFunds, StringFormat='₱{0:N2}'}"
                                       FontSize="22" FontWeight="Bold" Foreground="#166534"/>
                        </StackPanel>

                        <Border Grid.Column="1" Width="1" Background="#E2E8F0" HorizontalAlignment="Right" Margin="0,4"/>

                        <!-- Search -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Enter beneficiary name / beneficiary ID"
                                     Height="44" FontSize="14"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:TextFieldAssist.HasClearButton="True"
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                     VerticalAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </StackPanel>

                        <Button Grid.Column="4" Content="Search" Command="{Binding SearchCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#166534" BorderBrush="#166534" Foreground="White"
                                Height="44" Padding="22,0" VerticalAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="6"/>

                        <Button Grid.Column="6" Command="{Binding ScanCameraCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="44" Padding="18,0" VerticalAlignment="Center"
                                Foreground="#0F172A" BorderBrush="#CBD5E1"
                                materialDesign:ButtonAssist.CornerRadius="6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Camera" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Scan via Camera" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Counter tiles -->
                        <Border Grid.Column="8" Background="White" CornerRadius="8" BorderBrush="#E2E8F0"
                                BorderThickness="1" Padding="22,12" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,26,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ReleasedRecords.Count}" FontSize="22" FontWeight="Bold"
                                               Foreground="#166534" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Released" FontSize="11" FontWeight="Bold" Foreground="#166534" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,26,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UnreleasedRecords.Count}" FontSize="22" FontWeight="Bold"
                                               Foreground="#166534" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Unreleased" FontSize="11" FontWeight="Bold" Foreground="#166534" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,26,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PendingRecords.Count}" FontSize="22" FontWeight="Bold"
                                               Foreground="#D97706" HorizontalAlignment="Center"/>
                                    <TextBlock Text="On Hold" FontSize="11" FontWeight="Bold" Foreground="#D97706" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding RejectedRecords.Count}" FontSize="22" FontWeight="Bold"
                                               Foreground="#DC2626" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Rejected" FontSize="11" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Live status message -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"
                            VerticalAlignment="Bottom" Margin="52,0,0,-18">
                    <materialDesign:PackIcon Kind="{Binding StatusIconKind}" Foreground="{Binding StatusIconColor}"
                                             Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"
                                             Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="Medium"
                               Foreground="{Binding StatusIconColor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Kanban Board Grid -->
                <UniformGrid Grid.Row="2" Rows="1" Margin="30,28,16,10">
                    <!-- Unreleased -->
                    <Border Style="{StaticResource StatusColumnCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="#F0FDF4" Padding="18,15" CornerRadius="9,9,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20"
                                                                 Foreground="#166534" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="Unreleased" FontWeight="Bold" Foreground="#166534" FontSize="16" VerticalAlignment="Center"/>
                                        <Border Background="#DCFCE7" CornerRadius="10" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UnreleasedRecords.Count}" Foreground="#166534" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Padding="18,10" Background="White" BorderBrush="#EEF2F7" BorderThickness="0,1,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BENEFICIARY ID /" Style="{StaticResource ColumnHeaderLabel}"/>
                                    <TextBlock Grid.Column="1" Text="BENEFICIARY NAME" Style="{StaticResource ColumnHeaderLabel}"/>
                                    <TextBlock Grid.Column="2" Text="DATE ADDED" Style="{StaticResource ColumnHeaderLabel}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <ItemsControl ItemsSource="{Binding UnreleasedRecords}" Margin="0,4"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="18,11" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding BeneficiaryId}" FontSize="12" Foreground="#475569"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BeneficiaryName}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="Waiting to claim" FontSize="10" Foreground="#D97706" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="—" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                            Visibility="{Binding HasUnreleasedRecords, Converter={StaticResource LocalBoolToVis}, ConverterParameter=Invert}">
                                    <materialDesign:PackIcon Kind="InboxOutline" Width="58" Height="58"
                                                             Foreground="#86EFAC" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No unreleased beneficiaries." FontSize="14" FontWeight="SemiBold"
                                               Foreground="#334155" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="3" Padding="18,12" Background="#FCFDFE" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,9,9">
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8"
                                               Text="{Binding UnreleasedRecords.Count, StringFormat='Showing {0} of {0}'}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- On Hold Pending -->
                    <Border Style="{StaticResource StatusColumnCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="#FFFBEB" Padding="18,15" CornerRadius="9,9,0,0">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20"
                                                                 Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Text="On Hold Pending" FontWeight="Bold" Foreground="#B45309" FontSize="16" VerticalAlignment="Center"/>
                                        <Border Background="#FEF3C7" CornerRadius="10" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PendingRecords.Count}" Foreground="#B45309" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Padding="18,10" Background="White" BorderBrush="#EEF2F7" BorderThickness="0,1,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BENEFICIARY ID /" Style="{StaticResource ColumnHeaderLabel}"/>
                                    <TextBlock Grid.Column="1" Text="BENEFICIARY NAME" Style="{StaticResource ColumnHeaderLabel}"/>
                                    <TextBlock Grid.Column="2" Text="DATE MOVED" Style="{StaticResource ColumnHeaderLabel}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <ItemsControl ItemsSource="{Binding PendingRecords}" Margin="0,4"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="18,11" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding BeneficiaryId}" FontSize="12" Foreground="#475569"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BeneficiaryName}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Remarks, TargetNullValue='Pending verification'}"
                                                                   FontSize="10" Foreground="#D97706" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding ProcessedAt, StringFormat='{}{0:MMM dd, yyyy}'}"
                                                               FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal"
                                                                HorizontalAlignment="Right" Margin="0,8,0,0"
                                                                Visibility="{Binding DataContext.ShowRowReviewActions, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource LocalBoolToVis}}">
                                                        <Button Content="Reject"
                                                                Command="{Binding DataContext.RejectRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="26" Padding="12,0" FontSize="11"
                                                                Foreground="#DC2626" BorderBrush="#FCA5A5" Margin="0,0,8,0"/>
                                                        <Button Content="Approve"
                                                                Command="{Binding DataContext.ApproveRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource MaterialDesignRaisedButton}" Height="26" Padding="12,0" FontSize="11"
                                                                Background="#166534" BorderBrush="#166534" Foreground="White"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                            Visibility="{Binding HasPendingRecords, Converter={StaticResource LocalBoolToVis}, ConverterParameter=Invert}">
                                    <materialDesign:PackIcon Kind="InboxOutline" Width="58" Height="58"
                                                             Foreground="#FCD34D" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No beneficiaries on hold." FontSize="14" FontWeight="SemiBold"
                                               Foreground="#334155" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="3" Padding="18,12" Background="#FCFDFE" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,9,9">
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8"
                                               Text="{Binding PendingRecords.Count, StringFormat='Showing {0} of {0}'}"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Rejected -->
                    <Border Style="{StaticResource StatusColumnCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="#FEF2F2" Padding="18,15" CornerRadius="9,9,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <materialDesign:PackIcon Kind="CloseCircleOutline" Width="20" Height="20"
                                                             Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Rejected" FontWeight="Bold" Foreground="#B91C1C" FontSize="16" VerticalAlignment="Center"/>
                                    <Border Background="#FEE2E2" CornerRadius="10" Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RejectedRecords.Count}" Foreground="#B91C1C" FontSize="12" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Padding="18,10" Background="White" BorderBrush="#EEF2F7" BorderThickness="0,1,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.1*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BENEFICIARY ID /" Style="{StaticResource ColumnHeaderLabel}"/>
                                    <TextBlock Grid.Column="1" Text="BENEFICIARY NAME" Style="{StaticResource ColumnHeaderLabel}"/>
                                    <TextBlock Grid.Column="2" Text="DATE REJECTED" Style="{StaticResource ColumnHeaderLabel}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="2">
                                <ItemsControl ItemsSource="{Binding RejectedRecords}" Margin="0,4"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl.Template>
                                        <ControlTemplate TargetType="ItemsControl">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="18,11" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="1.2*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding BeneficiaryId}" FontSize="12" Foreground="#475569"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding BeneficiaryName}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Remarks, TargetNullValue='Rejected'}"
                                                                   FontSize="10" Foreground="#DC2626" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding ProcessedAt, StringFormat='{}{0:MMM dd, yyyy}'}"
                                                               FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16"
                                            Visibility="{Binding HasRejectedRecords, Converter={StaticResource LocalBoolToVis}, ConverterParameter=Invert}">
                                    <materialDesign:PackIcon Kind="InboxOutline" Width="58" Height="58"
                                                             Foreground="#FCA5A5" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No rejected beneficiaries." FontSize="14" FontWeight="SemiBold"
                                               Foreground="#334155" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="3" Padding="18,12" Background="#FCFDFE" BorderBrush="#EEF2F7" BorderThickness="0,1,0,0"
                                    CornerRadius="0,0,9,9">
                                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8"
                                           Text="{Binding RejectedRecords.Count, StringFormat='Showing {0} of {0}'}"/>
                            </Border>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- 4. Processing hint -->
                <Border Grid.Row="3" Background="White" CornerRadius="9" Margin="30,0,30,20" Padding="18,13"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                                 Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Search or scan a beneficiary to release, hold, or reject their distribution."
                                   FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
        </Grid>
    </materialDesign:DialogHost>
</UserControl>
