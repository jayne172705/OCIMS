<UserControl x:Class="eSureHi.Views.Admin.UserControls.EmployeeDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin">
    <UserControl.DataContext>
        <vm:EmployeeDashboardViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE4EF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE4EF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="QuickActionButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#2D4B71"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionRoot" Background="{TemplateBinding Background}" helpers:Adaptive.UseAdaptiveForeground="True"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionRoot" Property="Background" Value="#2D4B71"/>
                                <Setter TargetName="ActionRoot" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionRoot" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="4"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ProgressBar Grid.Row="0"
                     IsIndeterminate="True"
                     Foreground="#0EA5E9"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Border CornerRadius="24"
                        Padding="24" Background="#0F172A" helpers:Adaptive.UseAdaptiveForeground="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="1.1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Border Width="54"
                                    Height="54"
                                    CornerRadius="27" Background="#166534" helpers:Adaptive.UseAdaptiveForeground="True"
                                    HorizontalAlignment="Left">
                                <materialDesign:PackIcon Kind="AccountHeartOutline"
                                                         Width="28"
                                                         Height="28"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Margin="0,18,0,0"
                                       FontSize="30"
                                       FontWeight="Bold">
                                <Run Text="Welcome back, "/>
                                <Run Text="{Binding WelcomeName, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="This employee dashboard focuses on your own policies, claims, benefits, and notices."
                                       Margin="0,8,0,0"
                                       FontSize="14"
                                       TextWrapping="Wrap"/>

                            <WrapPanel Margin="0,18,0,0">
                                <Border Background="#172554" helpers:Adaptive.UseAdaptiveForeground="True"
                                        CornerRadius="14"
                                        Padding="10,6"
                                        Margin="0,0,10,10">
                                    <TextBlock Text="{Binding EmployeeNumber, Mode=OneWay}"
                                               Foreground="#DCFCE7"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#0F766E" helpers:Adaptive.UseAdaptiveForeground="True"
                                        CornerRadius="14"
                                        Padding="10,6"
                                        Margin="0,0,10,10">
                                    <TextBlock Text="{Binding DepartmentName, Mode=OneWay}"
                                               Foreground="#CCFBF1"
                                               FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="#7C2D12" helpers:Adaptive.UseAdaptiveForeground="True"
                                        CornerRadius="14"
                                        Padding="10,6"
                                        Margin="0,0,10,10">
                                    <TextBlock Text="{Binding EmployeeRole, Mode=OneWay}"
                                               Foreground="#FFEDD5"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Margin="0,18,0,0"
                                       FontSize="13"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                CornerRadius="20"
                                Padding="18" Background="#111827" helpers:Adaptive.UseAdaptiveForeground="True"
                                BorderBrush="#334155"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Today"
                                           FontSize="13"
                                           Foreground="#93C5FD"/>
                                <TextBlock Text="{Binding TodayDisplay, Mode=OneWay}"
                                           Margin="0,6,0,0"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding EmployeeFullName, Mode=OneWay}"
                                           Margin="0,18,0,0"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding EmploymentSummary, Mode=OneWay}"
                                           Margin="0,6,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>

                                <Button Command="{Binding RefreshCommand}"
                                        Margin="0,18,0,0"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#0EA5E9"
                                        Content="Refresh dashboard"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <UniformGrid Margin="0,18,0,6"
                             Columns="4">
                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Assigned Policies"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding AssignedPolicies}"
                                       Margin="0,8,0,0"
                                       FontSize="28"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Active coverage records linked to your account."
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Pending Claims"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding PendingClaims}"
                                       Margin="0,8,0,0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#F59E0B"/>
                            <TextBlock Text="Draft, submitted, or under-review claims awaiting movement."
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Benefits Available"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding AvailableBenefits}"
                                       Margin="0,8,0,0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#2DD4BF"/>
                            <TextBlock Text="Benefit entries that still have remaining usable coverage."
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Outstanding Balance"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding OutstandingBalanceFormatted, Mode=OneWay}"
                                       Margin="0,8,0,0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#7C3AED"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding UnreadNotifications, StringFormat={}{0} unread notification(s) waiting for review.}"
                                       Margin="0,6,0,0"
                                       FontSize="11"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Recent Claim Updates"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Your latest claim movements and status changes."
                                       Margin="0,4,0,16"
                                       FontSize="12"/>

                            <StackPanel Visibility="{Binding HasClaimUpdates, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding ClaimUpdates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10"
                                                         Height="10"
                                                         Margin="0,5,12,0"
                                                         Fill="{Binding DotHex, Converter={StaticResource HexToBrushConverter}}"
                                                         VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Caption}"
                                                               Margin="0,3,0,0"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TimeText}"
                                                           FontSize="11"
                                                           Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Visibility="{Binding HasClaimUpdates, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" Background="#1C3A5E" helpers:Adaptive.UseAdaptiveForeground="True"
                                    CornerRadius="16"
                                    Padding="16">
                                <TextBlock Text="No claim activity yet. Submit or update a claim to see it here."
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Notifications"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Recent reminders and account updates sent to you."
                                       Margin="0,4,0,16"
                                       FontSize="12"/>

                            <StackPanel Visibility="{Binding HasNotificationUpdates, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding NotificationUpdates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="10"
                                                         Height="10"
                                                         Margin="0,5,12,0"
                                                         Fill="{Binding DotHex, Converter={StaticResource HexToBrushConverter}}"
                                                         VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Caption}"
                                                               Margin="0,3,0,0"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding TimeText}"
                                                           FontSize="11"
                                                           Margin="12,0,0,0"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Visibility="{Binding HasNotificationUpdates, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" Background="#1C3A5E" helpers:Adaptive.UseAdaptiveForeground="True"
                                    CornerRadius="16"
                                    Padding="16">
                                <TextBlock Text="No recent notifications. You are all caught up."
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4"
                            Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Quick Actions"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Jump straight to the pages you use most."
                                       Margin="0,4,0,16"
                                       FontSize="12"/>

                            <Button Command="{Binding OpenMyProfileCommand}"
                                    Style="{StaticResource QuickActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#DCFCE7" helpers:Adaptive.UseAdaptiveForeground="True">
                                        <materialDesign:PackIcon Kind="AccountCircleOutline" Width="22" Height="22" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="My Profile" FontWeight="SemiBold"/>
                                        <TextBlock Text="Update personal and employment details." Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Command="{Binding OpenMyPoliciesCommand}"
                                    Style="{StaticResource QuickActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#DCFCE7" helpers:Adaptive.UseAdaptiveForeground="True">
                                        <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="22" Height="22" Foreground="#81C784" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="My Policies" FontWeight="SemiBold"/>
                                        <TextBlock Text="Open your insurance coverage summary." Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Command="{Binding OpenMyClaimsCommand}"
                                    Style="{StaticResource QuickActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#FFEDD5" helpers:Adaptive.UseAdaptiveForeground="True">
                                        <materialDesign:PackIcon Kind="ClipboardPulseOutline" Width="22" Height="22" Foreground="#FFB74D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="My Claims" FontWeight="SemiBold"/>
                                        <TextBlock Text="Review submissions and claim progress." Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Command="{Binding OpenMyPremiumsCommand}"
                                    Style="{StaticResource QuickActionButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#F3E8FF" helpers:Adaptive.UseAdaptiveForeground="True">
                                        <materialDesign:PackIcon Kind="CashClock" Width="22" Height="22" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="My Premiums" FontWeight="SemiBold"/>
                                        <TextBlock Text="Check due dates and balances." Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button Command="{Binding OpenMyBenefitsCommand}"
                                    Style="{StaticResource QuickActionButtonStyle}"
                                    Margin="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="12" Background="#CCFBF1" helpers:Adaptive.UseAdaptiveForeground="True">
                                        <materialDesign:PackIcon Kind="HeartPlus" Width="22" Height="22" Foreground="#4DB6AC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="My Benefits" FontWeight="SemiBold"/>
                                        <TextBlock Text="View remaining benefit availability." Margin="0,3,0,0" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
