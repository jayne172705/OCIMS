<UserControl x:Class="eSureHi.Views.Admin.UserControls.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin">
    <UserControl.DataContext>
        <vm:EmployeesViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Page Header ── -->
        <Border Grid.Row="0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountGroup"
                                             Width="24" Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Employees"
                               FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True" CornerRadius="10"
                            Padding="8,2" Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="White">
                            <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                            <Run Text="of"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    
                    <!-- Create Account -->
                    <Button Command="{Binding CreateAccountCommand}"
        Height="34" Padding="12,0" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Background" Value="#2E7D32"/>
                                <Setter Property="Opacity" Value="0.45"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountKey"
                                 Width="16" Height="16"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                            <TextBlock Text="Create Account" FontSize="12"
                   FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ManageAccessCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldAccount"
                                                     Width="16" Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Manage Access"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh"
                                                     Width="16" Height="16"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" FontSize="12"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddCommand}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34" Padding="16,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlus"
                                                     Width="16" Height="16"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Add Employee" FontSize="12"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding BackToDashboardCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close"
                                                     Width="16" Height="16"
                                                     Margin="0,0,8,0"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Exit" FontSize="12"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Loading Bar ── -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True"
                     Height="3"
                     Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsLoading,
                         Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ── Filters ── -->
        <Border Grid.Row="2" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                BorderBrush="#DDE4EF" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Search name, number, email..."
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Height="46" FontSize="12"/>

                <!-- Status Filter -->
                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding StatusFilter}"
                          materialDesign:HintAssist.Hint="Status"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Height="46" FontSize="12"/>

                <!-- Dept Filter -->
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding Departments}"
                          SelectedItem="{Binding DeptFilter}"
                          DisplayMemberPath="DeptName"
                          materialDesign:HintAssist.Hint="All Departments"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Height="46" FontSize="12"/>

                <!-- Clear -->
                <Button Grid.Column="6"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Foreground="{StaticResource PrimaryBrush}" Height="46"
                        ToolTip="Clear filters">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterRemove"
                                                 Width="16" Height="16"
                                                 Margin="0,0,4,0"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Clear" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── DataGrid ── -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding DisplayedEmployees}"
                  SelectedItem="{Binding SelectedEmployee}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E5EAF2"
                  RowHeight="48"
                  BorderThickness="0"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#F8FAFC"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                  Style="{StaticResource ReadableDataGrid}">

            <DataGrid.Columns>

                <!-- Household/Resident ID -->
                <DataGridTextColumn Header="Household/Resident ID"
                                    Binding="{Binding EmployeeNo}"
                                    Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Full Name -->
                <DataGridTextColumn Header="Full Name"
                                    Binding="{Binding FullName}"
                                    Width="220">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Department -->
                <DataGridTextColumn Header="Department"
                                    Binding="{Binding Department.DeptName}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Position -->
                <DataGridTextColumn Header="Position"
                                    Binding="{Binding PositionTitle}"
                                    Width="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Employment Type -->
                <DataGridTextColumn Header="Type"
                                    Binding="{Binding EmploymentType}"
                                    Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Status Badge -->
                <DataGridTemplateColumn Header="Status" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="10,3"
                                    HorizontalAlignment="Left"
                                    Margin="0,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EmploymentStatus}"
                                                         Value="Active">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EmploymentStatus}"
                                                         Value="Inactive">
                                                <Setter Property="Background" Value="#EEEEEE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EmploymentStatus}"
                                                         Value="Retired">
                                                <Setter Property="Background" Value="#ECFDF3"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EmploymentStatus}"
                                                         Value="Resigned">
                                                <Setter Property="Background" Value="#FFF3E0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EmploymentStatus}"
                                                         Value="Terminated">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding EmploymentStatus}"
                                           FontSize="11" FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EmploymentStatus}"
                                                             Value="Active">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EmploymentStatus}"
                                                             Value="Terminated">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EmploymentStatus}"
                                                             Value="Resigned">
                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding EmploymentStatus}"
                                                             Value="Retired">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Date Hired -->
                <DataGridTextColumn Header="Date Hired"
                    Binding="{Binding DateHired, StringFormat={}{0:MMM dd, yyyy}}"
                    Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="0,0"/>
                            <Setter Property="Foreground" Value="#334155"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Actions -->
                <DataGridTemplateColumn Header="Actions" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="-8,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0.50"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected,
                RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding DataContext.ViewSummaryCommand,
                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        ToolTip="View Summary"
                        Width="32" Height="32"
                        Foreground="#64748B">
                                    <materialDesign:PackIcon Kind="Eye" Width="16" Height="16"/>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding DataContext.EditCommand,
                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        ToolTip="Edit"
                        Width="32" Height="32"
                        Foreground="{StaticResource PrimaryBrush}">
                                    <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding DataContext.DeactivateCommand,
                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        ToolTip="Deactivate"
                        Width="32" Height="32"
                        Foreground="{StaticResource ErrorBrush}">
                                    <materialDesign:PackIcon Kind="AccountOff" Width="16" Height="16"/>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignIconButton}"
                        Command="{Binding DataContext.DeleteEmployeeCommand,
                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                        CommandParameter="{Binding}"
                        ToolTip="Delete permanently"
                        Width="32" Height="32"
                        Foreground="#C62828">
                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                                </Button>

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Status Bar ── -->
        <Border Grid.Row="4" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock FontSize="11">
                <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                <Run Text="employee(s) shown"/>
                <Run Text=" · Double-click a row to edit"/>
            </TextBlock>
        </Border>

    </Grid>
</UserControl>
