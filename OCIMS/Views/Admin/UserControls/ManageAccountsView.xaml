<UserControl x:Class="eSureHi.Views.Admin.UserControls.ManageAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin">
    <UserControl.DataContext>
        <vm:ManageAccountsViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" BorderBrush="{StaticResource PrimaryDarkBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldAccount" Width="24" Height="24"
                                             Foreground="White"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Manage Accounts" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#FFFFFF" Opacity="0.95"
                            helpers:Adaptive.UseAdaptiveForeground="True"
                            CornerRadius="10"
                            Padding="8,2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="{StaticResource PrimaryDarkBrush}">
                            <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                            <Run Text=" of "/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding BackToDashboardCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White" BorderBrush="White"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Dashboard" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ManageAccessCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White"
                            BorderBrush="White"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldAccount" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Manage Access" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleActiveCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White"
                            BorderBrush="White"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountSwitch" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Toggle Active" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="White"
                            BorderBrush="White"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding BackToDashboardCommand}"
                            Background="{StaticResource PrimaryDarkBrush}"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Exit" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <UniformGrid Grid.Row="2" Columns="3" Margin="24,18,24,12">
            <materialDesign:Card Background="#E8F1FC" Margin="0,0,10,0">
                <StackPanel Margin="18,12">
                    <TextBlock Text="Active Accounts" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding ActiveCount}" FontSize="22" FontWeight="Bold" Foreground="#15803D"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Background="#E8F1FC" Margin="0,0,10,0">
                <StackPanel Margin="18,12">
                    <TextBlock Text="Inactive Accounts" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding InactiveCount}" FontSize="22" FontWeight="Bold" Foreground="#B91C1C"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Background="#E8F1FC">
                <StackPanel Margin="18,12">
                    <TextBlock Text="Visible Results" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding FilteredCount}" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" Padding="16,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search username, linked name, or role"
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Height="46"/>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding RoleOptions}"
                              SelectedItem="{Binding SelectedRole}"
                              materialDesign:HintAssist.Hint="Role"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Height="46"/>

                    <ComboBox Grid.Column="4"
                              ItemsSource="{Binding ActivityOptions}"
                              SelectedItem="{Binding SelectedActivity}"
                              materialDesign:HintAssist.Hint="Status"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Height="46"/>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding DisplayedAccounts}"
                      SelectedItem="{Binding SelectedAccount}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      Background="{StaticResource SurfaceBrush}"
                      RowBackground="{StaticResource SurfaceBrush}"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      RowHeight="48"
                      Style="{StaticResource ReadableDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="150"/>
                    <DataGridTextColumn Header="Linked Name" Binding="{Binding LinkedName}" Width="1.5*"/>
                    <DataGridTextColumn Header="Linked Type" Binding="{Binding LinkedType}" Width="110"/>
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="120"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding AccountStatus}" Width="100"/>
                    <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginText}" Width="170"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource PrimaryBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="11"
                       Foreground="{StaticResource PrimaryDarkBrush}"
                       TextWrapping="Wrap"
                       Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
        </Border>
    </Grid>
</UserControl>
