<UserControl x:Class="eSureHi.Views.Admin.UserControls.MyBenefitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin">
    <UserControl.DataContext>
        <vm:MyBenefitsViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="HeartPulse"
                                             Width="24" Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="My Benefits" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding BackToDashboardCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Exit" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                     Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsLoading,
                         Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ── Summary Cards ── -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="16,12,16,0">
            <materialDesign:Card Margin="0,0,4,0"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel Margin="16,12" HorizontalAlignment="Center">
                    <TextBlock Text="Total Maximum" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalMax, StringFormat=₱{0:N2}}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Margin="4,0,4,0"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel Margin="16,12" HorizontalAlignment="Center">
                    <TextBlock Text="Total Used" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalUsed, StringFormat=₱{0:N2}}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card Margin="4,0,0,0"
                                 materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel Margin="16,12" HorizontalAlignment="Center">
                    <TextBlock Text="Total Remaining" FontSize="11" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalRemaining, StringFormat=₱{0:N2}}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <!-- ── Content ── -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"
                      Margin="0,8,0,0">
            <StackPanel Margin="16,0,16,16">

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" Margin="0,60,0,0"
                            Visibility="{Binding HasData,
                                Converter={StaticResource BoolToVisibilityConverter},
                                ConverterParameter=Invert}">
                    <materialDesign:PackIcon Kind="HeartOff" Width="64" Height="64"
                                             Foreground="#E0E0E0"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="No benefits assigned yet."
                               FontSize="14"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Benefit Cards -->
                <ItemsControl ItemsSource="{Binding Benefits}"
                              Visibility="{Binding HasData,
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp2"
                                                 Margin="0,0,0,12">
                                <Grid Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                            Width="48" Height="48"
                                            CornerRadius="24" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                                            Margin="0,0,16,0">
                                        <materialDesign:PackIcon Kind="HeartPulse"
                                                                 Width="24" Height="24"
                                                                 Foreground="{StaticResource SuccessBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="Bold">
                                            <Run Text="{Binding BenefitType}"/>
                                            <Run Text=" — "/>
                                            <Run Text="{Binding YearPeriod}"/>
                                        </TextBlock>
                                        <TextBlock Text="{Binding EmployeePolicy.Policy.PolicyName}"
                                                   FontSize="12"
                                                   Margin="0,2,0,8"/>

                                        <!-- Progress Bar -->
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="6"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0"
                                                        Orientation="Horizontal"
                                                        Margin="0,0,0,4">
                                                <TextBlock FontSize="11">
                                                    <Run Text="Used: ₱"/>
                                                    <Run Text="{Binding UsedBenefit,
                                                             StringFormat={}{0:N2}}"/>
                                                </TextBlock>
                                                <TextBlock FontSize="11"
                                                           Margin="8,0">
                                                    <Run Text="of ₱"/>
                                                    <Run Text="{Binding MaxBenefit,
                                                             StringFormat={}{0:N2}}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Row="1" Background="#1C3A5E" helpers:Adaptive.UseAdaptiveForeground="True"
                                                    CornerRadius="3" Height="6">
                                                <Border.Width>
                                                    <Binding Path="ActualWidth"
                                                             RelativeSource="{RelativeSource Self}"/>
                                                </Border.Width>
                                            </Border>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Remaining -->
                                    <StackPanel Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Margin="16,0,0,0">
                                        <TextBlock Text="Remaining"
                                                   FontSize="10"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding Remaining,
                                                       StringFormat=₱{0:N2}}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
