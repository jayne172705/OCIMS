<UserControl x:Class="eSureHi.Views.Admin.UserControls.MyPoliciesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin">
    <UserControl.DataContext>
        <vm:MyPoliciesViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ShieldStar"
                                             Width="24" Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="My Policies" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"/>
                    </Button>
                    <Button Command="{Binding BackToDashboardCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Exit" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                     Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsLoading,
                         Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ── Content ── -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,24">

                <!-- Empty State -->
                <StackPanel HorizontalAlignment="Center" Margin="0,60,0,0"
                            Visibility="{Binding HasData,
                                Converter={StaticResource BoolToVisibilityConverter},
                                ConverterParameter=Invert}">
                    <materialDesign:PackIcon Kind="ShieldOff" Width="64" Height="64"
                                             Foreground="#E0E0E0"
                                             HorizontalAlignment="Center"/>
                    <TextBlock Text="No policies assigned yet."
                               FontSize="14"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Policy Cards -->
                <ItemsControl ItemsSource="{Binding Policies}"
                              Visibility="{Binding HasData,
                                  Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp2"
                                                 Margin="0,0,0,16">
                                <Grid Margin="20,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0"
                                            Width="52" Height="52"
                                            CornerRadius="26" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                                            Margin="0,0,16,0">
                                        <materialDesign:PackIcon Kind="ShieldStar"
                                                                 Width="28" Height="28"
                                                                 Foreground="{StaticResource PrimaryBrush}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Policy.PolicyName}"
                                                   FontSize="15" FontWeight="Bold"/>
                                        <TextBlock FontSize="12"
                                                   Margin="0,2,0,0">
                                            <Run Text="{Binding Policy.PolicyType}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Policy.ProviderName}"/>
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True" CornerRadius="4"
                                                    Padding="8,3" Margin="0,0,8,0">
                                                <TextBlock FontSize="11" Foreground="#81C784">
                                                    <Run Text="Coverage: ₱"/>
                                                    <Run Text="{Binding CoverageLimit,
                                                             StringFormat={}{0:N0}}"/>
                                                </TextBlock>
                                            </Border>
                                            <Border Background="White" helpers:Adaptive.UseAdaptiveForeground="True" CornerRadius="4"
                                                    Padding="8,3">
                                                <TextBlock FontSize="11"
                                                           Foreground="{StaticResource PrimaryBrush}">
                                                    <Run Text="Emp Share: ₱"/>
                                                    <Run Text="{Binding EmployeeShare,
                                                             StringFormat={}{0:N2}}"/>
                                                    <Run Text="/mo"/>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status + Dates -->
                                    <StackPanel Grid.Column="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <Border CornerRadius="10" Padding="10,4"
                                                HorizontalAlignment="Right">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AssignmentStatus}"
                                                                     Value="Active">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding AssignmentStatus}"
                                                       FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AssignmentStatus}"
                                                                         Value="Active">
                                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,6,0,0">
                                            <Run Text="Since "/>
                                            <Run Text="{Binding StartDate,
                                                     StringFormat={}{0:MMM dd, yyyy}}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </materialDesign:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
