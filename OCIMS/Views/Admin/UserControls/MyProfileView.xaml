<UserControl x:Class="eSureHi.Views.Admin.UserControls.MyProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin">
    <UserControl.DataContext>
        <vm:MyProfileViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="AccountCircle"
                                             Width="24" Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="My Profile" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding BackToDashboardCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Exit" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Loading Bar ── -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                     Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsLoading,
                         Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ── Profile Content ── -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,20,24,24" MaxWidth="800"
                        HorizontalAlignment="Center">

                <!-- Digital ID Card -->
                <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp4"
                                     Margin="0,0,0,20" Background="White" helpers:Adaptive.UseAdaptiveForeground="True">
                    <Grid>
                        <!-- Card Header Band -->
                        <Border Background="{StaticResource PrimaryBrush}" helpers:Adaptive.UseAdaptiveForeground="True"
                                Height="80" VerticalAlignment="Top"
                                CornerRadius="4,4,0,0"/>

                        <Grid Margin="24,24,24,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Photo -->
                            <StackPanel Grid.Column="0"
                                        Margin="0,0,24,0"
                                        VerticalAlignment="Top">
                                <Border Width="120" Height="120"
                                        CornerRadius="6"
                                        BorderBrush="White"
                                        BorderThickness="3"
                                        ClipToBounds="True">
                                    <Grid>
                                        <!-- No Photo -->
                                        <Border Background="#1C3A5E" helpers:Adaptive.UseAdaptiveForeground="True"
                                                Visibility="{Binding HasPhoto,
                                                    Converter={StaticResource BoolToVisibilityConverter},
                                                    ConverterParameter=Invert}">
                                            <materialDesign:PackIcon Kind="AccountCircle"
                                                                     Width="60" Height="60"
                                                                     Foreground="{StaticResource PrimaryBrush}"
                                                                     HorizontalAlignment="Center"
                                                                     VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Photo -->
                                        <Image Source="{Binding PhotoPath,
                                                   Converter={StaticResource PathToImageConverter}}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasPhoto,
                                                   Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>
                                <Button Command="{Binding ChangePhotoCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        Height="32"
                                        Margin="0,10,0,0"
                                        Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Camera"
                                                                 Width="15" Height="15"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Change Photo"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Name + Details -->
                            <StackPanel Grid.Column="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding Employee.FullName}"
                                    FontSize="22" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Employee.PositionTitle}"
                                   FontSize="14" Foreground="#64748B"
                                   Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding DepartmentName}"
                                   FontSize="13"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontWeight="Medium"
                                   Margin="0,8,0,12"/>

                                <!-- Employee No Badge -->
                                <Border Background="{StaticResource PrimaryBrush}" helpers:Adaptive.UseAdaptiveForeground="True"
                                        CornerRadius="4" Padding="10,4"
                                        HorizontalAlignment="Left">
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold">
                                        <Run Text="EMP #"/>
                                        <Run Text="{Binding Employee.EmployeeNo,
                                                 Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </materialDesign:Card>

                <!-- Info Sections -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Personal Information -->
                    <materialDesign:Card Grid.Column="0"
                                         materialDesign:ElevationAssist.Elevation="Dp2" Background="White" helpers:Adaptive.UseAdaptiveForeground="True">
                        <StackPanel Margin="20,16">
                            <TextBlock Text="Personal Information"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Date of Birth"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Employee.DateOfBirth,
                                               StringFormat={}{0:MMMM dd, yyyy}}"
                                           FontSize="12" FontWeight="Medium"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Gender"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Employee.Gender}"
                                           FontSize="12" FontWeight="Medium"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Civil Status"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Employee.CivilStatus}"
                                           FontSize="12" FontWeight="Medium"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Nationality"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Employee.Nationality}"
                                           FontSize="12" FontWeight="Medium"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Email"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Employee.Email}"
                                           FontSize="12" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mobile"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Employee.PhoneMobile}"
                                           FontSize="12" FontWeight="Medium"/>
                            </Grid>

                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Employment Information -->
                    <materialDesign:Card Grid.Column="2"
                                         materialDesign:ElevationAssist.Elevation="Dp2" Background="White" helpers:Adaptive.UseAdaptiveForeground="True">
                        <StackPanel Margin="20,16">
                            <TextBlock Text="Employment Information"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Department"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DepartmentName}"
                                           FontSize="12" FontWeight="Medium"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Position"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Employee.PositionTitle}"
                                           FontSize="12" FontWeight="Medium"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Employment Type"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Employee.EmploymentType}"
                                           FontSize="12" FontWeight="Medium"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Date Hired"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Employee.DateHired,
                                               StringFormat={}{0:MMMM dd, yyyy}}"
                                           FontSize="12" FontWeight="Medium"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Status"
                               FontSize="12"/>
                                                    <Border Grid.Column="1" CornerRadius="10" Padding="10,4"
                            HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1E293B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Employee.EmploymentStatus}"
                                                             Value="Active">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Employee.EmploymentStatus}"
                                               FontSize="11" FontWeight="Medium">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Employee.EmploymentStatus}"
                                                                 Value="Active">
                                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Address"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Employee.AddressLine1}"
                                           FontSize="12" FontWeight="Medium"
                                           TextWrapping="Wrap"/>
                            </Grid>

                        </StackPanel>
                    </materialDesign:Card>

                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
