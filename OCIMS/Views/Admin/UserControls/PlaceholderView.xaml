<UserControl x:Class="eSureHi.Views.Admin.UserControls.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource BackgroundBrush}">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="ProgressWrench" Width="56" Height="56"
                                     HorizontalAlignment="Center"
                                     Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock x:Name="TitleText" Text="Coming soon"
                       FontSize="20" FontWeight="SemiBold" Margin="0,16,0,4"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="This section is being built."
                       FontSize="13" HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
