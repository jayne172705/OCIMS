<UserControl x:Class="eSureHi.Views.Admin.UserControls.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin">
    <UserControl.DataContext>
        <vm:ReportsViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ChartBar"
                                             Width="24" Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Reports" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Municipality of Sulop — eSureHi"
                           FontSize="12"
                           HorizontalAlignment="Right"
                           Margin="0,0,96,0"
                           VerticalAlignment="Center"/>
                <Button Command="{Binding BackToDashboardCommand}"
                        Background="#D32F2F"
                        Foreground="White"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Height="34" Padding="16,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                 Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Exit" FontSize="12"
                                   FontWeight="Medium" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── Tab Content ── -->
        <TabControl Grid.Row="1"
                    Style="{StaticResource MaterialDesignTabControl}"
                    SelectedIndex="{Binding SelectedReportTab, Mode=TwoWay}"
                    Margin="16,8,16,8">

            <!-- ════════════════════════════════════════════════ -->
            <!-- TAB 1 — Employee Coverage                        -->
            <!-- ════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Employee Coverage"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Visibility="{Binding CoverageLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Filters + Actions -->
                    <Border Grid.Row="1" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                            BorderBrush="#DDE4EF" BorderThickness="0,1,0,1"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" MinWidth="200"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*" MinWidth="150"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*" MinWidth="150"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding CoverageSearch, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search employee, policy, or barangay..."
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Height="46" FontSize="12"/>

                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding PolicyTypeFilter}"
                                      SelectedItem="{Binding CoveragePolicyType}"
                                      materialDesign:HintAssist.Hint="Policy Type"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Height="46" FontSize="12"/>

                            <ComboBox Grid.Column="4"
                                      ItemsSource="{Binding AssignmentStatusOptions}"
                                      SelectedItem="{Binding CoverageStatus}"
                                      materialDesign:HintAssist.Hint="Status"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Height="46" FontSize="12"/>

                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                <Border Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True" CornerRadius="10"
                                        Padding="8,2" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock FontSize="11"
                                               Foreground="White">
                                        <Run Text="{Binding CoverageCount, Mode=OneWay}"/>
                                        <Run Text="records"/>
                                    </TextBlock>
                                </Border>
                                <Button Command="{Binding RefreshCoverageCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        Height="45" Padding="10,0" Margin="0,0,6,0">
                                    <materialDesign:PackIcon Kind="Refresh"
                                                             Width="16" Height="16"/>
                                </Button>
                                <Button Command="{Binding ExportCoveragePdfCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource ErrorBrush}"
                                        BorderBrush="{StaticResource ErrorBrush}"
                                        Height="45" Padding="10,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilePdfBox"
                                                                 Width="16" Height="16"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="PDF" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportCoverageXlsCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource SuccessBrush}"
                                        BorderBrush="{StaticResource SuccessBrush}"
                                        Height="45" Padding="10,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MicrosoftExcel"
                                                                 Width="16" Height="16"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Excel" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportCoverageWordCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="#2E7D32"
                                        BorderBrush="#2E7D32"
                                        Height="45" Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MicrosoftWord"
                                                                 Width="16" Height="16"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Word" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding CoverageData}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5EAF2"
                              RowHeight="44" BorderThickness="0"
                              Background="White" RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
                              Style="{StaticResource ReadableDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Household/Resident ID"
                                                Binding="{Binding EmployeeNo}" Width="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource PrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Full Name"
                                                Binding="{Binding FullName}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Department"
                                                Binding="{Binding DeptName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Policy"
                                                Binding="{Binding PolicyName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Type"
                                                Binding="{Binding PolicyType}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource PrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Coverage Limit"
                                                Binding="{Binding CoverageLimit,
                                                    StringFormat=₱{0:N2}}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Emp Share"
                                                Binding="{Binding EmployeeShare,
                                                    StringFormat=₱{0:N2}}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding AssignmentStatus}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════ -->
            <!-- TAB 2 — Claims Summary                           -->
            <!-- ════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ClipboardList" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Claims Summary"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Visibility="{Binding ClaimsLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Filters -->
                    <Border Grid.Row="1" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                            BorderBrush="#DDE4EF" BorderThickness="0,1,0,1"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" MinWidth="200"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ClaimsSearch, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search name, dept, or barangay..."
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Height="46" FontSize="12"/>
                            <CheckBox Grid.Column="2"
                                      IsChecked="{Binding ClaimsWithOnly}"
                                      Content="With claims only"
                                      VerticalAlignment="Center"
                                      Margin="12,0" FontSize="12"/>
                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                <Border Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True" CornerRadius="10"
                                        Padding="8,2" Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock FontSize="11"
                                               Foreground="White">
                                        <Run Text="{Binding ClaimsCount, Mode=OneWay}"/>
                                        <Run Text="employees"/>
                                    </TextBlock>
                                </Border>
                                <Button Command="{Binding RefreshClaimsCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        Height="45" Padding="10,0" Margin="0,0,6,0">
                                    <materialDesign:PackIcon Kind="Refresh"
                                                             Width="16" Height="16"/>
                                </Button>
                                <Button Command="{Binding ExportClaimsPdfCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource ErrorBrush}"
                                        BorderBrush="{StaticResource ErrorBrush}"
                                        Height="45" Padding="10,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilePdfBox"
                                                                 Width="16" Height="16"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="PDF" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportClaimsXlsCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource SuccessBrush}"
                                        BorderBrush="{StaticResource SuccessBrush}"
                                        Height="45" Padding="10,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MicrosoftExcel"
                                                                 Width="16" Height="16"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Excel" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportClaimsWordCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="#2E7D32"
                                        BorderBrush="#2E7D32"
                                        Height="45" Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MicrosoftWord"
                                                                 Width="16" Height="16"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Word" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Totals Strip -->
                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
                        <materialDesign:Card Margin="0,0,4,4"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel Margin="16,10" HorizontalAlignment="Center">
                                <TextBlock Text="Total Claimed" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalClaimed, StringFormat=₱{0:N2}}"
                                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="4,0,4,4"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel Margin="16,10" HorizontalAlignment="Center">
                                <TextBlock Text="Total Approved" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalApproved, StringFormat=₱{0:N2}}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="4,0,0,4"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel Margin="16,10" HorizontalAlignment="Center">
                                <TextBlock Text="Total Released" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalReleased, StringFormat=₱{0:N2}}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding ClaimsData}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5EAF2"
                              RowHeight="44" BorderThickness="0"
                              Background="White" RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
                              Style="{StaticResource ReadableDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Household/Resident ID"
                                                Binding="{Binding EmployeeNo}" Width="190">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource PrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Full Name"
                                                Binding="{Binding FullName}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Department"
                                                Binding="{Binding DeptName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Barangay"
                                                Binding="{Binding Barangay}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Foreground" Value="#1B5E20"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Total Claims"
                                                Binding="{Binding TotalClaims}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Claimed"
                                                Binding="{Binding TotalClaimed,
                                                    StringFormat=₱{0:N2}}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Approved"
                                                Binding="{Binding TotalApproved,
                                                    StringFormat=₱{0:N2}}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Released"
                                                Binding="{Binding TotalReleased,
                                                    StringFormat=₱{0:N2}}" Width="140">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource PrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Pending"
                                                Binding="{Binding PendingClaims}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource WarningBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Rejected"
                                                Binding="{Binding RejectedClaims}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource ErrorBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════ -->
            <!-- TAB 3 — Premium Status                           -->
            <!-- ════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CashMultiple" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Premium Status"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Visibility="{Binding PremiumLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Filters -->
                    <Border Grid.Row="1" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                            BorderBrush="#DDE4EF" BorderThickness="0,1,0,1"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.4*" MinWidth="180"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*" MinWidth="130"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*" MinWidth="140"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*" MinWidth="140"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding PremiumSearch, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search employee..."
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Height="46" FontSize="12"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding PremiumStatusOptions}"
                                      SelectedItem="{Binding PremiumStatus}"
                                      materialDesign:HintAssist.Hint="Status"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Height="46" FontSize="12"/>
                            <DatePicker Grid.Column="4"
                                        SelectedDate="{Binding PremiumMonthFrom}"
                                        materialDesign:HintAssist.Hint="From Month"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        Height="46" FontSize="12"/>
                            <DatePicker Grid.Column="6"
                                        SelectedDate="{Binding PremiumMonthTo}"
                                        materialDesign:HintAssist.Hint="To Month"
                                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                        Height="46" FontSize="12"/>
                            <StackPanel Grid.Column="8" Orientation="Horizontal">
                                <Button Command="{Binding RefreshPremiumCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        Height="45" Padding="10,0" Margin="0,0,6,0">
                                    <materialDesign:PackIcon Kind="Refresh"
                                                             Width="16" Height="16"/>
                                </Button>
                                <Button Command="{Binding ExportPremiumPdfCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource ErrorBrush}"
                                        BorderBrush="{StaticResource ErrorBrush}"
                                        Height="45" Padding="10,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilePdfBox"
                                                                 Width="16" Height="16"
