                                           Foreground="{StaticResource ErrorBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="4,0,4,4"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel Margin="16,10" HorizontalAlignment="Center">
                                <TextBlock Text="Total Paid" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PremiumTotalPaid, StringFormat=₱{0:N2}}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="4,0,0,4"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel Margin="16,10" HorizontalAlignment="Center">
                                <TextBlock Text="Outstanding Balance" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding PremiumTotalBalance, StringFormat=₱{0:N2}}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding PremiumData}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5EAF2"
                              RowHeight="44" BorderThickness="0"
                              Background="White" RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
                              Style="{StaticResource ReadableDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee"
                                                Binding="{Binding EmployeeName}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Policy"
                                                Binding="{Binding PolicyName}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Billing Month"
                                                Binding="{Binding BillingMonth,
                                                    StringFormat={}{0:MMM yyyy}}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Due Date"
                                                Binding="{Binding DueDate,
                                                    StringFormat={}{0:MMM dd, yyyy}}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Total Due"
                                                Binding="{Binding TotalAmount,
                                                    StringFormat=₱{0:N2}}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Paid"
                                                Binding="{Binding AmountPaid,
                                                    StringFormat=₱{0:N2}}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="Foreground" Value="#2E7D32"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Balance"
                                                Binding="{Binding Balance,
                                                    StringFormat=₱{0:N2}}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding PaymentStatus}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════ -->
            <!-- TAB 4 — Benefit Utilization                      -->
            <!-- ════════════════════════════════════════════════ -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="HeartPulse" Width="16" Height="16"
                                                 VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Benefit Utilization"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" IsIndeterminate="True" Height="3"
                                 Foreground="{StaticResource PrimaryBrush}"
                                 Visibility="{Binding BenefitLoading,
                                     Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <!-- Filters -->
                    <Border Grid.Row="1" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                            BorderBrush="#DDE4EF" BorderThickness="0,1,0,1"
                            Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" MinWidth="200"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*" MinWidth="150"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*" MinWidth="120"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding BenefitSearch, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Search employee or policy..."
                                     materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                     materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Height="46" FontSize="12"/>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding BenefitTypeOptions}"
                                      SelectedItem="{Binding BenefitType}"
                                      materialDesign:HintAssist.Hint="Benefit Type"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Height="46" FontSize="12"/>
                            <ComboBox Grid.Column="4"
                                      ItemsSource="{Binding YearOptions}"
                                      SelectedItem="{Binding BenefitYear}"
                                      materialDesign:HintAssist.Hint="Year"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                      Height="46" FontSize="12"/>
                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                <Button Command="{Binding RefreshBenefitCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        Height="45" Padding="10,0" Margin="0,0,6,0">
                                    <materialDesign:PackIcon Kind="Refresh"
                                                             Width="16" Height="16"/>
                                </Button>
                                <Button Command="{Binding ExportBenefitPdfCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource ErrorBrush}"
                                        BorderBrush="{StaticResource ErrorBrush}"
                                        Height="45" Padding="10,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FilePdfBox"
                                                                 Width="16" Height="16"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="PDF" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportBenefitXlsCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="{StaticResource SuccessBrush}"
                                        BorderBrush="{StaticResource SuccessBrush}"
                                        Height="45" Padding="10,0" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MicrosoftExcel"
                                                                 Width="16" Height="16"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Excel" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportBenefitWordCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Foreground="#2E7D32"
                                        BorderBrush="#2E7D32"
                                        Height="45" Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MicrosoftWord"
                                                                 Width="16" Height="16"
                                                                 Margin="0,0,6,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Word" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Totals Strip -->
                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
                        <materialDesign:Card Margin="0,0,4,4"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel Margin="16,10" HorizontalAlignment="Center">
                                <TextBlock Text="Total Maximum" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding BenefitTotalMax, StringFormat=₱{0:N2}}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="4,0,4,4"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel Margin="16,10" HorizontalAlignment="Center">
                                <TextBlock Text="Total Used" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding BenefitTotalUsed, StringFormat=₱{0:N2}}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource WarningBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </materialDesign:Card>
                        <materialDesign:Card Margin="4,0,0,4"
                                             materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel Margin="16,10" HorizontalAlignment="Center">
                                <TextBlock Text="Total Remaining" FontSize="11" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding BenefitTotalRemaining, StringFormat=₱{0:N2}}"
                                           FontSize="16" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </UniformGrid>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding BenefitData}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5EAF2"
                              RowHeight="44" BorderThickness="0"
                              Background="White" RowBackground="White"
                              AlternatingRowBackground="#F8FAFC"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
                              Style="{StaticResource ReadableDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee"
                                                Binding="{Binding EmployeePolicy.Employee.FullName}"
                                                Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Policy"
                                                Binding="{Binding EmployeePolicy.Policy.PolicyName}"
                                                Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Benefit Type"
                                                Binding="{Binding BenefitType}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Margin" Value="12,0"/>
                                        <Setter Property="Foreground"
                                                Value="{StaticResource PrimaryBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Year"
