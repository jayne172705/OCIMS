<UserControl x:Class="eSureHi.Views.Admin.UserControls.ReviewQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:eSureHi.Helpers">

    <UserControl.Resources>
        <Style x:Key="ReviewLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style x:Key="ReviewValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ReviewSecondaryValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="ReviewMoneyValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClipboardCheck"
                                             Width="24"
                                             Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Review Queue" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Command="{Binding PreviousCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="34"
                            Height="34"
                            ToolTip="Previous record">
                        <materialDesign:PackIcon Kind="ChevronLeft" Width="20" Height="20"/>
                    </Button>
                    <TextBlock Text="{Binding PositionText}"
                               FontSize="13"
                               FontWeight="Bold"
                               Margin="18,0"
                               VerticalAlignment="Center"/>
                    <Button Command="{Binding NextCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="34"
                            Height="34"
                            ToolTip="Next record">
                        <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34"
                            Padding="12,0"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                            <TextBlock Text="Refresh" FontSize="12"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CloseCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="Exit" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="1"
                     IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <Grid Grid.Row="2" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding BrowseColumnWidth}"/>
                <ColumnDefinition Width="{Binding BrowseSeparatorWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDE4EF"
                    BorderThickness="1"
                    Visibility="{Binding IsBrowseVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="12">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Search claim, employee, policy..."
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="46"
                                 FontSize="14"
                                 Padding="12,8"/>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding QueueClaims}"
                             SelectedItem="{Binding SelectedClaim}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="{Binding ClaimNo}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            <Border HorizontalAlignment="Right"
                                                    CornerRadius="12"
                                                    BorderBrush="#94A3B8"
                                                    BorderThickness="1"
                                                    Padding="9,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ClaimStatus}" Value="Under Review">
                                                                <Setter Property="Background" Value="#FFF7ED"/>
                                                                <Setter Property="BorderBrush" Value="#F97316"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ClaimStatus}" Value="Approved">
                                                                <Setter Property="Background" Value="#ECFDF5"/>
                                                                <Setter Property="BorderBrush" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ClaimStatus}" Value="Rejected">
                                                                <Setter Property="Background" Value="#FEF2F2"/>
                                                                <Setter Property="BorderBrush" Value="#DC2626"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding ClaimStatus}" Value="Released">
                                                                <Setter Property="Background" Value="#ECFEFF"/>
                                                                <Setter Property="BorderBrush" Value="#0891B2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ClaimStatus}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#1E293B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ClaimStatus}" Value="Under Review">
                                                                    <Setter Property="Foreground" Value="#C2410C"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ClaimStatus}" Value="Approved">
                                                                    <Setter Property="Foreground" Value="#166534"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ClaimStatus}" Value="Rejected">
                                                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ClaimStatus}" Value="Released">
                                                                    <Setter Property="Foreground" Value="#0E7490"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Employee.FullName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#0F172A"
                                                   Margin="0,6,0,0"/>
                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding Policy.PolicyName}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#334155"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDE4EF"
                    BorderThickness="1"
                    Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="ClipboardSearchOutline" Width="64" Height="64" Foreground="#CBD5E1"/>
                    <TextBlock Text="Select a queue record"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#64748B"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="2"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="20,16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Reference #" Style="{StaticResource ReviewLabelText}"/>
                                    <TextBlock Text="{Binding SelectedDetail.Claim.ClaimNo}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,14"/>
                                    <TextBlock Text="Employee" Style="{StaticResource ReviewLabelText}"/>
                                    <TextBlock Text="{Binding SelectedDetail.Claim.Employee.FullName}" Style="{StaticResource ReviewValueText}"/>
                                    <TextBlock Text="Department" Style="{StaticResource ReviewLabelText}"/>
                                    <TextBlock Text="{Binding SelectedDetail.Claim.Employee.Department.DeptName}" Style="{StaticResource ReviewSecondaryValueText}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Policy" Style="{StaticResource ReviewLabelText}"/>
                                    <TextBlock Text="{Binding SelectedDetail.Claim.Policy.PolicyName}" Style="{StaticResource ReviewValueText}"/>
                                    <TextBlock Text="Claim Type" Style="{StaticResource ReviewLabelText}"/>
                                    <TextBlock Text="{Binding SelectedDetail.Claim.ClaimType}" Style="{StaticResource ReviewValueText}"/>
                                    <TextBlock Text="Submitted" Style="{StaticResource ReviewLabelText}"/>
                                    <TextBlock Text="{Binding SelectedDetail.Claim.SubmittedDate, StringFormat={}{0:MMM dd, yyyy}}" Style="{StaticResource ReviewSecondaryValueText}"/>
                                </StackPanel>

                                <Border Grid.Column="2"
                                        CornerRadius="16"
                                        BorderThickness="1"
                                        Padding="16,8"
                                        VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#ECFDF3"/>
                                            <Setter Property="BorderBrush" Value="#2E7D32"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedDetail.ClaimStatus}" Value="Under Review">
                                                    <Setter Property="Background" Value="#FFF7ED"/>
                                                    <Setter Property="BorderBrush" Value="#F97316"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedDetail.ClaimStatus}" Value="Approved">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                    <Setter Property="BorderBrush" Value="#16A34A"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedDetail.ClaimStatus}" Value="Rejected">
                                                    <Setter Property="Background" Value="#FEF2F2"/>
                                                    <Setter Property="BorderBrush" Value="#DC2626"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedDetail.ClaimStatus}" Value="Released">
                                                    <Setter Property="Background" Value="#ECFEFF"/>
                                                    <Setter Property="BorderBrush" Value="#0891B2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedDetail.ClaimStatus}"
                                               FontSize="13"
                                               FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#2E7D32"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedDetail.ClaimStatus}" Value="Under Review">
                                                        <Setter Property="Foreground" Value="#C2410C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetail.ClaimStatus}" Value="Approved">
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetail.ClaimStatus}" Value="Rejected">
                                                        <Setter Property="Foreground" Value="#B91C1C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedDetail.ClaimStatus}" Value="Released">
                                                        <Setter Property="Foreground" Value="#0E7490"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="20,16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Claim Information" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Claimed" Style="{StaticResource ReviewLabelText}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedDetail.Claim.AmountClaimed, StringFormat=PHP {0:N2}}"
                                                   Style="{StaticResource ReviewMoneyValueText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Approved" Style="{StaticResource ReviewLabelText}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedDetail.Claim.AmountApproved, StringFormat=PHP {0:N2}}"
                                                   Style="{StaticResource ReviewMoneyValueText}"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Released" Style="{StaticResource ReviewLabelText}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedDetail.Claim.AmountReleased, StringFormat=PHP {0:N2}}"
                                                   Style="{StaticResource ReviewMoneyValueText}"
                                                   Foreground="{StaticResource InfoBrush}"
                                                   />
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Incident Description" Style="{StaticResource ReviewLabelText}" Margin="0,18,0,5"/>
                                <TextBlock Text="{Binding SelectedDetail.Claim.IncidentDescription}" FontSize="13" Foreground="#1E293B" TextWrapping="Wrap" LineHeight="19"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="#DDE4EF" BorderThickness="1" Padding="18,14" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="FileDocumentCheck"
                                                             Width="20"
                                                             Height="20"
                                                             Foreground="#F59E0B"
                                                             Margin="0,0,8,0"/>
                                <TextBlock Text="Submitted Requirements" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding SelectedDetail.Documents}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="CheckCircle"
                                                                         Width="18"
                                                                         Height="18"
                                                                         Foreground="{StaticResource SuccessBrush}"
                                                                         Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding DocType}" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A"/>
                                                    <TextBlock Text="{Binding FileName}" FontSize="12" FontWeight="SemiBold" Foreground="#334155"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="No submitted requirement documents found."
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#B91C1C"
                                           Visibility="{Binding SelectedDetail.HasNoDocuments, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <Border
                        Background="#ECFDF3"
                        BorderBrush="#BBF7D0"
                        BorderThickness="1"
                        Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="560"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="StarCheck"
                                                         Width="20"
                                                         Height="20"
                                                         Foreground="{StaticResource PrimaryBrush}"
                                                         Margin="0,0,8,0"/>
                                <TextBlock Text="Review Decision" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                            <TextBlock Text="Approve only if the submitted requirements qualify for the claim."
                                       FontSize="13"
                                       Foreground="#334155"
                                       Margin="28,3,0,0"/>
                            <TextBlock Text="{Binding SelectedDetail.StatusMessage}"
                                       Foreground="{StaticResource ErrorBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="28,8,0,0"
                                       Visibility="{Binding SelectedDetail.StatusMessage, Converter={StaticResource StringToVisibilityConverter}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Command="{Binding SelectedDetail.ReviewCommand}"
                                    Visibility="{Binding SelectedDetail.CanReview, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="{StaticResource WarningBrush}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Height="40"
                                    Padding="16,0"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardSearch" Width="16" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="START REVIEW" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </Button>

                            <Border Visibility="{Binding SelectedDetail.CanApprove, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="White"
                                    BorderBrush="#B7D6F2"
                                    BorderThickness="1"
                                    Padding="10"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Approved Amount"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E293B"
                                                   Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding SelectedDetail.AmountApproved, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                                 materialDesign:HintAssist.Hint="Enter amount to approve"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="46"
                                                 FontSize="14"
                                                 Padding="12,8"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Command="{Binding SelectedDetail.ApproveCommand}"
                                            Background="{StaticResource SuccessBrush}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Height="46"
                                            Padding="18,0"
                                            VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="APPROVE" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Border Visibility="{Binding SelectedDetail.CanReject, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Background="White"
                                    BorderBrush="#F2B7B7"
                                    BorderThickness="1"
                                    Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Rejection Reason"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1E293B"
                                                   Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding SelectedDetail.RejectionReason, UpdateSourceTrigger=PropertyChanged}"
                                                 materialDesign:HintAssist.Hint="Type reason before rejecting"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Height="46"
                                                 FontSize="14"
                                                 Padding="12,8"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Command="{Binding SelectedDetail.RejectCommand}"
                                            Background="{StaticResource ErrorBrush}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Height="46"
                                            Padding="18,0"
                                            VerticalAlignment="Bottom">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CloseCircle" Width="16" Height="16" Margin="0,0,8,0"/>
                                            <TextBlock Text="REJECT" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
