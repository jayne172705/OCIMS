<UserControl x:Class="eSureHi.Views.Admin.UserControls.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
             xmlns:vm="clr-namespace:eSureHi.ViewModels.Admin">
    <UserControl.DataContext>
        <vm:TransactionsViewModel/>
    </UserControl.DataContext>

    <Grid Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="3"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Header ── -->
        <Border Grid.Row="0" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                BorderBrush="#DDE4EF" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="SwapHorizontal"
                                             Width="24" Height="24"
                                             Foreground="{StaticResource PrimaryBrush}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="Transactions" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True" CornerRadius="10"
                            Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="11" Foreground="White">
                            <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                            <Run Text="of"/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">

                    <!-- View Button -->
                    <Button Command="{Binding ViewCommand}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Eye" Width="16" Height="16"
                                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="View" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="{StaticResource PrimaryBrush}"
                            BorderBrush="{StaticResource PrimaryBrush}"
                            Height="34" Padding="12,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16"
                                                     Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refresh" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding UploadToEGoogGovCommand}"
                            Background="#004D40"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34" Padding="16,0" Margin="0,0,8,0"
                            Visibility="{Binding CanUploadToEGoogGov, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Upload distributed transaction to eGoogGOV portal">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudUpload" Width="16" Height="16"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="eGoogGOV Upload" FontSize="12"
                                       FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NewCommand}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34" Padding="16,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="New Transaction" FontSize="12"
                                       FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding BackToDashboardCommand}"
                            Background="#D32F2F"
                            Foreground="White"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="34" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"
                                                     Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Exit" FontSize="12"
                                       FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Loading Bar ── -->
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3"
                     Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsLoading,
                         Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ── Filters ── -->
        <Border Grid.Row="2" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                BorderBrush="#DDE4EF" BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Search subject, sender, receiver..."
                         materialDesign:TextFieldAssist.HasLeadingIcon="True"
                         materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Height="50" FontSize="12"/>

                <ComboBox Grid.Column="2"
                          ItemsSource="{Binding TypeOptions}"
                          SelectedItem="{Binding TypeFilter}"
                          materialDesign:HintAssist.Hint="Type"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Height="50" FontSize="12"/>

                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding StatusOptions}"
                          SelectedItem="{Binding StatusFilter}"
                          materialDesign:HintAssist.Hint="Status"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Height="50" FontSize="12"/>

                <ComboBox Grid.Column="6"
                          ItemsSource="{Binding PriorityOptions}"
                          SelectedItem="{Binding PriorityFilter}"
                          materialDesign:HintAssist.Hint="Priority"
                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                          Height="50" FontSize="12"/>

                <Button Grid.Column="8"
                        Command="{Binding ClearFilterCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterRemove" Width="16" Height="16"
                                                 Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Clear" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ── Sync Status Banner ── -->
        <Border Grid.Row="3" Background="#FFF3E0" BorderBrush="#FFE0B2" BorderThickness="0,0,0,1"
                Padding="16,8"
                Visibility="{Binding SyncStatus.HasMessage, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="16" Height="16"
                                         Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding SyncStatus.Message}" FontSize="12" Foreground="#E65100" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── DataGrid ── -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding DisplayedTransactions}"
                  SelectedItem="{Binding SelectedTransaction}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#E5EAF2"
                  RowHeight="48"
                  BorderThickness="0"
                  Background="White"
                  RowBackground="White"
                  AlternatingRowBackground="#F8FAFC"
                  MouseDoubleClick="DataGrid_MouseDoubleClick"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="12,8"
                  Style="{StaticResource ReadableDataGrid}">

            <DataGrid.Columns>

                <!-- Transaction No -->
                <DataGridTextColumn Header="Trans. No"
                                    Binding="{Binding TransactionNo}"
                                    Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,0"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Type Badge -->
                <DataGridTemplateColumn Header="Type" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="10,3" Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True"
                                    HorizontalAlignment="Left"
                                    Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding TransactionType}"
                                           FontSize="11" FontWeight="Medium"
                                           Foreground="White"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Subject -->
                <DataGridTextColumn Header="Subject"
                                    Binding="{Binding Subject}"
                                    Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,0"/>
                            <Setter Property="FontWeight" Value="Medium"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Sender -->
                <DataGridTextColumn Header="From"
                                    Binding="{Binding Sender.SenderName}"
                                    Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,0"/>
                            
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Receiver -->
                <DataGridTextColumn Header="To"
                                    Binding="{Binding Receiver.ReceiverName}"
                                    Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="12,0"/>
                            
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Priority Badge -->
                <DataGridTemplateColumn Header="Priority" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="8,3"
                                    HorizontalAlignment="Left"
                                    Margin="12,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F5F5F5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="High">
                                                <Setter Property="Background" Value="#FFF3E0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Priority}" Value="Normal">
                                                <Setter Property="Background" Value="#ECFDF3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Priority}"
                                           FontSize="11" FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Priority}" Value="Urgent">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="High">
                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Priority}" Value="Normal">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Status Badge -->
                <DataGridTemplateColumn Header="Status" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="10,3"
                                    HorizontalAlignment="Left"
                                    Margin="12,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                <Setter Property="Background" Value="#FFF3E0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="In Transit">
                                                <Setter Property="Background" Value="#ECFDF3"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Received">
                                                <Setter Property="Background" Value="#F3E5F5"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Acknowledged">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                <Setter Property="Background" Value="#E0F7FA"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Status}"
                                           FontSize="11" FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#334155"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Foreground" Value="#E65100"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="In Transit">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Acknowledged">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="Foreground" Value="#00838F"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Actions -->
                <DataGridTemplateColumn Header="Actions" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="8,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0.50"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected,
                                                RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.ViewCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        ToolTip="View / Process"
                                        Width="32" Height="32"
                                        Foreground="{StaticResource PrimaryBrush}">
                                    <materialDesign:PackIcon Kind="Eye" Width="16" Height="16"/>
                                </Button>

                                <Button Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding DataContext.EditCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        ToolTip="Edit (Pending only)"
                                        Width="32" Height="32"
                                        Foreground="{StaticResource WarningBrush}">
                                    <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Status Bar ── -->
        <Border Grid.Row="5" Background="White" helpers:Adaptive.UseAdaptiveForeground="True"
                BorderBrush="#DDE4EF" BorderThickness="0,1,0,0"
                Padding="16,8">
            <TextBlock FontSize="11">
                <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                <Run Text="transaction(s) shown · Double-click or Eye icon to view and process"/>
            </TextBlock>
        </Border>

    </Grid>
</UserControl>
