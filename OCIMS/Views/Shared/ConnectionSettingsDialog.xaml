<Window x:Class="eSureHi.Views.Shared.ConnectionSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:eSureHi.ViewModels.Shared"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ConnectionSettingsViewModel}"
        Title="Connection Settings — eSureHi+"
        Width="520" Height="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{materialDesign:MaterialDesignFont}"
        Loaded="Window_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24,28,24">

        <!-- Header -->
        <TextBlock Text="Connection Settings"
                   FontSize="18" FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Network = 3 connections on office LAN (192.168.0.47), Online = IMS_DB only on cloud"
                   FontSize="12" Foreground="Gray"
                   Margin="0,0,0,4"/>
        <TextBlock Text="Network shows IMS_DB / GGMS_DB / CRS_DB. Online shows IMS_DB only. All prefilled and editable. Test each separately."
                   FontSize="11"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18"/>

        <!-- Presets (Local hidden) -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Button Content="Network (all 3)"
                    Command="{Binding PresetNetworkCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    BorderBrush="{Binding IsNetworkSelected, Converter={StaticResource HexToBrushConverter}, ConverterParameter='#2E7D32'}"
                    BorderThickness="2"
                    Margin="0,0,10,0" Width="220" Height="40"/>
            <Button Content="Online (IMS)"
                    Command="{Binding PresetRemoteCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    BorderBrush="{Binding IsRemoteSelected, Converter={StaticResource HexToBrushConverter}, ConverterParameter='#2E7D32'}"
                    BorderThickness="2"
                    Width="220" Height="40"/>
        </StackPanel>

        <!-- ── 1. IMS_DB ── -->
        <GroupBox Header="1. IMS_DB (main)" Margin="0,0,0,12" Padding="12">
            <StackPanel>
                <TextBox Text="{Binding eSureHiServer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Server / IP"
                         IsEnabled="{Binding IsCredentialsEditable}"
                         Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding eSureHiPort, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Port"
                             IsEnabled="{Binding IsCredentialsEditable}"/>
                    <TextBox Grid.Column="2" Text="{Binding eSureHiDatabase, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Database Name"
                             IsEnabled="{Binding IsCredentialsEditable}"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding eSureHiUser, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Username"
                             IsEnabled="{Binding IsCredentialsEditable}"/>
                    <TextBox Grid.Column="2" Text="{Binding eSureHiPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Password"
                             IsEnabled="{Binding IsCredentialsEditable}"/>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Test IMS_DB"
                            Command="{Binding TestConnectionCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    <TextBlock Text="{Binding ImsTestMessage}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" Width="250"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- ── 2. GGMS_DB (network only) ── -->
        <GroupBox Header="2. GGMS_DB (network only)" Margin="0,0,0,12" Padding="12"
                  Visibility="{Binding IsNetworkSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBox Text="{Binding GgmsServer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Server / IP"
                         Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding GgmsPort, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Port"/>
                    <TextBox Grid.Column="2" Text="{Binding GgmsDatabase, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Database Name"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding GgmsUser, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Username"/>
                    <TextBox Grid.Column="2" Text="{Binding GgmsPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Password"/>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Test GGMS_DB"
                            Command="{Binding TestGgmsConnectionCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    <TextBlock Text="{Binding GgmsTestMessage}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" Width="250"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- ── 3. CRS_DB (network only) ── -->
        <GroupBox Header="3. CRS_DB (network only)" Margin="0,0,0,12" Padding="12"
                  Visibility="{Binding IsNetworkSelected, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <TextBox Text="{Binding CrsServer, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Server / IP"
                         Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding CrsPort, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Port"/>
                    <TextBox Grid.Column="2" Text="{Binding CrsDatabase, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Database Name"/>
                </Grid>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding CrsUser, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Username"/>
                    <TextBox Grid.Column="2" Text="{Binding CrsPassword, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             materialDesign:HintAssist.Hint="Password"/>
                </Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Test CRS_DB"
                            Command="{Binding TestCrsConnectionCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"/>
                    <TextBlock Text="{Binding CrsTestMessage}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" Width="250"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Status Message -->
        <TextBlock Text="{Binding StatusMessage}"
                   FontSize="12" Margin="0,4,0,0"
                   TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding TestSuccess}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TestSuccess}" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Test All"
                    Command="{Binding TestAllCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Margin="0,0,8,0"/>
            <Button Content="Save All"
                    Command="{Binding SaveCommand}"
                    Background="{StaticResource PrimaryBrush}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>

    </StackPanel>
    </ScrollViewer>
</Window>
