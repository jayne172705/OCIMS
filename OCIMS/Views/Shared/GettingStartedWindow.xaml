<Window x:Class="eSureHi.Views.Shared.GettingStartedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Title="Getting Started — eSureHi+"
        Width="800" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="8" ClipToBounds="True" Background="{StaticResource BackgroundBrush}" helpers:Adaptive.UseAdaptiveForeground="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Panel (Brand & Info) ── -->
            <Border Grid.Column="0" Background="#1B5E20" helpers:Adaptive.UseAdaptiveForeground="True">
                <Grid Margin="30">
                    <StackPanel VerticalAlignment="Top">
                        <!-- Municipal Logo Placeholder -->
                        <Grid Width="110" Height="110"
                              HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   Width="90" Height="90"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>

                        <TextBlock Text="eSureHi+"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Municipal Insurance Management System (MIMS)"
                                   FontSize="16"
                                   FontStyle="Italic"
                                   Foreground="#90CAF9"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0,0,0,25"/>

                        <TextBlock Text="Municipality of Sulop, Davao del Sur"
                                   FontSize="12"
                                   Foreground="#90CAF9"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,40"/>

                        <TextBlock Text="Manage local household records, staged beneficiaries, cash-for-work operations, and synced municipal tables from one admin portal."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   LineHeight="18"
                                   Opacity="0.8"/>
                    </StackPanel>

                    <!-- Serial info at bottom -->
                    <Border Background="#2E7D32" helpers:Adaptive.UseAdaptiveForeground="True" CornerRadius="4" Padding="12,6" 
                            VerticalAlignment="Bottom" HorizontalAlignment="Center">
                        <TextBlock Text="Company Serial: BAS-20260326-CF43"
                                   FontSize="11" Opacity="0.9"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Right Panel (Getting Started Guide) ── -->
            <Grid Grid.Column="1" Background="#102540" helpers:Adaptive.UseAdaptiveForeground="True">
                <StackPanel Margin="50,40,50,40">
                    <TextBlock Text="Getting Started"
                               FontSize="32"
                               FontWeight="Light"
                               Foreground="#90CAF9"
                               Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Follow these instructions to access your account."
                               FontSize="14"
                               Margin="0,0,0,30"/>

                    <TextBlock Text="How to Login"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <!-- Steps -->
                    <StackPanel Margin="0,0,0,40">
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" Background="#ECFDF3" helpers:Adaptive.UseAdaptiveForeground="True">
                                <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="#90CAF9" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Open the eSureHi+ System" 
                                       FontSize="14" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" Background="#ECFDF3" helpers:Adaptive.UseAdaptiveForeground="True">
                                <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="#90CAF9" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Enter your Username and Password" 
                                       FontSize="14" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" Background="#ECFDF3" helpers:Adaptive.UseAdaptiveForeground="True">
                                <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="#90CAF9" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Click Sign In" 
                                       FontSize="14" Margin="15,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" Background="#ECFDF3" helpers:Adaptive.UseAdaptiveForeground="True">
                                <TextBlock Text="4" FontSize="12" FontWeight="Bold" Foreground="#90CAF9" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="You will be directed to your dashboard based on your role" 
                                       FontSize="14" Margin="15,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </StackPanel>

                    <!-- Continue Button -->
                    <Button Content="GET STARTED"
                            Command="{Binding ContinueCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="45"
                            Width="180"
                            HorizontalAlignment="Right"
                            materialDesign:ButtonAssist.CornerRadius="22"
                            Background="#2E7D32"
                            BorderBrush="#2E7D32"
                            FontWeight="Bold"/>
                </StackPanel>

                <!-- Close button for the application -->
                <Button Click="BtnClose_Click"
                        Style="{StaticResource MaterialDesignFlatButton}" Width="40" Height="40"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="5"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
