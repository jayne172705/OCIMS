<Window x:Class="eSureHi.Views.Shared.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:helpers="clr-namespace:eSureHi.Helpers"
        Icon="pack://application:,,,/Assets/eSureHi.ico"
        Title="eSureHi+ — Login"
        Width="1000" Height="650"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="0"
                      UseAeroCaptionButtons="False"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="0" ClipToBounds="True" Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58*"/>
                <ColumnDefinition Width="42*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left Panel (Branding) ── -->
            <Border Grid.Column="0" Background="#0A1830">
                <Grid>
                    <!-- Main Branding Content -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Logo in White Rounded Square -->
                        <Border Width="140" Height="140" Background="White" CornerRadius="25" Margin="0,0,0,30">
                            <Image Source="pack://application:,,,/Assets/logo.png"
                                   Stretch="Uniform" Margin="20"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        
                        <!-- Main Title -->
                        <TextBlock Text="eSureHi+" FontSize="36" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="Smarter Public Service System" FontSize="14" Foreground="#8899AA"
                                   HorizontalAlignment="Center" Margin="0,0,0,40"/>

                        <!-- Secondary Info Placeholders -->
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="MapMarker" Foreground="#FFC107" Width="18" Height="18" Margin="0,0,10,0"/>
                                <TextBlock Text="POBLACION 1, Sulop, Davao Del Sur" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Phone" Foreground="#FFC107" Width="18" Height="18" Margin="0,0,10,0"/>
                                <TextBlock Text="+63 (082) 123-4567 | info@sulop.gov.ph" Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Tagline at Bottom -->
                    <TextBlock Text="Better Service, Better Care" 
                               Foreground="#556677" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"/>
                </Grid>
            </Border>

            <!-- ── Right Panel (Login Form) ── -->
            <Border Grid.Column="1" Background="White">
                <Grid Margin="40">
                    <!-- Top Right Close Button -->
                    <Button Click="BtnClose_Click"
                            Style="{StaticResource MaterialDesignIconButton}" 
                            Width="36" Height="36" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Margin="0,-30,-30,0"
                            Foreground="#0A1830"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24"/>
                    </Button>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Welcome Back" FontSize="28" FontWeight="Bold" Foreground="#0A1830" Margin="0,0,0,5"/>
                        <TextBlock Text="Please sign in to your account" FontSize="14" Foreground="#778899" Margin="0,0,0,40"/>

                        <!-- Username -->
                        <TextBlock Text="Username / Email" FontSize="12" FontWeight="SemiBold" Foreground="#0A1830" Margin="0,0,0,8"/>
                        <TextBox x:Name="UsernameBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Enter your username"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Height="50" Margin="0,0,0,20"
                                 KeyDown="Input_KeyDown"/>

                        <!-- Password -->
                        <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#0A1830" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="PasswordBox"
                                     materialDesign:HintAssist.Hint="Enter your password"
                                     Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                     Height="50" Margin="0,0,0,10"
                                     KeyDown="Input_KeyDown"/>

                        <!-- Error Message -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#E53935"
                                   FontSize="12" Margin="0,0,0,15" TextWrapping="Wrap"
                                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Login Button -->
                        <Button Content="LOG IN" 
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                Background="#14345B" BorderBrush="#14345B"
                                Foreground="White"
                                FontWeight="Bold" FontSize="14" Height="50"
                                materialDesign:ButtonAssist.CornerRadius="6"
                                Margin="0,10,0,30"/>

                        <ProgressBar IsIndeterminate="True" Margin="0,-20,0,20" Height="4" Foreground="#14345B"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <!-- Demo Accounts Box -->
                        <Border BorderBrush="#E0E6ED" BorderThickness="1" CornerRadius="8" Padding="15" Background="#F8FAFC">
                            <StackPanel>
                                <TextBlock Text="DEMO ACCOUNTS" FontSize="11" FontWeight="Bold" Foreground="#778899" Margin="0,0,0,10" HorizontalAlignment="Center"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                        <TextBlock Text="Super Admin" FontSize="10" FontWeight="Bold" Foreground="#0A1830" HorizontalAlignment="Center"/>
                                        <TextBlock Text="superadmin / password" FontSize="10" Foreground="#556677" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <TextBlock Text="User" FontSize="10" FontWeight="Bold" Foreground="#0A1830" HorizontalAlignment="Center"/>
                                        <TextBlock Text="user / password" FontSize="10" Foreground="#556677" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Connection Settings at Bottom -->
                    <Button Command="{Binding OpenSettingsCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,0" Foreground="#778899">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Database" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Connection Settings" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
