<Window x:Class="eSureHi.Views.Shared.SystemNotificationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="System Notification"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ShowInTaskbar="False"
        Background="White"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Border BorderBrush="#CBD5E1"
            BorderThickness="1"
            CornerRadius="6"
            Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#0D2137"
                    Padding="18,14">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BellBadge"
                                             Width="22"
                                             Height="22"
                                             Foreground="White"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding NotificationTitle}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="15"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="1"
                       Text="{Binding NotificationMessage}"
                       Foreground="#0F172A"
                       FontSize="13"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Margin="22,20,22,18"/>

            <Border Grid.Row="2"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,1,0,0"
                    Padding="16,12"
                    Background="#F8FAFC">
                <Button Content="OK"
                        Width="96"
                        Height="34"
                        HorizontalAlignment="Right"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
